#!/usr/bin/env python3
"""team-session-brief — SessionStart hook cho worker trong team (G3.5 Bước 0).

In brief tự chứa cho phiên claude trong worktree: tôi là ai, room nào,
run/task, gate đang mở hay đóng, 5 tin cuối room, và luật Bước 0 nếu gate
OPEN. Nguồn sự thật: bảng đăng ký ~/.claude/chat/.workers.json (pane→name,
do team-orch worker-start ghi) + marker plan-gate theo cwd + bus chat.
Không đăng ký pane → im lặng thoát 0 (terminal thường, không chặn ai).
"""
import base64
import datetime
import json
import os
import sys

sys.dont_write_bytecode = True

CHAT_DIR = os.path.join(os.path.expanduser("~"), ".claude", "chat")
REG_PATH = os.environ.get("TEAM_WORKERS_REG", os.path.join(CHAT_DIR, ".workers.json"))
GATES_DIR = os.environ.get("TEAM_TASK_GATES_DIR", os.path.join(CHAT_DIR, ".task-gates"))


def load_registration(pane):
    """ORCA_AGENT_PANE mang pane key 'tabId:leafId' (alias ORCA_PANE_KEY);
    .workers.json keyed theo handle 'term_*' — đổi qua terminal list."""
    try:
        with open(REG_PATH, encoding="utf-8") as f:
            reg = json.load(f)
    except Exception:
        return None
    try:
        import subprocess
        key = pane
        if key and key not in reg and ':' in key:
            tab, leaf = key.split(':', 1)
            out = subprocess.run(
                [os.environ.get("ORCA_BIN", "orca"), "terminal", "list", "--json"],
                capture_output=True, text=True, timeout=15,
            ).stdout
            for t in json.loads(out).get("result", {}).get("terminals", []):
                if t.get("tabId") == tab and t.get("leafId") == leaf:
                    key = t.get("handle", key)
                    break
        entry = reg.get(key)
        return entry if isinstance(entry, dict) else None
    except Exception:
        return None


def gate_open(cwd):
    marker = os.path.join(
        GATES_DIR,
        base64.urlsafe_b64encode(cwd.encode()).decode().rstrip("=") + ".json",
    )
    try:
        with open(marker, encoding="utf-8") as f:
            return bool(json.load(f).get("planGateOpen"))
    except Exception:
        return False


def chat_tail(room, limit=5):
    path = os.path.join(CHAT_DIR, "team-chat.jsonl")
    out = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                try:
                    m = json.loads(line)
                except Exception:
                    continue
                if room in ("general", "*") or m.get("channel") == room:
                    out.append(m)
    except FileNotFoundError:
        return []
    return out[-limit:]



# Vai trò chuyên biệt: tên đăng ký (worker-start --name) → agent brief có sẵn
# trong kit. Brief nạp NGUYÊN VĂN vào phiên — worker terminal có đầy hợp đồng
# role mà không cần Task-tool subagent.
ROLE_AGENTS = [
    ("impact", "phase0-impact-analyst.md",
     'team-chat impact "<yêu cầu>" --scope .. --arch .. --risk .. --effort .. --deps .. --rec ..'),
    ("design", "designer.md",
     'team-chat design "<flow, màn hình, data model, trade-off>" + mockup HTML kèm link/path'),
    ("review", "code-reviewer.md",
     'team-chat review "<scope>" --checked ".." --findings ".." --verdict ok|cần-sửa'),
    ("verify", "verifier.md",
     'team-chat done "<task>" --did .. --test .. --evidence ..'),
    ("security", "security-audit.md",
     'team-chat review "<scope>" --checked ".." --findings ".." --verdict ok|cần-sửa'),
    ("smith", "be-dev.md",
     'team-chat plan/done theo gate — chi tiết trong hợp đồng be-dev'),
    ("weaver", "fe-dev.md",
     'team-chat plan/done theo gate — chi tiết trong hợp đồng fe-dev'),
    ("mason", "mason.md",
     'team-chat done "<task>" --did "test đã viết" --test "cách chạy" --evidence "output thật"'),
    ("forge", "forge.md",
     'team-chat done "<task>" --did .. --test .. --evidence ..'),
    ("scout", "phase0-impact-analyst.md",
     'team-chat impact "<phát hiện>" --scope .. --arch .. --risk .. --effort .. --deps .. --rec ..'),
    ("warden", "code-reviewer.md",
     'team-chat review "<scope>" --checked ".." --findings ".." --verdict ok|cần-sửa'),
]


def role_agent_brief(name):
    n = (name or "").lower()
    for prefix, fname, cmd in ROLE_AGENTS:
        if not n.startswith(prefix):
            continue
        here = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "agents", fname)
        live = os.path.join(os.path.expanduser("~"), ".claude", "agents", fname)
        for path in (here, live):
            if os.path.isfile(path):
                with open(path, encoding="utf-8") as f:
                    return fname, f.read(), cmd
    return None, None, None


def main():
    pane = os.environ.get("ORCA_AGENT_PANE", "")
    if not pane:
        return 0
    reg = load_registration(pane)
    if not reg:
        return 0
    name = reg.get("name", "worker")
    title = ""
    try:
        roster = json.load(open(os.path.join(CHAT_DIR, "roster.json"), encoding="utf-8"))
        for m in roster.get("members", []):
            if isinstance(m, dict) and m.get("nm", "").lower() == name.lower():
                title = m.get("ti", "")
                break
    except Exception:
        pass
    room = reg.get("room") or "general"
    cwd = reg.get("worktree") or os.getcwd()
    print(f"═ TEAM BRIEF — bạn là {name} (worker)" + (f" — {title}" if title else "") + " ═")
    print(f"Room: #{room} · Repo: {reg.get('repo', '?')} · Run: {reg.get('run', '?')} · Task: {reg.get('task', '?')}")
    print(f"Worktree: {cwd}")
    agent_name, agent_body, agent_cmd = role_agent_brief(name)
    if agent_body:
        print()
        print(f"═ VAI TRÒ CHUYÊN BIỆT: {agent_name} — hợp đồng nguyên văn ═")
        print(agent_body)
        print("═ BÁO CÁO TRONG ROOM (thay cho markdown Task-tool) ═")
        print(f"  ~/.claude/bin/{agent_cmd}")

    print("Hiến pháp §0.0: đúng đắn trên hết · chưa rõ thì hỏi · KHÔNG BỊA · DONE phải 3 phần (đã làm/cách test/bằng chứng).")
    print("Đọc chat: ~/.claude/bin/team-chat read --last 20")
    if gate_open(cwd):
        print()
        print("⛔ PLAN-GATE ĐANG OPEN — Bước 0 (G3.5):")
        print("  1. Điều tra (được tự do: Read/Grep/Glob).")
        print("  2. Post kế hoạch: ~/.claude/bin/team-chat plan \"<các bước + DoD đo được>\"")
        print("     (tên của bạn đã khóa theo pane — không cần --from)")
        print("  3. DỪNG LẠI chờ Captain duyệt — mọi lệnh ghi file đang bị guard chặn.")
        print("  4. Gate đóng → làm việc → báo: team-chat done \"<task>\" --did … --test … --evidence …")
        print("     (thiếu 1 trong 3 flag là bị từ chối — hiến pháp §0.0)")
        print("     Kẹt 15 phút: team-chat blocked \"<lý do>\". KHÔNG commit.")
        print("     Khuôn mọi tin: skills/team-workflow/TEMPLATES.md")
    else:
        print("Gate plan: đã đóng. Hoàn tất: team-chat done \"<task>\" --did … --test … --evidence … ; kẹt: team-chat blocked. KHÔNG commit.")
    tail = chat_tail(room)
    if tail:
        print(f"── {len(tail)} tin cuối #{room} ──")
        for m in tail:
            ts = datetime.datetime.fromtimestamp(m.get("at", 0) / 1000).strftime("%H:%M")
            print(f"{ts} {m.get('from', '?')}: {str(m.get('text', ''))[:110]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
