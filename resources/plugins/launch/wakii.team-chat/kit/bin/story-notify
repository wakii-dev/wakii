#!/bin/bash
# story-notify — thông minh: có context, có screenshot, có đề xuất
# Usage: story-notify <type> <sf> [detail]
# Types: stall | complete | gate-fail | gap | story-complete
#
# Transport chain (2.16.5 — banner phải hiển thị nguồn ĐÚNG app, không "Script Editor"):
#   1. Windows: story-notify-toast.ps1 (toast WinRT qua WinPS 5.1 -File, không
#      bypass/encode — windows-edr-posture) · macOS: terminal-notifier -sender
#      <bundle-id Wakii> — banner nguồn Wakii, click mở app
#   2. osascript display notification — fallback macOS còn lại (banner "Script Editor")
#      (khi app expose `orca notifications show` CLI thì thêm làm tầng 1)
set -u
TYPE="${1:?}"; SF="${2:-}"; DETAIL="${3:-}"

WAKII_APP="${WAKII_APP:-/Applications/Wakii.app}"

notify() { # $1=title $2=body $3=sound
  local title="$1" body="$2" sound="${3:-}"
  # Windows — toast qua ps1 cạnh script; -NoProfile -File script thật, không bypass/encode
  if [ "${OS:-}" = "Windows_NT" ]; then
    local ps1_dir
    ps1_dir="$(cd "$(dirname "$0")" && pwd)"
    local ps1_native="$ps1_dir/story-notify-toast.ps1"
    command -v cygpath >/dev/null 2>&1 && ps1_native="$(cygpath -m "$ps1_dir")/story-notify-toast.ps1"
    if command -v powershell.exe >/dev/null 2>&1 && [ -f "$ps1_dir/story-notify-toast.ps1" ]; then
      powershell.exe -NoProfile -File "$ps1_native" -Title "$title" -Body "$body" >/dev/null 2>&1 && return 0
      return 1  # toast fail → báo notify-fail, không nuốt rc
    fi
    return 0  # không có powershell/ps1 — best-effort, notify không fail hard
  fi
  local sender=""
  if [ -d "$WAKII_APP" ]; then
    sender=$(defaults read "$WAKII_APP/Contents/Info" CFBundleIdentifier 2>/dev/null)
  fi
  if command -v terminal-notifier >/dev/null 2>&1 && [ -n "$sender" ]; then
    local args=(-title "$title" -message "$body" -sender "$sender" -group "wakii-story")
    [ -n "$sound" ] && args+=(-sound "$sound")
    terminal-notifier "${args[@]}" >/dev/null 2>&1 && return 0
  fi
  if [ -n "$sound" ]; then
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)' -e 'end run' -- "$title" "$body" "$sound"
  else
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' -- "$title" "$body"
  fi
}

case "$TYPE" in
  stall)          notify "⚠ Agent Stall" "${SF} stall ${DETAIL} — watchdog sẽ tự resume" "Basso" ;;
  complete)       notify "✓ SF Complete" "${SF} hoàn thành 5/5 — có thể launch tier kế" "Glass" ;;
  gate-fail)      notify "🚨 Gate FAIL" "${SF}: ${DETAIL} — KHÔNG ĐƯỢC nói 'xong'" "Basso" ;;
  gap)            notify "⚠ REQUIREMENT-GAP" "Câu hỏi cần bạn trả lời: ${DETAIL}" "Ping" ;;
  story-complete) notify "🏁 STORY-COMPLETE" "Story hoàn thành! Merge main khi sẵn sàng" "Hero" ;;
  *)              notify "${SF}" "${DETAIL}" "" ;;
esac
