#!/bin/bash
# team-worker-split — thuê worker trong room bằng SPLIT pane của terminal Captain
# (CEO ruling: 1 room = 1 worktree; captain + worker xếp GRID 6 GHẾ trong CÙNG
# khung terminal, CEO chốt 2/11): 1=captain · 2=phải(1) · 3=phải(2)
#   4=dưới(1) · 5=dưới(2) · 6=dưới(3) — worker điền ghế theo thứ tự 2→6.
# Terminal mới = pane con, không phải tab riêng.
# Usage: team-worker-split --room <room> --name <tên-worker> [--title <t>]
set -u
ORCA="${ORCA_BIN:-/opt/homebrew/bin/orca}"
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOM="" NAME="" TITLE=""
while [ $# -gt 0 ]; do case "$1" in
  --room) ROOM="$2"; shift 2 ;;
  --name) NAME="$2"; shift 2 ;;
  --title) TITLE="$2"; shift 2 ;;
  *) shift ;;
esac; done
[ -n "$ROOM" ] && [ -n "$NAME" ] || { echo "usage: team-worker-split --room <room> --name <tên>" >&2; exit 2; }

REG="$HOME/.claude/chat/.workers.json"
ROOMS="$HOME/.claude/chat/rooms.json"
WT=$(python3 - "$ROOMS" "$REG" "$ROOM" <<'PY'
import json, sys
wt = ""
try: wt = (json.load(open(sys.argv[1], encoding="utf-8")).get(sys.argv[2]) or {}).get("worktree", "")
except Exception: pass
if not wt:
    try:
        reg = json.load(open(sys.argv[2], encoding="utf-8"))
        wt = next((e.get("worktree", "") for e in reg.values()
                   if isinstance(e, dict) and e.get("room") == sys.argv[3] and e.get("worktree")), "")
    except Exception: pass
print(wt)
PY
)
[ -n "$WT" ] || WT="$(pwd)"  # chót: cwd — room nên có worktree trong metadata

# Sức chứa = concurrency CEO chỉnh trong panel (roster.json), mặc định 3
# Ghế kế + pane cha đúng cột (canonical grid; worker hiện có đếm pane còn live)
SEAT=$(python3 - "$REG" "$ROOM" "$ORCA" "$HOME/.claude/chat/roster.json" <<'PY'
import json, sys, subprocess
reg_path, room, orca, roster = sys.argv[1:5]
try: reg = json.load(open(reg_path, encoding="utf-8"))
except Exception: reg = {}
try: cap = int(json.load(open(roster, encoding="utf-8")).get("concurrency", 3))
except Exception: cap = 3
live = None
try:
    out = subprocess.run([orca, "terminal", "list", "--json"], capture_output=True, text=True, timeout=15).stdout
    live = {t.get("handle") for t in json.loads(out).get("result", {}).get("terminals", [])}
except Exception: pass
workers = [(p, e) for p, e in reg.items()
           if isinstance(e, dict) and e.get("room") == room and e.get("name") != "captain"]
if live is not None:
    workers = [(p, e) for p, e in workers if p in live]
workers.sort(key=lambda pe: pe[1].get("at", 0))  # thứ tự vào = thứ tự ghế
cnt = len(workers)
if cnt >= cap:
    print("FULL %d %d" % (cnt, cap)); sys.exit(0)
capt = next((p for p, e in reg.items()
             if isinstance(e, dict) and e.get("name") == "captain" and e.get("room") == room), "")
if not capt:
    print("NOCAPTAIN"); sys.exit(0)
seat = cnt + 2  # worker 1..5 → ghế 2..6
# ghế2=phải(ghế1) ghế3=phải(ghế2) ghế4=dưới(ghế1) ghế5=dưới(ghế2) ghế6=dưới(ghế3)
PARENT_SEAT, DIR = {2: (1, "vertical"), 3: (2, "vertical"), 4: (1, "horizontal"),
                    5: (2, "horizontal"), 6: (3, "horizontal")}.get(seat, (1, "vertical"))
if PARENT_SEAT == 1:
    parent = capt
else:
    parent = workers[PARENT_SEAT - 2][0] if cnt >= PARENT_SEAT - 1 else ""
if not parent or (live is not None and parent not in live):
    parent, DIR = capt, "vertical"  # pane cha chết → về captain, tự vá ở ghế kế
print(parent, DIR, seat, cnt, cap)
PY
)
case "$SEAT" in
  FULL*) set -- $SEAT; echo "TỪ CHỐI: room #$ROOM đã đủ $2 worker (concurrency $3). Hoàn thành/dọn worker trước." >&2; exit 4 ;;
  NOCAPTAIN) echo "room #$ROOM chưa có captain — chạy team-captain-spawn --room $ROOM trước." >&2; exit 3 ;;
esac
BASE=$(printf '%s' "$SEAT" | cut -d' ' -f1)
DIR=$(printf '%s' "$SEAT" | cut -d' ' -f2)
SEATNO=$(printf '%s' "$SEAT" | cut -d' ' -f3)
CNT=$(printf '%s' "$SEAT" | cut -d' ' -f4)

echo "team-worker-split: ghế $SEATNO/6 — split $DIR từ $BASE…"
OUT=$("$ORCA" terminal split --terminal "$BASE" --direction "$DIR" \
  --command "claude --dangerously-skip-permissions" --json 2>&1) || { echo "$OUT" >&2; exit 1; }
PANE=$(printf '%s' "$OUT" | python3 -c '
import json, sys
def dig(o):
    if isinstance(o, dict):
        v = o.get("handle")
        if isinstance(v, str) and v.startswith("term_"): return v
        for x in o.values():
            r = dig(x)
            if r: return r
print(dig(json.loads(sys.stdin.read())) or "")
')
[ -n "$PANE" ] || { echo "không bóc được pane từ split — output:" >&2; echo "$OUT" >&2; exit 1; }
[ -n "$TITLE" ] && "$ORCA" terminal rename --terminal "$PANE" --title "$TITLE" >/dev/null 2>&1 || true

"$HERE/team-orch" register --pane "$PANE" --name "$NAME" --worktree "$WT" --repo team --room "$ROOM"
# Đợi agent TUI sẵn sàng TRƯỚC khi gõ prompt (CEO bug 1/11: prompt rơi vào
# shell trống khi claude boot chậm). Sẵn sàng = output pane có dấu hiệu TUI.
wait_agent_ready() { # $1=pane $2=orca_bin → 0 khi sẵn sàng, 1 sau ~60s
  local i out
  for i in $(seq 1 20); do
    out=$("$2" terminal read --terminal "$1" 2>/dev/null | tail -14)
    if printf '%s' "$out" | grep -qE 'Claude Code|✻|╭|⏺|Esc to interrupt|no auto-accept'; then
      return 0
    fi
    sleep 3
  done
  return 1
}

if ! wait_agent_ready "$PANE" "$ORCA"; then echo "⚠ agent chưa lên 60s — brief có thể trượt" >&2; fi
"$ORCA" terminal send --terminal "$PANE" --text "Bạn là $NAME — worker trong room #${ROOM} (Wakii team). Worktree: $WT. HỢP ĐỒNG: ~/.claude/agents/captain.md mục Team Contract + Templates: ~/.claude/skills/team-workflow/TEMPLATES.md. Nói chuyện qua chat: ~/.claude/bin/team-chat send \"...\" (KHÔNG --from — tên theo pane). Có plan-gate: post [PLAN] trước khi ghi file: team-chat plan \"...\". DONE: team-chat done --did --test --evidence. KHÔNG commit. Xác nhận 1 tin rồi nhận lệnh." --enter --json > /dev/null 2>&1 \
  && echo "→ brief đã gửi"
echo "team-worker-split XONG: $NAME = $PANE (pane split, room #$ROOM, ghế $SEATNO/6)"
