#!/bin/bash
# team-orch — wrapper orchestration CLI (§2.5) + plan-gate G3.5 (§2.2) gắn WORKTREE PATH (§0.3).
# Chạy lệnh orca orchestration thật; sau lệnh biết-shape → phát event (id=entity → dedup với sync).
# Marker plan-gate: $TEAM_TASK_GATES_DIR/<base64url(worktreePath)>.json {taskId, planGateOpen}
# Sync (T0): thuần CLI run-list/task-list/worker-list — không RPC.
set -u
ORCA="${ORCA_BIN:-/opt/homebrew/bin/orca}"
GATES_DIR="${TEAM_TASK_GATES_DIR:-$HOME/.claude/chat/.task-gates}"
EVENTS="${TEAM_EVENTS_LOG:-$HOME/.claude/chat/team-events.jsonl}"
CMD="${1:-}"; [ $# -gt 0 ] && shift

b64() { printf '%s' "$1" | base64 | tr '+/' '-_' | tr -d '='; }
marker() { echo "$GATES_DIR/$(b64 "$1").json"; }
emit() { # kind actor repo run task data
  TC="$HOME/.claude/bin/team-chat"; [ -x "$TC" ] || TC="$(dirname "$0")/team-chat"
  "$TC" event "$1" --repo "${3:-unknown}" ${4:+--run-id "$4"} ${5:+--task-id "$5"} \
    --actor "$2" --data "${6:-{\}}" 2>/dev/null | grep -o '→ .*' || true
}
repo_of_cwd() { # repoId từ worktree hiện tại qua app — đơn giản hoá: env hoặc 'unknown'
  echo "${TEAM_REPO_ID:-unknown}"
}

# ── Registration pane→worker (P0-2): nguồn sự thật cho danh tính + brief ──
REG="${TEAM_WORKERS_REG:-$HOME/.claude/chat/.workers.json}"
reg_put() { # pane name worktree task run repo room
  python3 - "$REG" "$@" <<'PY'
import json, sys, os, time
path, pane, name, wt, task, run, repo, room = sys.argv[1:9]
try: reg = json.load(open(path, encoding="utf-8"))
except Exception: reg = {}
reg[pane] = {"name": name, "worktree": wt, "task": task, "run": run,
             "repo": repo, "room": room, "at": int(time.time() * 1000)}
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(reg, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY
}
reg_get() { # pane → in JSON entry hoặc rỗng
  python3 - "$REG" "$1" <<'PY'
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
e = reg.get(sys.argv[2])
if e: print(json.dumps(e))
PY
}
rooms_reg() { # rooms_reg open <room> <feature> <repo> <run> | close <room> | list
  python3 - "$HOME/.claude/chat/rooms.json" "$@" <<'PY'
import json, sys, os, time
path, cmd = sys.argv[1], sys.argv[2]
try: reg = json.load(open(path, encoding="utf-8"))
except Exception: reg = {}
if cmd == "open":
    room, feature, repo, run = sys.argv[3:7]
    reg[room] = {"feature": feature, "repo": repo, "run": run,
                 "status": "open", "createdAt": int(time.time() * 1000)}
elif cmd == "close":
    room = sys.argv[3]
    if room in reg: reg[room]["status"] = "closed"
elif cmd == "list":
    print(json.dumps(reg)); sys.exit(0)
os.makedirs(os.path.dirname(path), exist_ok=True)
json.dump(reg, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY
}
pane_of_worker_json() { # <json receipt> → in terminal handle hoặc rỗng (argv, không pipe — heredoc chiếm stdin)
  python3 -c '
import json, sys
def dig(o):
    if isinstance(o, dict):
        for k in ("terminal", "terminalHandle", "terminal_handle", "pane", "handle"):
            v = o.get(k)
            if isinstance(v, str) and v.startswith("term_"): return v
        for v in o.values():
            r = dig(v)
            if r: return r
    elif isinstance(o, list):
        for v in o:
            r = dig(v)
            if r: return r
    return None
try: d = json.loads(sys.argv[1])
except Exception: sys.exit(0)
h = dig(d)
if h: print(h)
' "$1"
}
# Cài hooks team (guard G3.5 + SessionStart brief) vào .claude/settings.json của worktree.
install_worker_hooks() { # worktreePath
  WT_DIR="$1/.claude"; mkdir -p "$WT_DIR"
  BINDIR="$(cd "$(dirname "$0")" && pwd)"
  GUARD_BIN="$BINDIR/story-guard-plan-gate"; BRIEF_BIN="$BINDIR/team-session-brief"
  [ -x "$GUARD_BIN" ] || GUARD_BIN="$HOME/.claude/bin/story-guard-plan-gate"
  [ -x "$BRIEF_BIN" ] || BRIEF_BIN="$HOME/.claude/bin/team-session-brief"
  python3 - "$WT_DIR/settings.json" "$GUARD_BIN" "$BRIEF_BIN" <<'PY'
import json, sys, os
spath, guard, brief = sys.argv[1:4]
try: s = json.load(open(spath, encoding="utf-8"))
except Exception: s = {}
hooks = s.setdefault("hooks", {})
def up(name, matcher, cmd):
    arr = hooks.setdefault(name, [])
    if not any(h.get("hooks", [{}])[0].get("command", "").endswith(cmd.rsplit("/", 1)[-1]) for h in arr):
        entry = {"hooks": [{"type": "command", "command": cmd}]}
        if matcher: entry["matcher"] = matcher
        arr.append(entry)
up("PreToolUse", "Edit|Write|NotebookEdit|Bash", guard)
up("SessionStart", "", brief)
json.dump(s, open(spath, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
PY
}

case "$CMD" in
  feature-open)
    # feature-open --name <slug> --repo <id> [--objective "..."] → worktree + phòng + .wakii skeleton
    NAME="" REPO="" OBJ=""
    while [ $# -gt 0 ]; do case "$1" in
      --name) NAME="$2"; shift 2 ;; --repo) REPO="$2"; shift 2 ;;
      --objective) OBJ="$2"; shift 2 ;; *) shift ;;
    esac; done
    [ -n "$NAME" ] && [ -n "$REPO" ] || { echo "feature-open cần --name + --repo" >&2; exit 2; }
    # Room + chat trước, orchestration sau — run fail (app ngủ, repo chưa mount…)
    # KHÔNG chặn việc chat/điều phối trong room (linh hoạt không block).
    ROOM_ID="$REPO-$NAME"
    rooms_reg open "$ROOM_ID" "$NAME" "$REPO" ""
    RUN=$("$ORCA" orchestration run-create --objective "${OBJ:-$NAME}" --json 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['result']['run']['id'])" 2>/dev/null)
    if [ -n "$RUN" ]; then
      rooms_reg open "$ROOM_ID" "$NAME" "$REPO" "$RUN"
    else
      echo "⚠ orchestration run-create fail — room vẫn mở, chat hoạt động; thử lại sau (team-orch sync)." >&2
    fi
    TC="$(dirname "$0")/team-chat"
    "$TC" send "🏁 Feature #$ROOM_ID mở${RUN:+ — run $RUN}" --from captain --role captain --channel "$ROOM_ID" >/dev/null 2>&1
    [ -n "$RUN" ] && emit run.created captain "$REPO" "$RUN" "" "{\"feature\":\"$NAME\"}"
    echo "RUN=${RUN:-none}  ROOM=#$ROOM_ID (khung chat riêng — panel tự hiện tab)"
    echo "Tiếp: orca worktree create --name $NAME (Captain) → worker-start trong worktree đó"
    ;;
  worker-start)
    # Flags của orchestration phải qua nguyên vẹn; mình chỉ bóc thêm giá trị cho marker/events.
    PLAN=0 WT="" NAME="worker" TASK="" REPO="" RUN="" ROOM_FLAG=""; PASS=()
    while [ $# -gt 0 ]; do case "$1" in
      --require-plan-approval) PLAN=1; shift ;;
      --room) ROOM_FLAG="$2"; shift 2 ;;  # local: room của worker — không qua orchestration
      --name) NAME="$2"; PASS+=("$1" "$2"); shift 2 ;;
      --worktree) WT="$2"; PASS+=("$1" "$2"); shift 2 ;;
      --task) TASK="$2"; PASS+=("$1" "$2"); shift 2 ;;
      --repo) REPO="$2"; PASS+=("$1" "$2"); shift 2 ;;
      --run) RUN="$2"; PASS+=("$1" "$2"); shift 2 ;;
      *) PASS+=("$1"); shift ;;
    esac; done
    # CEO ruling: 1 room tối đa 3 worker (terminal grid 3). Đếm worker cùng
    # room (theo pane đăng ký + terminal còn sống) — vượt thì từ chối thẳng.
    if [ -n "${ORCA_AGENT_PANE:-}" ]; then
      MY_ROOM=$(python3 - "$REG" "$ORCA_AGENT_PANE" <<'PY' 2>/dev/null
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
e = reg.get(sys.argv[2]) or {}
print(e.get("room", "") if isinstance(e, dict) else "")
PY
)
      ROOM_="${ROOM_FLAG:-${MY_ROOM:-}}"
      if [ -n "$ROOM_" ] && [ "$ROOM_" != "general" ]; then
        CNT=$(python3 - "$REG" "$MY_ROOM" "$ORCA" <<'PY' 2>/dev/null
import json, sys, subprocess
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: print(0); sys.exit(0)
room = sys.argv[2]
panes = [p for p, e in reg.items() if isinstance(e, dict) and e.get("room") == room and e.get("name") != "captain"]
try:
    out = subprocess.run([sys.argv[3], "terminal", "list", "--json"], capture_output=True, text=True, timeout=15).stdout
    live = {t.get("handle") for t in json.loads(out).get("result", {}).get("terminals", [])}
    print(sum(1 for p in panes if p in live))
except Exception: print(len(panes))
PY
)
        if [ "${CNT:-0}" -ge 3 ]; then
          echo "TỪ CHỐI: room #$ROOM_ đã đủ 3 worker (grid 3 — max CEO ruling). Hoàn thành/xoá worker hiện có trước khi thuê thêm." >&2
          exit 4
        fi
      fi
    fi
    HAS_JSON=0; for a in ${PASS[@]+"${PASS[@]}"}; do [ "$a" = "--json" ] && HAS_JSON=1; done
    # Snapshot worktrees TRƯỚC spawn — fallback vững khi receipt không lộ path
    # (selector 'new-top-level': dig() miss → marker/hooks ghi nhầm chỗ, worker
    # chạy trần trụi — sự cố thật 1/11 docs-writer).
    TERM_BEFORE=$("$ORCA" terminal list --json 2>/dev/null | python3 -c "
import json,sys
try: print('\n'.join(t.get('handle','') for t in json.load(sys.stdin)['result']['terminals']))
except Exception: pass
" 2>/dev/null)
    WT_BEFORE=$("$ORCA" worktree list --json 2>/dev/null | python3 -c "
import json,sys
try: print('\n'.join(w.get('path','') for w in json.load(sys.stdin)['result']['worktrees']))
except Exception: pass
" 2>/dev/null)
    # GRID-3 (CEO ruling): room có captain pane sống → worker là pane SPLIT
    # trong tab captain, rồi trao pane cho orchestration qua --terminal —
    # supervision (worker-read/stop/release) giữ nguyên. Split fail → fallback
    # tab riêng như cũ, không block việc thuê worker.
    SPLIT_PANE=""
    HAS_TERM_FLAG=0; for a in ${PASS[@]+"${PASS[@]}"}; do [ "$a" = "--terminal" ] && HAS_TERM_FLAG=1; done
    if [ "$HAS_TERM_FLAG" -eq 0 ] && [ -n "${ROOM_:-}" ] && [ "$ROOM_" != "general" ]; then
      CAP_PANE=$(python3 - "$REG" "$ROOM_" "$ORCA" <<'PY' 2>/dev/null
import json, sys, subprocess
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
room = sys.argv[2]
cands = [p for p, e in reg.items()
         if isinstance(e, dict) and e.get("name") == "captain" and e.get("room") == room]
if not cands: sys.exit(0)
try:
    out = subprocess.run([sys.argv[3], "terminal", "list", "--json"],
                         capture_output=True, text=True, timeout=15).stdout
    live = {t.get("handle") for t in json.loads(out).get("result", {}).get("terminals", [])}
    for p in cands:
        if p in live: print(p); break
except Exception:
    print(cands[-1])
PY
)
      if [ -n "$CAP_PANE" ]; then
        # CEO ruling: worker dùng CHUNG worktree room — bỏ selector tạo worktree
        # mới (new-top-level…), thay bằng worktree room (từ registration captain).
        ROOM_WT=$(python3 - "$REG" "$CAP_PANE" <<'PY' 2>/dev/null
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
e = reg.get(sys.argv[2]) or {}
wt = e.get("worktree", "") if isinstance(e, dict) else ""
print(wt[5:] if wt.startswith("path:") else wt)
PY
)
        if [ -n "$ROOM_WT" ]; then
          NEWPASS=(); skipwt=0
          for a in ${PASS[@]+"${PASS[@]}"}; do
            if [ "$skipwt" -eq 1 ]; then skipwt=0; continue; fi
            if [ "$a" = "--worktree" ]; then skipwt=1; continue; fi
            NEWPASS+=("$a")
          done
          NEWPASS+=(--worktree "path:$ROOM_WT")
          PASS=(${NEWPASS[@]+"${NEWPASS[@]}"})
          WT="$ROOM_WT"
          echo "team-orch: worker dùng CHUNG worktree room — $ROOM_WT"
        fi
        NEW_PANE=$("$ORCA" terminal split --terminal "$CAP_PANE" --direction vertical \
                     --command "claude --dangerously-skip-permissions" --json 2>/dev/null \
                   | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["split"]["handle"])' 2>/dev/null)
        if [ -n "$NEW_PANE" ]; then
          sleep 8  # claude phải boot xong trước khi orchestration gõ task vào pane
          SPLIT_PANE="$NEW_PANE"
          echo "team-orch: grid-3 — worker là pane split trong tab captain ($NEW_PANE)"
        else
          echo "team-orch: ⚠ split từ captain fail — worker mở tab riêng như cũ" >&2
        fi
      fi
    fi
    if [ -n "$SPLIT_PANE" ]; then
      # --terminal là chế độ reuse: creation/setup options (--name, --base-branch,
      # --setup) bị orchestration từ chối (invalid_argument) — lọc khỏi argv.
      FILTERED=()
      skip=0
      for a in ${PASS[@]+"${PASS[@]}"}; do
        if [ "$skip" -eq 1 ]; then skip=0; continue; fi
        case "$a" in
          --name|--base-branch|--setup) skip=1; continue ;;
        esac
        FILTERED+=("$a")
      done
      ARGS=(${FILTERED[@]+"${FILTERED[@]}"})
      [ "$HAS_JSON" -eq 1 ] || ARGS+=(--json)
      ARGS+=(--terminal "$SPLIT_PANE")
    else
      ARGS=(${PASS[@]+"${PASS[@]}"})
      [ "$HAS_JSON" -eq 1 ] || ARGS+=(--json)
    fi
    OUT=$("$ORCA" orchestration "$CMD" "${ARGS[@]}" 2>&1) || {
      if [ -n "$SPLIT_PANE" ]; then
        echo "team-orch: ⚠ orchestration từ chối pane split — đóng pane, fallback tab riêng" >&2
        "$ORCA" terminal close --terminal "$SPLIT_PANE" >/dev/null 2>&1
        ARGS=(${PASS[@]+"${PASS[@]}"})
        [ "$HAS_JSON" -eq 1 ] || ARGS+=(--json)
        OUT=$("$ORCA" orchestration "$CMD" "${ARGS[@]}" 2>&1) || { echo "$OUT"; exit 1; }
      else
        echo "$OUT"; exit 1
      fi
    }
    echo "$OUT"
    WT_PATH="${WT#explicit:}"; [ -n "$WT_PATH" ] || WT_PATH="$(pwd)"
    # Bóc worktree path thật: (1) từ receipt, (2) snapshot-diff worktree list
    WT_REAL=$(echo "$OUT" | python3 -c "
import json,sys
def dig(o):
    if isinstance(o,dict):
        for k in ('workspace','worktreePath','worktree_path','path','checkout'):
            v=o.get(k)
            if isinstance(v,str) and v.startswith('/'): return v
        for v in o.values():
            r=dig(v)
            if r: return r
    elif isinstance(o,list):
        for v in o:
            r=dig(v)
            if r: return r
try: print(dig(json.load(sys.stdin)) or '')
except Exception: pass
" 2>/dev/null)
    [ -n "$WT_REAL" ] || WT_REAL=$(diff <(printf '%s\n' "$WT_BEFORE") <("$ORCA" worktree list --json 2>/dev/null | python3 -c "
import json,sys
try: print('\n'.join(w.get('path','') for w in json.load(sys.stdin)['result']['worktrees']))
except Exception: pass
" 2>/dev/null) 2>/dev/null | grep '^> ' | head -1 | cut -c3-)
    [ -n "$WT_REAL" ] && WT_PATH="$WT_REAL"
    install_worker_hooks "$WT_PATH"
    PANE=$(pane_of_worker_json "$OUT" 2>/dev/null)
    [ -n "$PANE" ] || PANE=$(diff <(printf '%s\n' "$TERM_BEFORE") <("$ORCA" terminal list --json 2>/dev/null | python3 -c "
import json,sys
try: print('\n'.join(t.get('handle','') for t in json.load(sys.stdin)['result']['terminals']))
except Exception: pass
" 2>/dev/null) 2>/dev/null | grep '^> ' | head -1 | cut -c3-)
    [ -n "$PANE" ] || PANE="${TEAM_WORKER_PANE:-}"
    if [ -n "$PANE" ]; then
      reg_put "$PANE" "${NAME%%-*}" "$WT_PATH" "$TASK" "$RUN" "$REPO" "${ROOM_:-${REPO}-${NAME%%-*}}"
      echo "team-orch: đăng ký $PANE → ${NAME%%-*} (danh tính khóa theo pane)"
    else
      echo "team-orch: ⚠ chưa bóc được pane từ receipt — đăng ký tay: team-orch register --pane <handle> --name ${NAME%%-*} --worktree $WT_PATH"
    fi
    if [ "$PLAN" -eq 1 ]; then
      mkdir -p "$GATES_DIR"
      printf '{"taskId":"%s","planGateOpen":true,"worktreePath":"%s"}\n' "$TASK" "$WT_PATH" > "$(marker "$WT_PATH")"
      emit plan.gate.open captain "$REPO" "$RUN" "$TASK" "{\"worktree\":\"$WT_PATH\"}"
    fi
    emit worker.hired "${NAME%%-*}" "$REPO" "$RUN" "$TASK" '{"via":"team-orch"}'
    echo "$OUT"
    [ "$PLAN" -eq 1 ] && echo "team-orch: plan-gate OPEN @ $WT_PATH (worker phải post [PLAN] chờ duyệt)"
    ;;
  gate-resolve)
    WT=""; PLAN=0; PASS=()
    while [ $# -gt 0 ]; do case "$1" in
      --plan) PLAN=1; shift ;; --worktree) WT="$2"; shift 2 ;; *) PASS+=("$1"); shift ;;
    esac; done
    # P0-2: worker không tự duyệt plan của chính mình — pane đã đăng ký vào đúng
    # worktree này thì từ chối (Captain/CEO chạy từ terminal không đăng ký thì qua).
    MY_PANE="${ORCA_AGENT_PANE:-}"
    if [ -n "$MY_PANE" ] && [ -n "$WT" ]; then
      MY_REG=$(reg_get "$MY_PANE")
      if [ -n "$MY_REG" ]; then
        REG_WT=$(echo "$MY_REG" | python3 -c "import json,sys;print(json.load(sys.stdin).get('worktree',''))" 2>/dev/null)
        REG_NAME=$(echo "$MY_REG" | python3 -c "import json,sys;print(json.load(sys.stdin).get('name',''))" 2>/dev/null)
        if [ "$REG_WT" = "$WT" ]; then
          echo "TỪ CHỐI: pane này đăng ký là worker '$REG_NAME' của worktree $WT — worker không tự duyệt plan của mình (§2.2). Captain duyệt từ terminal của Captain." >&2
          exit 3
        fi
      fi
    fi
    # --id tùy chọn: orchestration gate là ceremony bổ sung; khi worker đang
    # держ dispatch active, orchestration từ chối mở gate (task_not_startable)
    # — plan-gate của TEAM vẫn phải duyệt được (marker + event là nguồn sự thật).
    HAS_ID=0
    for a in ${PASS[@]+"${PASS[@]}"}; do [ "$a" = "--id" ] && HAS_ID=1; done
    if [ "$HAS_ID" -eq 1 ]; then
      OUT=$("$ORCA" orchestration "$CMD" ${PASS[@]+"${PASS[@]}"} 2>&1) || echo "team-orch: orchestration gate skipped — $OUT" >&2
    else
      OUT="(không có --id — chỉ đóng plan-gate team)"
    fi
    if [ "$PLAN" -eq 1 ] && [ -n "$WT" ]; then
      MP="$(marker "$WT")"
      [ -f "$MP" ] && printf '{"taskId":null,"planGateOpen":false,"worktreePath":"%s"}\n' "$WT" > "$MP"
      emit plan.approved captain "$(repo_of_cwd)" "" "" "{\"worktree\":\"$WT\"}"
      echo "team-orch: plan-gate CLOSED @ $WT — worker được làm"
    fi
    echo "$OUT"
    ;;
  cleanup)
    # cleanup --worktree <path> [--harvest <subdir> --dest <abs>] — worker rời + không ai hoạt động:
    # thu hoạch sản phẩm (nếu có) → đóng terminal → XOÁ WORKTREE → dọn marker/registration → event.
    # Luật cleanup-on-merge (§9): worktree không keeping ai sau khi verify PASS.
    WT="" HARVEST="" DEST=""
    while [ $# -gt 0 ]; do case "$1" in
      --worktree) WT="$2"; shift 2 ;;
      --harvest) HARVEST="$2"; shift 2 ;;
      --dest) DEST="$2"; shift 2 ;;
      *) shift ;;
    esac; done
    [ -n "$WT" ] || { echo "cleanup cần --worktree <path> [--harvest <subdir> --dest <abs>]" >&2; exit 2; }
    [ -d "$WT" ] || { echo "worktree không tồn tại: $WT" >&2; exit 1; }
    # 1) thu hoạch sản phẩm vào đích trước khi xoá (mất là mất thật)
    if [ -n "$HARVEST" ] && [ -n "$DEST" ] && [ -d "$WT/$HARVEST" ]; then
      mkdir -p "$DEST"
      cp -R "$WT/$HARVEST/." "$DEST/" && echo "team-orch: harvest $WT/$HARVEST → $DEST"
    fi
    # Bóc room TRƯỚC khi unregister (registration là nguồn room).
    CROOM=$(python3 - "$REG" "$WT" <<'PY'
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
print(next((e.get("room") for e in reg.values()
            if isinstance(e, dict) and e.get("worktree") == sys.argv[2]), ""))
PY
)
    # 2) đóng terminal worker đứng ở worktree này (pane từ registration)
    CPANE=$(python3 - "$REG" "$WT" <<'PY'
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
for pane, e in reg.items():
    if isinstance(e, dict) and e.get("worktree") == sys.argv[2]:
        print(pane); break
PY
)
    if [ -n "$CPANE" ]; then
      "$ORCA" terminal close --terminal "$CPANE" --json > /dev/null 2>&1 || true
      python3 - "$REG" "$CPANE" <<'PY'
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: reg = {}
reg.pop(sys.argv[2], None)
json.dump(reg, open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY
      echo "team-orch: đóng terminal + unregister $CPANE"
    fi
    # 3) xoá worktree + marker
    "$ORCA" worktree remove --worktree "path:$WT" --force --json > /dev/null 2>&1 \
      && echo "team-orch: ĐÃ XOÁ worktree $WT" \
      || { echo "worktree remove fail (xem selector path:)" >&2; "$ORCA" worktree remove --worktree "$WT" --force --json > /dev/null 2>&1 && echo "team-orch: ĐÃ XOÁ worktree $WT" || exit 1; }
    rm -f "$(marker "$WT")"
    [ -n "$CROOM" ] && [ "$CROOM" != "general" ] && rooms_reg close "$CROOM" || true
    emit worktree.cleaned system "$(repo_of_cwd)" "" "" "{\"worktree\":\"$WT\"}"
    echo "team-orch: cleanup xong — marker dọn, event worktree.cleaned phát"
    ;;
  room-close)
    # room-close <room> — đóng khung (tab mờ 🔒, giữ lịch sử tin)
    ROOM="${1:-}"; [ -n "$ROOM" ] && [ "$ROOM" != "general" ] || { echo "room-close cần <room> (không phải general)" >&2; exit 2; }
    rooms_reg close "$ROOM" && echo "→ 🔒 room #$ROOM đã đóng (tab mờ, lịch sử còn)"
    ;;
  room-delete)
    # room-delete <room> — XOÁ khung: registry + toàn bộ tin của room khỏi bus (không hoàn tác)
    # general cũng xoá được theo CEO ruling 1/11 (mặc định gửi về room đầu tiên còn lại)
    ROOM="${1:-}"; [ -n "$ROOM" ] || { echo "room-delete cần <room>" >&2; exit 2; }
    ROOMS="$HOME/.claude/chat/rooms.json"; LOG="${TEAM_CHAT_LOG:-$HOME/.claude/chat/team-chat.jsonl}"
    python3 - "$ROOMS" "$LOG" "$ROOM" <<'PY'
import json, sys, os
rooms_p, log_p, room = sys.argv[1:4]
try: reg = json.load(open(rooms_p, encoding="utf-8"))
except Exception: reg = {}
gone = room in reg
if gone:
    reg[room] = dict(reg[room] or {})
    reg[room]["status"] = "deleted"  # nhớ đã xoá: publish lọc bỏ, không hồi sinh
json.dump(reg, open(rooms_p, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
kept, dropped = [], 0
try:
    for l in open(log_p, encoding="utf-8"):
        try: m = json.loads(l)
        except Exception: kept.append(l); continue
        if (m.get("channel") or "general") == room: dropped += 1
        else: kept.append(l)
except FileNotFoundError: pass
tmp = log_p + ".tmp"
open(tmp, "w", encoding="utf-8").writelines(kept)
os.replace(tmp, log_p)
print(f"→ 🗑 room #{room}: {'đã xoá (nhớ deleted — không tự hồi sinh)' if gone else 'không có trong registry (đã đánh dấu deleted nếu tồn tại)'}; {dropped} tin đã xoá khỏi bus")
PY
    ;;
  register)
    # register --pane <handle> --name <n> --worktree <path> [--task --run --repo --room]
    PANE="" NAME="" WTV="" TASK="" RUN="" REPO="" ROOM="general"
    while [ $# -gt 0 ]; do case "$1" in
      --pane) PANE="$2"; shift 2 ;; --name) NAME="$2"; shift 2 ;; --worktree) WTV="$2"; shift 2 ;;
      --task) TASK="$2"; shift 2 ;; --run) RUN="$2"; shift 2 ;; --repo) REPO="$2"; shift 2 ;;
      --room) ROOM="$2"; shift 2 ;; *) shift ;;
    esac; done
    [ -n "$PANE" ] && [ -n "$NAME" ] && [ -n "$WTV" ] || { echo "register cần --pane + --name + --worktree" >&2; exit 2; }
    reg_put "$PANE" "$NAME" "$WTV" "$TASK" "$RUN" "$REPO" "$ROOM"
    echo "→ đăng ký $PANE = $NAME @ $WTV"
    ;;
  unregister)
    while [ $# -gt 0 ]; do case "$1" in --pane) PANE="$2"; shift 2 ;; *) shift ;; esac; done
    [ -n "${PANE:-}" ] || { echo "unregister cần --pane" >&2; exit 2; }
    python3 - "$REG" "$PANE" <<'PY'
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: reg = {}
reg.pop(sys.argv[2], None)
json.dump(reg, open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY
    echo "→ xoá đăng ký $PANE"
    ;;
  worker-stop|worker-abandon)
    ACTOR="system"; REPO="$(repo_of_cwd)"
    OUT=$("$ORCA" orchestration "$CMD" "$@" 2>&1) || { echo "$OUT"; exit 1; }
    emit worker.lost system "$REPO" "" "" "{\"cmd\":\"$CMD\"}"
    [ "$CMD" = "worker-abandon" ] && emit task.abandoned system "$REPO" "" "" '{}'
    echo "$OUT"
    ;;
  task-update)
    OUT=$("$ORCA" orchestration "$CMD" "$@" 2>&1) || { echo "$OUT"; exit 1; }
    if echo "$OUT" | grep -qi 'completed'; then
      TID=$(echo "$OUT" | grep -o 'task_[a-zA-Z0-9]*' | head -1)
      emit task.completed system "$(repo_of_cwd)" "" "$TID" '{}'
    fi
    echo "$OUT"
    ;;
  sync)
    # §2.5 reconciliation — thuần CLI (T0 findings). Đối chiếu DB thật vs events, phát thiếu.
    python3 - "$ORCA" "$EVENTS" "$(dirname "$0")/team-chat" <<'PY'
import json, subprocess, sys, os
orca, ev_path, tc = sys.argv[1:4]
def jrun(args):
    r = subprocess.run([orca, "orchestration"] + args, capture_output=True, text=True, timeout=30)
    try: return json.loads(r.stdout).get("result", {})
    except Exception: return {}
def emit(kind, repo, run, task, actor="system", data="{}"):
    subprocess.run([tc, "event", kind, "--repo", repo] + (["--run-id", run] if run else [])
                   + (["--task-id", task] if task else []) + ["--actor", actor, "--data", data],
                   capture_output=True, text=True)
seen = set()
try:
    for l in open(ev_path, encoding="utf-8"):
        try:
            e = json.loads(l)
            seen.add((e.get("kind"), e.get("taskId") or e.get("runId") or ""))
        except Exception: continue
except FileNotFoundError: pass
runs = jrun(["run-list", "--json"]).get("runs", [])
n = 0
for run in runs[:50]:  # 50 run gần nhất — đủ cho máy 1 team
    rid = run.get("id", "")
    for t in jrun(["task-list", "--run", rid, "--json"]).get("tasks", []):
        tid, st = t.get("id"), t.get("status")
        if st == "completed" and ("task.completed", tid) not in seen:
            emit("task.completed", "unknown", rid, tid); n += 1
        if st in ("failed", "abandoned") and ("task.abandoned", tid) not in seen:
            emit("task.abandoned", "unknown", rid, tid); n += 1
print(f"team-orch sync: quét {len(runs)} runs — phát bổ sung {n} event thiếu (id-dedup tự no-op phần trùng)")
PY
    ;;
  *) exec "$ORCA" orchestration "$CMD" "$@" ;;
esac
