#!/bin/bash
# story-mindmap-trigger — wrapper fail-open cho 3 lifecycle trigger của story-mindmap
# (VU-14 SF-1): (a) --reason launch — story-launch gọi sau khi worktree create thành
# công; (b) --reason sweep — vòng sweep/automation gọi định kỳ (bin idempotent:
# payload không đổi → không ghi); (c) --reason close --commit — story-close gọi
# trước cleanup, force-add + commit file .wakii (docs/** ignored nên phải force-add).
# NUỐT missing-bin + mọi lỗi + timeout 30s (khi có `timeout`): sinh mindmap
# KHÔNG ĐƯỢC kéo chết story flow — luôn exit 0 im lặng.
set -u
REASON="run"; COMMIT=0; BRACKET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --reason) if [ $# -ge 2 ]; then REASON="$2"; shift; fi ;;  # thiếu giá trị → giữ default, không vỡ set -u
    --bracket) if [ $# -ge 2 ]; then BRACKET="$2"; shift; fi ;;
    --commit) COMMIT=1 ;;
  esac
  shift
done

DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="${STORY_MINDMAP_BIN:-}"
if [ -n "$BIN" ] && [ ! -f "$BIN" ]; then exit 0; fi  # env chỉ định mà thiếu → tắt chủ ý
[ -n "$BIN" ] || BIN="$DIR/story-mindmap"
[ -f "$BIN" ] || BIN="$HOME/.claude/bin/story-mindmap"
[ -f "$BIN" ] || exit 0

TO=()
command -v timeout >/dev/null 2>&1 && TO=(timeout 30)
run_bin() { # args... — bin thiếu exec-bit thì chạy qua node
  if [ -x "$BIN" ]; then
    ${TO[@]+"${TO[@]}"} "$BIN" "$@" 2>/dev/null
  else
    ${TO[@]+"${TO[@]}"} node "$BIN" "$@" 2>/dev/null
  fi
}

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="$PWD"
STAGED=0
ADDED=()

gen_one() { # $1 bracket — sinh 1 story; --commit thì force-add file vừa sinh
  [ -f "$1" ] || return 0
  local abs out p
  abs="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
  out=$(cd "$ROOT" && run_bin --bracket "$abs") || return 0
  case "$out" in *"(unchanged)"*) return 0 ;; esac
  p=$(printf '%s\n' "$out" | sed -n 's/^out: //p' | head -1)
  [ -n "$p" ] || return 0
  if [ "$COMMIT" = "1" ]; then
    if git -C "$ROOT" add -f -- "$p" >/dev/null 2>&1; then
      STAGED=$((STAGED + 1)); ADDED+=("$p")
    fi
  fi
  return 0
}

if [ -n "$BRACKET" ]; then
  gen_one "$BRACKET"
else
  for b in "$ROOT"/docs/superpowers/brackets/*.md; do
    [ -f "$b" ] && gen_one "$b"
  done
fi

if [ "$STAGED" -gt 0 ]; then
  # commit CHỈ path .wakii mình vừa add — không quét staged lạ vào commit (P1 review 27/09)
  git -C "$ROOT" commit -q -m "chore(story): mindmap snapshot (${REASON})" -- ${ADDED[@]+"${ADDED[@]}"} >/dev/null 2>&1
fi
exit 0
