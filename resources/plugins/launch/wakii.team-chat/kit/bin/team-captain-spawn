#!/bin/bash
# team-captain-spawn — (tự-)heal Captain luôn online (CEO ruling 1/11).
# Terminal Captain chết theo restart app → lệnh này dựng lại ĐỦ 1 lệnh:
# terminal claude mới + brief (đọc hợp đồng captain.md) + nối router
# (registration pane name==captain; router ưu tiên nguồn này).
# Usage: team-captain-spawn [--repo <selector>] [--title <t>]
set -u
ORCA="${ORCA_BIN:-/opt/homebrew/bin/orca}"
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO_SEL="" TITLE="Captain (always-online)" FORCE=0
while [ $# -gt 0 ]; do case "$1" in
  --repo) REPO_SEL="$2"; shift 2 ;;
  --title) TITLE="$2"; shift 2 ;;
  --force) FORCE=1; shift ;;
  *) shift ;;
esac; done

ORCA="${ORCA_BIN:-/opt/homebrew/bin/orca}"

# Idempotent: captain đã ONLINE thì không làm gì (--force để ép dựng lại).
if [ "$FORCE" -eq 0 ]; then
  ALIVE=$(python3 - "$HOME/.claude/chat/.workers.json" "$ORCA" <<'PY'
import json, subprocess, sys, os
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: sys.exit(0)
panes = [p for p, e in reg.items() if isinstance(e, dict) and e.get("name") == "captain"]
if not panes: sys.exit(0)
try:
    out = subprocess.run([sys.argv[2], "terminal", "list", "--json"], capture_output=True, text=True, timeout=15).stdout
    live = {t.get("handle") for t in json.loads(out).get("result", {}).get("terminals", [])}
except Exception: sys.exit(0)
alive = [p for p in panes if p in live]
if alive: print(alive[0])
PY
)
  if [ -n "$ALIVE" ]; then
    echo "team-captain-spawn: Captain ĐÃ online ($ALIVE) — không làm gì. (--force để dựng lại)"
    exit 0
  fi
fi

# Dọn registration captain cũ (chết/theo yêu cầu force) trước khi đăng ký mới.
python3 - "$HOME/.claude/chat/.workers.json" <<'PY'
import json, sys, os
p = sys.argv[1]
try: reg = json.load(open(p, encoding="utf-8"))
except Exception: reg = {}
for pane in [k for k, e in reg.items() if isinstance(e, dict) and e.get("name") == "captain"]:
    reg.pop(pane)
json.dump(reg, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY

echo "team-captain-spawn: dựng Captain terminal mới..."
OUT=$("$ORCA" terminal create ${REPO_SEL:+--worktree "$REPO_SEL"} --title "$TITLE" \
  --command "claude --dangerously-skip-permissions" --json 2>&1) || { echo "$OUT" >&2; exit 1; }
PANE=$(printf '%s' "$OUT" | python3 -c '
import json, sys
def dig(o):
    if isinstance(o, dict):
        for k in ("handle", "terminal"):
            v = o.get(k)
            if isinstance(v, str) and v.startswith("term_"): return v
        for v in o.values():
            r = dig(v)
            if r: return r
    return None
try: print(dig(json.load(sys.stdin)) or "")
except Exception: pass
')
[ -n "$PANE" ] || { echo "không bóc được terminal handle — xem output:" >&2; echo "$OUT" >&2; exit 1; }
echo "→ terminal: $PANE"

# Repo path cho registration (worktree active nếu biết, không thì để trống)
REPO_PATH=""
[ -n "$REPO_SEL" ] && REPO_PATH="${REPO_SEL#path:}"
TC="$HERE/team-chat"; [ -x "$TC" ] || TC="$HOME/.claude/bin/team-chat"
"$TC" send "🔄 Captain terminal mới ($PANE) — đang brief..." --from system --role system --channel general > /dev/null 2>&1 || true

# Brief: Captain đọc hợp đồng đầy đủ trong captain.md — brief ở đây chỉ trỏ tới.
sleep 8  # đợi claude boot trong terminal
"$ORCA" terminal send --terminal "$PANE" --text "Bạn là CAPTAIN của Wakii team — thường trực (always-online) trong terminal này. HỢP ĐỒNG ĐẦY ĐỦ của bạn nằm ở ~/.claude/agents/captain.md — ĐỌC NGAY trước khi làm bất kỳ việc gì (gồm: CHAT STYLE 6 luật · PHÂN CÔNG cứng · Verify-first · Cleanup-on-done · Commit hygiene cấm trailer AI · HEARTBEAT). Khuôn tin: ~/.claude/skills/team-workflow/TEMPLATES.md. Cách trả lời CEO: ~/.claude/bin/team-chat send \"<tin theo CHAT STYLE>\" --from captain --role captain. Điều phối worker: ~/.claude/bin/team-orch (worker-start/feature-open/gate-resolve/cleanup). Đọc ngữ cảnh: ~/.claude/bin/team-chat read --last 15. Xác nhận bạn đã hiểu bằng 1 tin team-chat (CHAT STYLE) — xong nằm chờ lệnh CEO qua router." --enter --json > /dev/null 2>&1 \
  && echo "→ brief đã gửi vào terminal"

# Nối router: registration name=captain (router ưu tiên nguồn này)
"$HERE/team-orch" register --pane "$PANE" --name captain --worktree "$REPO_PATH" --repo team --room general
echo "team-captain-spawn XONG — Captain online tại $PANE. Router đã nối qua registration."
