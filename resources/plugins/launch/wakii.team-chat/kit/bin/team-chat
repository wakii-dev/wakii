#!/bin/bash
# team-chat — CLI vào bus chat team (~/.claude/chat/team-chat.jsonl) cho Captain/workers.
# Panel trong app đọc cùng file qua plugin wakii.team-chat.
#
# Usage:
#   team-chat send "<text>" [--from <tên>] [--role captain|worker|owner|system] [--channel <kênh>]
#   team-chat read  [--last N] [--channel <kênh>]     # in N tin mới nhất (default 20)
#   team-chat tail  [-f] [--channel <kênh>]           # tin mới nhất; -f = theo dõi live
#   team-chat path                                      # in đường dẫn bus
set -u
LOG="${TEAM_CHAT_LOG:-$HOME/.claude/chat/team-chat.jsonl}"
CMD="${1:-read}"; [ $# -gt 0 ] && shift

# Tên đã đăng ký của pane này (P0-2); rỗng = pane chưa đăng ký (terminal tự do).
REGISTERED_NAME() {
  python3 - "${TEAM_WORKERS_REG:-$HOME/.claude/chat/.workers.json}" "${ORCA_AGENT_PANE:-}" "${ORCA_BIN:-orca}" <<'PY' 2>/dev/null
import json, subprocess, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: raise SystemExit
pane = sys.argv[2]
if pane and pane not in reg and ':' in pane:
    tab, leaf = pane.split(':', 1)
    try:
        out = subprocess.run([sys.argv[3], 'terminal', 'list', '--json'],
                             capture_output=True, text=True, timeout=15).stdout
        for t in json.loads(out).get('result', {}).get('terminals', []):
            if t.get('tabId') == tab and t.get('leafId') == leaf:
                pane = t.get('handle', pane); break
    except Exception: pass
e = reg.get(pane)
if isinstance(e, dict): print(e.get("name", ""))
PY
}

# Ghi metadata room (settings ⋮) cho bằng chứng design/mindmap — best-effort,
# room không có trong registry thì bỏ qua, không block tin nhắn.
meta_note() { # field value [--channel c ...passthrough]
  FIELD_="$1" VALUE_="$2"; shift 2; CHANNEL_=""
  while [ $# -gt 0 ]; do case "$1" in
    --channel) CHANNEL_="$2"; break ;; *) shift ;;
  esac; done
  python3 - "$HOME/.claude/chat/rooms.json" "$FIELD_" "$VALUE_" "$CHANNEL_" <<'PY' 2>/dev/null || true
import json, sys
path, field, value, channel = sys.argv[1:5]
try: reg = json.load(open(path, encoding="utf-8"))
except Exception: sys.exit(0)
if not channel:
    opens = [(v.get("createdAt", 0), k) for k, v in reg.items()
             if isinstance(v, dict) and v.get("status") == "open"]
    channel = max(opens)[1] if opens else ""
if channel and channel in reg:
    reg[channel][field] = value[:2000]
    json.dump(reg, open(path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
PY
}

send_msg() {
  local text="$1" from="${TEAM_CHAT_FROM:-${ORCA_AGENT_NAME:-worker}}" from_set=0 role="" role_set=0 channel="__DEFAULT__"
  while [ $# -gt 1 ]; do case "$1" in
    --from) from="$2"; from_set=1; shift 2 ;;
    --role) role="$2"; role_set=1; shift 2 ;;
    --channel) channel="$2"; shift 2 ;;
    *) shift ;;
  esac; done
  # Mặc định linh hoạt (không block): thiếu --channel → room open mới nhất;
  # 'general' chỉ khi không còn room open (general đã xoá không hồi sinh).
  if [ "$channel" = "__DEFAULT__" ]; then
    channel=$(python3 - "$HOME/.claude/chat/rooms.json" <<'PY' 2>/dev/null
import json, sys
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: print("general"); raise SystemExit
opens = [(v.get("createdAt", 0), k) for k, v in reg.items()
         if isinstance(v, dict) and v.get("status") == "open"]
print(max(opens)[1] if opens else "general")
PY
)
    [ -n "$channel" ] || channel="general"
  fi
  # P0-2 danh tính: pane đã đăng ký (team-orch worker-start) → tên bị khóa theo
  # registration. Không --from → ép về tên thật; --from khác tên = từ chối.
  if [ -n "${ORCA_AGENT_PANE:-}" ]; then
    REG_NAME=$(REGISTERED_NAME)
    if [ -n "$REG_NAME" ]; then
      if [ "$from_set" -eq 1 ] && [ "$from" != "$REG_NAME" ]; then
        echo "TỪ CHỐI: pane này đăng ký là '$REG_NAME' — không gửi được với tên '$from'." >&2
        exit 1
      fi
      from="$REG_NAME"
    fi
  fi
  # Role mặc định suy từ tên Captain quen thuộc; --role tường minh luôn thắng.
  if [ "$role_set" -eq 0 ]; then
    case "$from" in
      captain*|zcode*) role="captain" ;;
      owner*|hoivu*) role="owner" ;;
      *) role="worker" ;;
    esac
  fi
  mkdir -p "$(dirname "$LOG")"
  python3 - "$LOG" "$from" "$role" "$channel" "$text" <<'PY'
import json, sys, time
log, frm, role, channel, text = sys.argv[1:6]
line = json.dumps({"at": int(time.time()*1000), "from": frm[:40], "role": role[:12],
                   "channel": channel[:32], "text": text[:4000]})
with open(log, "a", encoding="utf-8") as f:
    f.write(line + "\n")
PY
  echo "→ #$channel $from: ${text:0:60}"
}

emit_event() {
  # team-chat event <kind> --repo <id> [--repo-path p] [--run-id r] [--task-id t]
  #   [--actor a] [--data '<json>'] — id = sha1(kind|sourceEntityId) (vòng 5: dedup qua đường phát).
  local kind="$1" repo="" repo_path="" run="" task="" actor="system" data="{}"
  [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --repo-path) repo_path="$2"; shift 2 ;;
    --run-id) run="$2"; shift 2 ;;
    --task-id) task="$2"; shift 2 ;;
    --actor) actor="$2"; shift 2 ;;
    --data) data="$2"; shift 2 ;;
    *) shift ;;
  esac; done
  [ -n "$repo" ] || { echo "team-chat event: --repo <repoId> bắt buộc (§1 spec)" >&2; exit 2; }
  EVENTS_LOG="${TEAM_EVENTS_LOG:-$HOME/.claude/chat/team-events.jsonl}"
  mkdir -p "$(dirname "$EVENTS_LOG")"
  python3 - "$EVENTS_LOG" "$kind" "$repo" "$repo_path" "$run" "$task" "$actor" "$data" <<'PY'
import hashlib, json, sys, time
log, kind, repo, repo_path, run, task, actor, data = sys.argv[1:9]
try: d = json.loads(data)
except Exception: d = {}
src = task or run or f"{kind}|{int(time.time()*1000)}|{actor}"
eid = hashlib.sha1(f"{kind}|{src}".encode()).hexdigest()[:12]
line = {"v": 1, "id": eid, "at": int(time.time() * 1000), "kind": kind, "repoId": repo,
        "repoPath": repo_path or None, "runId": run or None, "taskId": task or None,
        "actor": actor, "data": d}
seen = set()
try:
    for l in open(log, encoding="utf-8"):
        try: seen.add(json.loads(l).get("id"))
        except Exception: continue  # dòng hỏng — bỏ qua (lỗ F), không chặn bus
except FileNotFoundError:
    pass
if eid in seen:
    print(f"→ event {kind} {actor} ({eid}) [dedup — đã có]")
else:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps(line, ensure_ascii=False) + "\n")
    print(f"→ event {kind} {actor} ({eid})")
PY
}

read_msgs() {
  local n=20 channel=""
  while [ $# -gt 0 ]; do case "$1" in
    --last|-n) n="$2"; shift 2 ;;
    --channel) channel="$2"; shift 2 ;;
    *) shift ;;
  esac; done
  [ -f "$LOG" ] || { echo "(chưa có tin nhắn — bus: $LOG)"; exit 0; }
  python3 - "$LOG" "$n" "$channel" <<'PY'
import json, sys, datetime
log, n, channel = sys.argv[1], int(sys.argv[2]), sys.argv[3]
try:
    lines = [l for l in open(log, encoding="utf-8") if l.strip()]
except FileNotFoundError:
    lines = []
for l in lines[-n*3 if channel else -n:]:
    try:
        m = json.loads(l)
    except Exception:
        continue
    if channel and m.get("channel") != channel:
        continue
    t = datetime.datetime.fromtimestamp(m["at"]/1000).strftime("%H:%M")
    print(f'{t} {m.get("from","?"):12.12} [{m.get("role","?"):7.7}] {m.get("text","")}')
PY
}

tail_msgs() {
  if [ "${1:-}" = "-f" ]; then
    [ -f "$LOG" ] && tail -n 20 "$LOG" >/dev/null 2>&1
    exec tail -f "$LOG" 2>/dev/null | python3 -u -c '
import sys, json, datetime
for l in sys.stdin:
    try: m = json.loads(l)
    except Exception: continue
    t = datetime.datetime.fromtimestamp(m["at"]/1000).strftime("%H:%M")
    print(f"{t} {m.get(chr(102)+chr(114)+chr(111)+chr(109),chr(63)):12.12} [{m.get(chr(114)+chr(111)+chr(108)+chr(101),chr(63)):7.7}] {m.get(chr(116)+chr(101)+chr(120)+chr(116),chr(32))}", flush=True)
'
  fi
  read_msgs --last 5
}

case "$CMD" in
  send)  [ $# -eq 0 ] && { echo "usage: team-chat send \"<text>\" [--from name] [--role r] [--channel c]" >&2; exit 2; }
         send_msg "$@" ;;
  # ── Template commands (§0.0 + G3.5): format bắt buộc — worker không thể viết sai ──
  plan)  # team-chat plan "<các bước + DoD>" [--channel c] → tin [PLAN] ...
         case "$1" in -*) echo "usage: team-chat plan \"<các bước + DoD đo được>\" [--channel c] (text positional, không phải flag)" >&2; exit 2 ;; esac
         [ $# -eq 0 ] && { echo "usage: team-chat plan \"<các bước + DoD đo được>\" [--channel c]" >&2; exit 2; }
         TEXT="$1"; shift; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         send_msg "[PLAN] $TEXT" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  design) # team-chat design "<thiết kế>" [--channel c] → [DESIGN] bằng chứng trình CEO duyệt (stage-gate 3)
         case "$1" in -*) echo "usage: team-chat design \"<flow, màn hình, data model, trade-off>\" [--channel c]" >&2; exit 2 ;; esac
         [ $# -eq 0 ] && { echo "usage: team-chat design \"<nội dung thiết kế>\" [--channel c]" >&2; exit 2; }
         TEXT="$1"; shift; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         meta_note "plan" "[DESIGN] chờ CEO duyệt" ${TPL_PASS[@]+"${TPL_PASS[@]}"}
         send_msg "[DESIGN] $TEXT" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  mindmap) # team-chat mindmap "<cây thụt lề>" [--file docs/mindmap.wakii] [--channel c]
         # Sơ đồ tư duy FEATURE (scope/luồng — KHÔNG phải design UI). Ghi file .wakii
         # (chuẩn Wakii) trong worktree + card 🧠 trình CEO duyệt scope.
         case "$1" in -*) echo "usage: team-chat mindmap \"<cây thụt lề, 2 space/cấp>\" [--file docs/mindmap.wakii] [--channel c]" >&2; exit 2 ;; esac
         [ $# -eq 0 ] && { echo "usage: team-chat mindmap \"<cây>\" [--file f] [--channel c]" >&2; exit 2; }
         TEXT="$1"; shift; MM_FILE=""; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           --file) MM_FILE="$2"; shift 2 ;;
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         [ -n "$MM_FILE" ] || MM_FILE="docs/mindmap.wakii"
         MM_DIR=$(dirname "$MM_FILE"); mkdir -p "$MM_DIR" 2>/dev/null || true
         python3 - "$MM_FILE" "$TEXT" <<'PY' 2>/dev/null || true
import sys
path, tree = sys.argv[1], sys.argv[2]
with open(path, "w", encoding="utf-8") as f:
    f.write("# wakii-mindmap v1\n")
    f.write(tree.rstrip() + "\n")
PY
         echo "mindmap: đã lưu $MM_FILE"
         meta_note "mindmap" "$MM_FILE" ${TPL_PASS[@]+"${TPL_PASS[@]}"}
         send_msg "[MINDMAP] 📄 $MM_FILE
$TEXT" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  impact) # team-chat impact "<yêu cầu>" --scope --arch --risk --effort --deps --rec → [IMPACT] đa chiều (Scout, stage 1)
         REQ_="$1"; shift
         SCOPE_="" ARCH_="" RISK_="" EFF_="" DEPS_="" REC_=""; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           --scope) SCOPE_="$2"; shift 2 ;;
           --arch) ARCH_="$2"; shift 2 ;;
           --risk) RISK_="$2"; shift 2 ;;
           --effort) EFF_="$2"; shift 2 ;;
           --deps) DEPS_="$2"; shift 2 ;;
           --rec) REC_="$2"; shift 2 ;;
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         [ -n "$REQ_" ] && [ -n "$SCOPE_" ] && [ -n "$ARCH_" ] && [ -n "$RISK_" ] && [ -n "$EFF_" ] && [ -n "$DEPS_" ] && [ -n "$REC_" ] || {
           echo "usage: team-chat impact \"<yêu cầu>\" --scope \"..\" --arch \"..\" --risk \"..\" --effort \"..\" --deps \"..\" --rec \"..\"" >&2
           echo "IMPACT phải ĐỦ 6 chiều — thiếu chiều nào là phân tích 1 chiều, bị trả lại." >&2; exit 2; }
         send_msg "[IMPACT] $REQ_ — ① Phạm vi: $SCOPE_ ② Kiến trúc: $ARCH_ ③ Rủi ro: $RISK_ ④ Effort: $EFF_ ⑤ Phụ thuộc: $DEPS_ ⑥ Đề xuất: $REC_" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  bug)   # team-chat bug "<mô tả>" --steps .. --expected .. --actual .. [--shot "📷id"] → card 🔥 [BUG]
         DESC_B="$1"; shift
         STEPS_="" EXP_="" ACT_="" SHOT_=""; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           --steps) STEPS_="$2"; shift 2 ;;
           --expected) EXP_="$2"; shift 2 ;;
           --actual) ACT_="$2"; shift 2 ;;
           --shot) SHOT_="$2"; shift 2 ;;
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         [ -n "$DESC_B" ] && [ -n "$EXP_" ] && [ -n "$ACT_" ] || {
           echo "usage: team-chat bug \"<mô tả>\" --steps \"<tái hiện>\" --expected \"<đúng>\" --actual \"<sai>\" [--shot 📷id]" >&2
           echo "BUG phải đủ: mô tả + kỳ vọng + thực tế (thiếu là trả lại — không đoán mò)." >&2; exit 2; }
         send_msg "[BUG] $DESC_B — ① Tái hiện: ${STEPS_:-xem ảnh đính kèm} ② Kỳ vọng: $EXP_ ③ Thực tế: $ACT_${SHOT_:+
$SHOT_}" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  review) # team-chat review "<scope>" --checked .. --findings .. --verdict ok|cần-sửa → [REVIEW] của Reviewer (độc lập với người viết)
         SCOPE_R="$1"; shift
         CHK_="" FND_="" VERDICT_=""; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           --checked) CHK_="$2"; shift 2 ;;
           --findings) FND_="$2"; shift 2 ;;
           --verdict) VERDICT_="$2"; shift 2 ;;
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         [ -n "$SCOPE_R" ] && [ -n "$CHK_" ] && [ -n "$FND_" ] && { [ "$VERDICT_" = "ok" ] || [ "$VERDICT_" = "cần-sửa" ]; } || {
           echo "usage: team-chat review \"<scope>\" --checked \"<đã xem+chạy test gì>\" --findings \"<phát hiện>\" --verdict ok|cần-sửa" >&2
           echo "REVIEW phải đủ 3 phần + verdict hợp lệ (ok|cần-sửa) — review suông không bằng chứng bị trả lại." >&2; exit 2; }
         send_msg "[REVIEW] $SCOPE_R — ① Đã kiểm: $CHK_ ② Phát hiện: $FND_ ③ Phán quyết: $VERDICT_" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  done)  # team-chat done "<task>" --did .. --test .. --evidence .. → DONE 3 phần (bắt buộc đủ 3)
         TID=""; DID=""; TST=""; EVD=""; TPL_PASS=()
         TID="$1"; shift
         while [ $# -gt 0 ]; do case "$1" in
           --did) DID="$2"; shift 2 ;;
           --test) TST="$2"; shift 2 ;;
           --evidence) EVD="$2"; shift 2 ;;
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         [ -n "$TID" ] && [ -n "$DID" ] && [ -n "$TST" ] && [ -n "$EVD" ] || {
           echo "usage: team-chat done \"<task>\" --did \"<đã làm>\" --test \"<cách test>\" --evidence \"<bằng chứng>\"" >&2
           echo "DONE phải ĐỦ 3 phần (hiến pháp §0.0) — thiếu là bị trả lại." >&2; exit 2; }
         send_msg "DONE $TID — ① Đã làm: $DID ② Cách test: $TST ③ Bằng chứng: $EVD" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  ask)   # team-chat ask "<dòng 'N. câu? (a) .. (b) ..'>" → form hỏi CEO — panel hiện chip bấm
         case "$1" in -*) echo "usage: team-chat ask \"1. Câu hỏi? (a) lựa chọn (b) lựa chọn\" (mỗi câu 1 dòng)" >&2; exit 2 ;; esac
         [ $# -eq 0 ] && { echo "usage: team-chat ask \"<câu hỏi + options>\"" >&2; exit 2; }
         TEXT="$1"; shift; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         send_msg "[HỎI] $TEXT" ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  blocked) # team-chat blocked "<lý do>" → BLOCKED (anti-grind: block×3 → Captain ép hướng)
         case "$1" in -*) echo "usage: team-chat blocked \"<lý do + đã thử gì>\"" >&2; exit 2 ;; esac
         [ $# -eq 0 ] && { echo "usage: team-chat blocked \"<lý do + đã thử gì>\"" >&2; exit 2; }
         TEXT="$1"; shift; TPL_PASS=()
         while [ $# -gt 0 ]; do case "$1" in
           *) TPL_PASS+=("$1"); shift ;;
         esac; done
         send_msg "BLOCKED $TEXT" --role worker ${TPL_PASS[@]+"${TPL_PASS[@]}"} ;;
  event) [ $# -lt 2 ] && { echo "usage: team-chat event <kind> --repo <id> [--run-id r] [--task-id t] [--actor a] [--data json]" >&2; exit 2; }
         emit_event "$@" ;;
  rooms) python3 - "$HOME/.claude/chat/rooms.json" "$LOG" <<'PY'
import json, sys, os
try: reg = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: reg = {}
counts = {}
try:
    for l in open(sys.argv[2], encoding="utf-8"):
        try: m = json.loads(l)
        except Exception: continue
        c = m.get("channel", "general"); counts[c] = counts.get(c, 0) + 1
except FileNotFoundError: pass
print(f"{'#general':32} {counts.get('general', 0):5} tin (mặc định)")
for room, e in sorted(reg.items(), key=lambda kv: -kv[1].get("createdAt", 0)):
    mark = "🟢" if e.get("status") == "open" else "🔒"
    print(f"#{room:31} {counts.get(room, 0):5} tin {mark} feature={e.get('feature','?')} run={(e.get('run') or '?')[:18]}")
PY
  ;;
  read)  read_msgs "$@" ;;
  tail)  tail_msgs "$@" ;;
  path)  echo "$LOG" ;;
  *)     echo "usage: team-chat send|plan|done|ask|blocked|rooms|read|tail|event|path — templates xem skills/team-workflow/TEMPLATES.md" >&2; exit 2 ;;
esac
