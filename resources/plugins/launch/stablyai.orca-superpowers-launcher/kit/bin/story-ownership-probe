#!/bin/bash
# story-ownership-probe — thư viện ownership probe dùng chung (LOCAL-1 SF-3):
# run/worktree nào đang có worker live của coordinator NÀO (bài học collision
# 19/09 — 2 coordinator cùng đụng SF-4). Dùng chung bởi story-coordinator-pass
# (qua exec --json), story-launch (pre-dispatch block), story-watchdog +
# story-top (cột owner). Tên theo domain — KHÔNG phải lib generic.
#
# Worker live = terminalState "active" + liveness verdict "live"/"unverifiable"
# (nguồn: orchestration worker-list — cùng predicate coordinator-pass SF-1).
# Owner của worker = coordinator_handle của run (fallback agentTerminalHandle).
#
# Cách dùng:
#   . bin/story-ownership-probe        # source — KHÔNG set -u vào caller
#   ownership_probe_load [runs-file]   # nạp maps (1 lượt fetch worker-list +
#                                      #  run-list; có runs-file thì dùng lại,
#                                      #  không fetch run-list lần 2). rc0 = có data
#   ownership_probe_self               → self handle (OP_SELF: --self/env/run-current)
#   ownership_probe_run_live <runId>   → rc0 khi run có worker live
#   ownership_probe_run_owner <runId>  → in owner handle
#   ownership_probe_worktree_owner <wt-basename-hoặc-full-path>
#                                      → in "runId<TAB>owner" khi worktree có
#                                        worker live; rỗng khi không
#   ownership_probe_process_hits      → in "pid|zone|cwd|comm" agent live NGOÀI
#                                        tầm run/worker-list (LOCAL-4 SF-1):
#                                        zone=primary (cwd trên primary checkout,
#                                        env OP_PRIMARY) hoặc zone=oob (cwd trong
#                                        worktree OP_WT_PATHS nhưng không có worker
#                                        live trong worker-list). Scan lsof cwd,
#                                        fixture OP_PROC_JSON/OP_PROC_FILE, pattern
#                                        OP_AGENT_PAT, seam lsof OP_LSOF_BIN.
#                                        KHÔNG kill — chỉ báo cáo.
#   exec bin/story-ownership-probe --json [--self H] [runs-json-qua-stdin]
#                                      → JSON cho consumer python:
#     {"self","orcaOk","workersOk","liveRuns":[],"runOwner":{},
#      "worktreeLive":[{name,run,owner,path}],"worktreeByDispatch":{dispatch:path}}
#      worktreeLive = list (2 repo trùng basename vẫn giữ đủ record);
#      worktreeByDispatch gồm MỌI worker (kể cả released — evidence verify).
#
# Fail-open theo kit convention: probe hỏng → OP_LOADED=0 + warn stderr, caller
# chạy tiếp không chặn (degrade — không có data thì không phán được ownership).
#
# Biến sau load: OP_LIVE_RUNS (space-sep) · OP_RUN_OWNER (id|owner\n) ·
# OP_WT_LIVE (name|run|owner|path\n) · OP_WT_BY_DISPATCH (dispatch|path\n) ·
# OP_SELF · OP_ORCA_OK · OP_WORKERS_OK · OP_LOADED. Record nối bằng "|" —
# path/handle chứa "|" sẽ misparse (fail-open, không block nhầm — chấp nhận).
#
# Story-level (run của SF) chỉ suy được qua worktree của SF — run không gắn
# worktree không link được (fuzzy match objective là đoán mò — cố tình không làm).
# -u chỉ bật khi chạy trực tiếp — KHÔNG rò vào caller khi source (review SF-3 P1)
if [ "${BASH_SOURCE[0]:-}" = "$0" ]; then set -u; fi

OP_LIVE_RUNS=""; OP_RUN_OWNER=""; OP_WT_LIVE=""; OP_WT_BY_DISPATCH=""
OP_SELF=""; OP_ORCA_OK=1; OP_WORKERS_OK=1; OP_LOADED=0

op_warn() { echo "ownership-probe: $*" >&2; }

if [ "${BASH_SOURCE[0]:-}" = "$0" ] && [ "${1:-}" != "--json" ]; then
  echo "usage: source bin/story-ownership-probe — ownership_probe_load ... ; hoặc exec bin/story-ownership-probe --json [--self H]"
  exit 2
fi

_op_reset() {
  OP_LIVE_RUNS=""; OP_RUN_OWNER=""; OP_WT_LIVE=""; OP_WT_BY_DISPATCH=""
  OP_SELF=""; OP_ORCA_OK=1; OP_WORKERS_OK=1; OP_LOADED=0
}

# ── core python (1 implementation cho cả face bash + face --json) ──
# env vào: OP_MODE json|tsv · OP_SELF_ARG · OP_RUNS_JSON (raw) · OP_RUNS_FILE
# · OP_ORCA_BIN (trống → tự resolve) · ORCA_DEV/ORCA_PROD
_op_core() { # stdin không dùng — python source qua heredoc, data qua env
  local py
  py="$(command -v python3 || command -v python)" || { op_warn "python không có — probe tắt"; return 1; }
  OP_MODE="${1:-tsv}" OP_SELF_ARG="${2:-}" OP_ORCA_BIN="${ORCA_BIN:-}" \
    ORCA_DEV="${ORCA_DEV:-$HOME/Library/Application Support/orca-dev}" \
    ORCA_PROD="${ORCA_PROD:-$HOME/Library/Application Support/orca}" \
    "$py" - <<'OPCORE'
import json
import os
import subprocess
import sys

mode = os.environ.get("OP_MODE", "tsv")
self_arg = os.environ.get("OP_SELF_ARG", "")

orca_bin = os.environ.get("OP_ORCA_BIN", "")
if not orca_bin or not os.access(orca_bin, os.X_OK):
    import shutil
    orca_bin = (shutil.which("orca") or "/opt/homebrew/bin/orca"
                or "/usr/local/bin/orca")
for cand in ("/Applications/Wakii.app/Contents/Resources/bin/orca",
             "/Applications/Orca.app/Contents/Resources/bin/orca"):
    if not orca_bin or not os.access(orca_bin, os.X_OK):
        if os.access(cand, os.X_OK):
            orca_bin = cand
if not orca_bin:
    print("ownership-probe: orca binary không tìm thấy", file=sys.stderr)
    sys.exit(1)

ORCA_DEV = os.environ.get("ORCA_DEV", "")
ORCA_PROD = os.environ.get("ORCA_PROD", "")


def sh_seam_argv(bin_path, args):
    # Windows: python không exec được script #!/bin|env sh/bash (kit test seam,
    # giống execMaybe của story-mindmap). File không đuôi trên nt: bash-spawn
    # CHỈ khi là script — `command -v orca` trả path MSYS không đuôi cho binary
    # thật (MZ/ELF) → bash rc 126, nên đọc 2 byte đầu để tách binary/script.
    # Path MSYS (/c/...) python không open được (Errno 2) → which(basename)
    # resolve lại Windows-native (MSYS strip .exe trong PATH lookup).
    if bin_path.endswith(".sh"):
        return ["bash", bin_path] + list(args)
    if os.name == "nt" and not os.path.splitext(bin_path)[1]:
        try:
            with open(bin_path, "rb") as f:
                magic = f.read(2)
        except OSError:
            import shutil
            resolved = shutil.which(os.path.basename(bin_path))
            if resolved:
                bin_path = resolved
            return [bin_path] + list(args)
        if magic not in (b"MZ", b"\x7fE"):  # không phải PE/ELF → coi là script
            return ["bash", bin_path] + list(args)
    return [bin_path] + list(args)


def run_orca(args, timeout_s=45):
    """Spawn orca (dev→prod→plain runtime) → JSON parsed, hoặc None khi fail."""
    for ud in (ORCA_DEV, ORCA_PROD, None):
        env = dict(os.environ)
        if ud:
            env["ORCA_USER_DATA_PATH"] = ud
        else:
            env.pop("ORCA_USER_DATA_PATH", None)
        try:
            p = subprocess.run(sh_seam_argv(orca_bin, args), capture_output=True,
                               text=True, timeout=timeout_s, env=env)
        except (subprocess.TimeoutExpired, OSError):
            continue
        if p.returncode == 0:
            try:
                return json.loads(p.stdout)
            except Exception:
                continue
    return None


def rows(d, key):
    if d is None:
        return None
    r = (d.get("result") or {}).get(key)
    if r is None and key in d:  # bare {key: [...]} không bọc result
        r = d.get(key)
    return r or []


def first_of(d, *keys):
    for k in keys:
        v = d.get(k)
        if v:
            return v
    return ""


# runs: env raw JSON → env file → tự fetch run-list (đúng thứ tự ưu tiên)
runs = None
runs_ok = True
raw = os.environ.get("OP_RUNS_JSON", "")
runs_file = os.environ.get("OP_RUNS_FILE", "")
if raw.strip():
    try:
        parsed = json.loads(raw)
        runs = parsed if isinstance(parsed, list) else rows(parsed, "runs")
        if runs is None:
            runs = []
    except Exception:
        runs = []
elif runs_file and os.path.isfile(runs_file):
    try:
        with open(runs_file, encoding="utf-8") as f:
            parsed = json.load(f)
        runs = parsed if isinstance(parsed, list) else rows(parsed, "runs")
        if runs is None:
            runs = []
    except Exception:
        runs = []
else:
    d = run_orca(["orchestration", "run-list", "--json", "--limit", "100"])
    runs = rows(d, "runs")
    runs_ok = d is not None
    if runs is None:
        runs = []

wd = run_orca(["orchestration", "worker-list", "--json", "--limit", "100"])
workers = rows(wd, "workers")
workers_ok = wd is not None
if workers is None:
    workers = []

run_owner = {}
for r in runs:
    rid = r.get("id") or ""
    if rid:
        run_owner[rid] = first_of(r, "coordinator_handle", "coordinatorHandle")

LIVE_VERDICTS = ("live", "unverifiable")
live_runs = []            # giữ thứ tự, dedup dưới
wt_live = {}              # path → {run, owner, name} — key theo path (unique);
                          # key theo name sẽ nuốt record khi 2 repo trùng basename
wt_by_dispatch = {}       # dispatchId → full path (MỌI worker — kể cả released)
for w in workers:
    dispatch = w.get("dispatchId") or ""
    wt_path = ((w.get("resource") or {}).get("worktreeId") or "").split("::")[-1]
    if dispatch and wt_path:
        wt_by_dispatch[dispatch] = wt_path
    liveness = ((w.get("projection") or {}).get("liveness") or {}).get("verdict") or ""
    if w.get("terminalState") != "active" or liveness not in LIVE_VERDICTS:
        continue
    rid = w.get("runId") or w.get("run_id") or ""
    if rid and rid not in live_runs:
        live_runs.append(rid)
    if wt_path:
        name = os.path.basename(wt_path.rstrip("/")) or wt_path
        owner = run_owner.get(rid) or (w.get("agentTerminalHandle") or "")
        wt_live.setdefault(wt_path, {"run": rid, "owner": owner, "name": name})

# self: --self/env thắng (consumer đã resolve), trống → probe run-current
self_handle = self_arg or os.environ.get("ORCA_COORDINATOR_HANDLE", "")
if not self_handle:
    d = run_orca(["orchestration", "run-current", "--json"])
    cur = (d or {}).get("result") or {}
    self_handle = first_of(cur.get("run") or {}, "coordinatorHandle",
                           "coordinator_handle")

orca_ok = runs_ok  # run-list chết = orca unavailable (semantics coordinator-pass)

if mode == "json":
    print(json.dumps({
        "self": self_handle, "orcaOk": orca_ok, "workersOk": workers_ok,
        "liveRuns": live_runs, "runOwner": run_owner,
        "worktreeLive": [{"name": v["name"], "run": v["run"], "owner": v["owner"],
                          "path": p} for p, v in wt_live.items()],
        "worktreeByDispatch": wt_by_dispatch,
    }, ensure_ascii=False))
    sys.exit(0)

# TSV face — tag\t... mỗi dòng
print(f"META\t{1 if orca_ok else 0}\t{1 if workers_ok else 0}\t{self_handle}")
for rid in live_runs:
    print(f"LIVE\t{rid}")
for rid, owner in run_owner.items():
    if owner:
        print(f"OWNER\t{rid}\t{owner}")
for path, info in wt_live.items():
    print(f"WTLIVE\t{info['name']}\t{info['run']}\t{info['owner']}\t{path}")
for dispatch, path in wt_by_dispatch.items():
    print(f"WTDISP\t{dispatch}\t{path}")
OPCORE
}

ownership_probe_load() { # $1 (optional) file chứa runs JSON — nạp maps. rc0 = OP_LOADED=1
  _op_reset
  local out
  if [ -n "${1:-}" ] && [ -f "$1" ]; then
    out="$(OP_RUNS_FILE="$1" _op_core tsv 2>/dev/null)"
  else
    out="$(_op_core tsv 2>/dev/null)"
  fi
  [ -n "$out" ] || { op_warn "probe không đọc được — degrade"; return 1; }
  while IFS=$'\t' read -r tag a b c d; do
    case "$tag" in
      META)   OP_ORCA_OK="$a"; OP_WORKERS_OK="$b"; OP_SELF="$c" ;;
      LIVE)   OP_LIVE_RUNS="$OP_LIVE_RUNS $a" ;;
      OWNER)  OP_RUN_OWNER="$OP_RUN_OWNER$a|$b"$'\n' ;;
      WTLIVE) OP_WT_LIVE="$OP_WT_LIVE$a|$b|$c|$d"$'\n' ;;
      WTDISP) OP_WT_BY_DISPATCH="$OP_WT_BY_DISPATCH$a|$b"$'\n' ;;
    esac
  done < <(printf '%s\n' "$out")
  [ "$OP_ORCA_OK" = "1" ] || op_warn "orca không đọc được — data thiếu"
  [ "$OP_WORKERS_OK" = "1" ] || op_warn "worker-list đọc không được — degrade (chỉ run-list)"
  OP_LOADED=1
  return 0
}

ownership_probe_self() { printf '%s' "$OP_SELF"; }

ownership_probe_run_live() { # rc0 khi run $1 có worker live
  [ -n "$1" ] || return 1
  case " $OP_LIVE_RUNS " in *" $1 "*) return 0 ;; esac
  return 1
}

ownership_probe_run_owner() { # in owner handle của run $1 ("" khi không rõ)
  local row
  while IFS='|' read -r rid owner; do
    [ -n "$rid" ] || continue
    [ "$rid" = "$1" ] && { printf '%s' "$owner"; return 0; }
  done < <(printf '%s\n' "$OP_RUN_OWNER")
  return 0
}

ownership_probe_worktree_owner() { # $1 wt basename hoặc full path; $2 (optional)
                                    # parent-dir — khi có, chỉ nhận record đúng repo
                                    # (chống basename trùng giữa 2 repo — review SF-3)
                                    # → in "runId<TAB>owner" khi worktree có worker live
  local key="$1" parent="${2:-}" name run owner path pdir
  [ -n "$key" ] || return 0
  while IFS='|' read -r name run owner path; do
    [ -n "$name" ] || continue
    [ "$name" = "$key" ] || [ "$path" = "$key" ] || continue
    if [ -n "$parent" ]; then
      pdir="$(dirname "$path" 2>/dev/null)"
      [ "$pdir" = "$parent" ] || continue
    fi
    printf '%s\t%s' "$run" "$owner"
    return 0
  done < <(printf '%s\n' "$OP_WT_LIVE")
  return 0
}

# ── process-scan (LOCAL-4 SF-1): 2 vùng mù đêm 03/10 — worker agent cwd-trên-
# primary + worker ngoài orchestration (spawn tay — run-list không thấy). Scan
# lsof cwd (fixture OP_PROC_JSON/OP_PROC_FILE cho test), lọc comm theo
# OP_AGENT_PAT, loại ancestor chain của launcher (không tự chặn), classify:
# primary (cwd trong primary checkout, trừ <primary>/.claude/worktrees) / wt
# (cwd trong SF worktree). KHÔNG kill — chỉ báo cáo. Fail-open: scan hỏng →
# PROCERR → warn, không chặn mù. cwd chứa "|" sẽ misparse (như các map trên).
_op_proc_core() { # stdout TSV: PROC\tpid\tzone\tcwd\tcomm\twt · PROCERR\tlý-do
  local py
  py="$(command -v python3 || command -v python)" || { printf 'PROCERR\tpython không có\n'; return 0; }
  OP_PRIMARY="${OP_PRIMARY:-}" OP_WT_PATHS="${OP_WT_PATHS:-}" \
    OP_PROC_JSON="${OP_PROC_JSON:-}" OP_PROC_FILE="${OP_PROC_FILE:-}" \
    OP_AGENT_PAT="${OP_AGENT_PAT:-}" OP_LSOF_BIN="${OP_LSOF_BIN:-lsof}" \
    "$py" - <<'OPPROC'
import json
import os
import re
import subprocess
import sys


def emit(tag, *fields):
    print("\t".join((tag,) + fields))


def read_rows():
    raw = os.environ.get("OP_PROC_JSON", "")
    pfile = os.environ.get("OP_PROC_FILE", "")
    if raw.strip() or (pfile and os.path.isfile(pfile)):
        try:
            if raw.strip():
                data = json.loads(raw)
            else:
                with open(pfile, encoding="utf-8") as f:
                    data = json.load(f)
            items = data if isinstance(data, list) else (data.get("processes") or [])
            rows = []
            for x in items:
                if not isinstance(x, dict):
                    continue
                try:
                    pid = int(x.get("pid") or 0)
                except (TypeError, ValueError):
                    pid = 0
                rows.append({"pid": pid, "comm": str(x.get("comm") or ""),
                             "cwd": str(x.get("cwd") or "")})
            return rows, ""
        except Exception as e:
            return [], f"fixture hỏng: {e}"
    lsof = os.environ.get("OP_LSOF_BIN") or "lsof"
    try:
        p = subprocess.run([lsof, "-wn", "-d", "cwd", "-F", "pcn"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return [], f"lsof hỏng: {e}"
    if p.returncode not in (0, 1):  # rc1 = không thấy process nào — không phải lỗi
        return [], f"lsof rc={p.returncode}"
    rows, cur = [], None

    def push():
        if cur and cur.get("pid") and cur.get("cwd"):
            rows.append(dict(cur))

    for ln in (p.stdout or "").splitlines():
        if not ln:
            continue
        tag, val = ln[0], ln[1:]
        if tag == "p":
            push()
            cur = {"pid": int(val), "comm": "", "cwd": ""} if val.isdigit() else None
        elif cur is not None:
            if tag == "c":
                cur["comm"] = val
            elif tag == "n" and not cur["cwd"]:
                cur["cwd"] = val
    push()
    return rows, ""


def ancestor_pids():
    # chain của launcher (python→bash→caller) — process tham gia quyết định
    # launch không tự chặn chính mình
    seen = set()
    pid, hops = os.getpid(), 0
    while pid > 1 and hops < 64:
        try:
            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=10)
            ppid = int((out.stdout or "").strip() or 0)
        except Exception:
            break
        if ppid <= 1:
            break
        seen.add(ppid)
        pid = ppid
        hops += 1
    return seen


def within(child, parent):
    try:
        c, p = os.path.realpath(child), os.path.realpath(parent)
    except Exception:
        return False
    return c == p or c.startswith(p + os.sep)


rows, err = read_rows()
if err:
    emit("PROCERR", err)
    sys.exit(0)
primary = os.environ.get("OP_PRIMARY", "")
wt_paths = [w for w in (os.environ.get("OP_WT_PATHS", "") or "").splitlines() if w.strip()]
# worktree native (EnterWorktree) dưới primary không tính là primary
primary_wts = os.path.join(primary, ".claude", "worktrees") if primary else ""
pat_s = os.environ.get("OP_AGENT_PAT") or (
    r"^(claude|codex|gemini|cursor-agent|aider|opencode|droid|copilot)([ -.]|$)")
try:
    pat = re.compile(pat_s)
except re.error:
    emit("PROCERR", f"pattern hỏng: {pat_s}")
    sys.exit(0)
anc = ancestor_pids()
for r in rows:
    pid, comm, cwd = r["pid"], r["comm"], r["cwd"]
    if not pid or not cwd or pid in anc:
        continue
    if not pat.search(comm):
        continue
    if primary and within(cwd, primary):
        if primary_wts and within(cwd, primary_wts):
            continue
        emit("PROC", str(pid), "primary", cwd, comm, "")
        continue
    wt = next((w for w in wt_paths if within(cwd, w)), "")
    if wt:
        emit("PROC", str(pid), "wt", cwd, comm, wt)
OPPROC
  return 0
}

ownership_probe_process_hits() { # in "pid|zone|cwd|comm" của agent live ngoài tầm
                                  # orchestration — zone=primary (cwd trên primary
                                  # checkout) hoặc zone=oob (trong SF worktree nhưng
                                  # worker-list không thấy live; in-band drop —
                                  # block logic cũ qua worktree_owner quyết).
                                  # rỗng = sạch hoặc fail-open. Cần ownership_probe_load
                                  # chạy trước cho filter in-band.
  local out pid zone cwd comm wt wtrun
  OP_PROC_HITS=""
  out="$(_op_proc_core 2>/dev/null)" || out=""
  while IFS=$'\t' read -r tag pid zone cwd comm wt; do
    case "$tag" in
      # PROCERR: field đầu sau tag = lý-do (fail-open — không chặn mù)
      PROCERR) op_warn "process scan không đọc được ($pid) — fail-open, vùng mù không kiểm tra" ;;
      PROC)
        [ -n "$pid" ] || continue
        if [ "$zone" = "wt" ]; then
          wtrun="$(ownership_probe_worktree_owner "$wt" "$(dirname "$wt" 2>/dev/null)")"
          [ -n "$wtrun" ] && continue  # in-band — orchestration thấy, logic cũ quyết
          zone="oob"
        fi
        OP_PROC_HITS="$OP_PROC_HITS$pid|$zone|$cwd|$comm"$'\n' ;;
    esac
  done < <(printf '%s\n' "$out")
  printf '%s' "$OP_PROC_HITS"
}

# exec face: --json cho consumer python (coordinator-pass) — stdin = runs JSON tùy chọn
if [ "${BASH_SOURCE[0]:-}" = "$0" ]; then
  shift  # bỏ --json
  SELF_ARG=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --self) SELF_ARG="${2:-}"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done
  if [ -t 0 ]; then
    _op_core json "$SELF_ARG"
  else
    OP_RUNS_JSON="$(cat)" _op_core json "$SELF_ARG"
  fi
  exit $?
fi
