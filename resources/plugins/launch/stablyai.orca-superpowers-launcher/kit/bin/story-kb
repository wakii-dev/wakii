#!/usr/bin/env python3
"""story-kb — query bin read-only cho Project Knowledge Base (GH-45 SF-1, #38).

Layer 1 ADE knowledge infra: agents truy vấn KB (adr/repos/glossary/MOC) thay vì
tái đọc GitHub. KB vắng → exit 0 fail-open (agents không chết trên máy chưa có
KB). Layout + frontmatter contract pin trong docs/knowledge/adr/0001.

CLI: story-kb <subcommand> [args...] [--dir <path>]
  query-adr <keyword...>   AND-match filename+title+body, top-5 + path
  query-repo <keyword...>  scan repos/ (org--repo + title), top-5 + grading
  glossary [term]          entry block; không term → TOC
  moc [section]            section đến heading kế; không term → TOC
  stats                    counts (adr/repos/glossary/MOC) + dir đang dùng

Dir resolve: --dir > env WAKII_KB_DIR > [<git-root>/docs/knowledge,
<git-root>/../wakii-site/docs/knowledge]. KB dir hợp lệ = có ít nhất 1 trong
adr/ · repos/ · glossary.md · MOC.md.
Exit: 0 (kể cả no-match / KB not configured) · 2 usage."""
import os
import re
import subprocess
import sys

# Bin chạy trực tiếp — không đẻ __pycache__ vào kit/ (contentHash ổn định,
# bài học story-review-fuse/story-memory).
sys.dont_write_bytecode = True

# Pipe stdout trên Windows mặc định cp1252 → chết UnicodeEncodeError (GH-27).
for _s in (sys.stdout, sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

KB_MARKERS = ("adr", "repos", "glossary.md", "MOC.md")
TOP_N = 5
SNIPPET_MAX = 160

# YAML-ish tolerant: dòng `key: value` giữa cặp `---` — KHÔNG YAML lib (zero-dep).
FM_LINE_RE = re.compile(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$")


def usage(msg=None):
    if msg:
        print(f"usage error: {msg}", file=sys.stderr)
    print("usage: story-kb <query-adr|query-repo|glossary|moc|stats> [args...] "
          "[--dir <path>]", file=sys.stderr)
    sys.exit(2)


def git_root():
    """git rev-parse --show-toplevel từ cwd — arg-list, utf-8/replace (GH-27)."""
    try:
        r = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, encoding="utf-8", errors="replace", timeout=10)
        out = (r.stdout or "").strip()
        return out if out and r.returncode == 0 else None
    except Exception:
        return None


def is_kb_dir(path):
    """KB dir hợp lệ = tồn tại + có ít nhất 1 marker (adr/ repos/ glossary.md MOC.md)."""
    if not path or not os.path.isdir(path):
        return False
    return any(os.path.exists(os.path.join(path, m)) for m in KB_MARKERS)


def resolve_kb_dir(cli_dir):
    """--dir > WAKII_KB_DIR > candidates. Returns (dir|None, probed:list)."""
    if cli_dir:
        probed = [os.path.abspath(cli_dir)]
        return (probed[0] if is_kb_dir(probed[0]) else None), probed
    probed = []
    env_dir = os.environ.get("WAKII_KB_DIR")
    if env_dir:
        probed.append(os.path.abspath(env_dir))
        if is_kb_dir(probed[0]):
            return probed[0], probed
    root = git_root()
    base = root if root else os.getcwd()
    candidates = [
        os.path.join(base, "docs", "knowledge"),
        os.path.normpath(os.path.join(base, os.pardir, "wakii-site", "docs", "knowledge")),
    ]
    for c in candidates:
        probed.append(c)
        if is_kb_dir(c):
            return c, probed
    return None, probed


def fail_open(probed):
    print(f"KB not configured — probed: {', '.join(probed)}")
    sys.exit(0)


def main(argv):
    args, cli_dir = [], None
    i = 0
    while i < len(argv):
        if argv[i] == "--dir":
            if i + 1 >= len(argv):
                usage("--dir cần <path>")
            cli_dir = argv[i + 1]
            i += 2
        elif argv[i].startswith("--dir="):
            cli_dir = argv[i].split("=", 1)[1]
            i += 1
        elif argv[i] in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        else:
            args.append(argv[i])
            i += 1
    if not args:
        usage("thiếu subcommand")
    cmd, rest = args[0], args[1:]

    handlers = {
        "query-adr": cmd_query_adr,
        "query-repo": cmd_query_repo,
        "glossary": cmd_glossary,
        "moc": cmd_moc,
        "stats": cmd_stats,
    }
    fn = handlers.get(cmd)
    if fn is None:
        usage(f"subcommand không rõ: {cmd}")

    kb_dir, probed = resolve_kb_dir(cli_dir)
    if kb_dir is None:
        fail_open(probed)

    fn(kb_dir, rest)
    sys.exit(0)


def read_md(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def parse_frontmatter(text):
    """Returns ({key: value}, body_start_line_index). No frontmatter → ({}, 0)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, 0
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return {}, 0
    fm = {}
    for ln in lines[1:end]:
        m = FM_LINE_RE.match(ln)
        if m:
            fm[m.group(1).lower()] = m.group(2).strip()
    return fm, end + 1


def trunc(s, cap=SNIPPET_MAX):
    return s if len(s) <= cap else s[: cap - 3] + "..."


def first_snippet(body_lines, kws):
    """Dòng đầu chứa 1 keyword nào đó; không có → dòng non-empty đầu."""
    hit = next((l for l in body_lines
                if any(k.lower() in l.lower() for k in kws)), None)
    return (hit or next((l for l in body_lines if l.strip()), "")).strip()


def cmd_query_adr(kb_dir, args):
    kws = [k for k in args if not k.startswith("--")]
    if not kws:
        usage("query-adr cần ít nhất 1 keyword")
    adr_dir = os.path.join(kb_dir, "adr")
    results = []
    if os.path.isdir(adr_dir):
        for name in sorted(os.listdir(adr_dir)):
            if not name.endswith(".md"):
                continue
            path = os.path.join(adr_dir, name)
            text = read_md(path)
            if text is None:
                continue
            fm, body_at = parse_frontmatter(text)
            hay = f"{name}\n{fm.get('title', '')}\n{text}".lower()
            if all(k.lower() in hay for k in kws):
                results.append((name, path, fm, text, body_at))
    if not results:
        print("no ADR match")
        return
    for name, path, fm, text, body_at in results[:TOP_N]:
        body_lines = text.splitlines()[body_at:]
        print(f"== {name}")
        print(fm.get("title") or name)
        print(trunc(first_snippet(body_lines, kws)))
        print(f"(path: {path})")
    if len(results) > TOP_N:
        print(f"({len(results)} ADR match — top-{TOP_N} hiển thị, refine keyword để thu hẹp)")


def grading_line(text, fm):
    """Grading từ frontmatter; thiếu → tìm dòng `grading:` đầu trong body."""
    if fm.get("grading"):
        return fm["grading"]
    for ln in text.splitlines():
        s = ln.strip()
        if s.lower().startswith("grading:"):
            return s.split(":", 1)[1].strip()
    return "(không khai báo)"


def cmd_query_repo(kb_dir, args):
    kws = [k for k in args if not k.startswith("--")]
    if not kws:
        usage("query-repo cần ít nhất 1 keyword")
    repos_dir = os.path.join(kb_dir, "repos")
    results = []
    if os.path.isdir(repos_dir):
        for name in sorted(os.listdir(repos_dir)):
            if not name.endswith(".md"):
                continue
            path = os.path.join(repos_dir, name)
            text = read_md(path)
            if text is None:
                continue
            fm, _ = parse_frontmatter(text)
            hay = f"{name}\n{fm.get('title', '')}\n{text}".lower()
            if all(k.lower() in hay for k in kws):
                results.append((name, path, fm, text))
    if not results:
        print("no repo match")
        return
    for name, path, fm, text in results[:TOP_N]:
        print(f"== {name}")
        print(fm.get("title") or name)
        print(f"grading: {grading_line(text, fm)}")
        print(f"(path: {path})")
    if len(results) > TOP_N:
        print(f"({len(results)} repo match — top-{TOP_N} hiển thị, refine keyword để thu hẹp)")


def toc_and_section(text, term):
    """Returns (toc_lines, block_lines|None). Block = heading chứa term (case-
    insens) đến heading kế bất kỳ cấp; term khớp dòng thường → in dòng đó."""
    lines = text.splitlines()
    toc = [l for l in lines if l.lstrip().startswith("#")]
    if not term:
        return toc, None
    tl = term.lower()
    start = next((i for i, l in enumerate(lines)
                  if l.lstrip().startswith("#") and tl in l.lower()), None)
    if start is not None:
        end = next((i for i in range(start + 1, len(lines))
                    if lines[i].lstrip().startswith("#")), len(lines))
        block = [l for l in lines[start:end] if l.strip()]
        return toc, block
    hit = next((l for l in lines if not l.lstrip().startswith("#") and tl in l.lower()),
               None)
    if hit is not None:
        return toc, [trunc(hit.strip())]
    return toc, None


def run_doc_cmd(kb_dir, args, fname, label):
    term = args[0] if args and not args[0].startswith("--") else None
    if len([a for a in args if not a.startswith("--")]) > 1:
        usage(f"{label} nhận tối đa 1 term")
    path = os.path.join(kb_dir, fname)
    text = read_md(path)
    if text is None:
        print(f"no {fname} in {kb_dir}")
        return
    toc, block = toc_and_section(text, term)
    if block is None:
        if term:
            print(f"no {label} entry for '{term}'")
            return
        if not toc:
            print(f"{fname} rỗng (không có heading)")
            return
        for l in toc:
            print(l)
        return
    for l in block:
        print(l)


def cmd_glossary(kb_dir, args):
    run_doc_cmd(kb_dir, args, "glossary.md", "glossary")


def cmd_moc(kb_dir, args):
    run_doc_cmd(kb_dir, args, "MOC.md", "moc")


def cmd_stats(kb_dir, args):
    def count_md(sub):
        d = os.path.join(kb_dir, sub)
        return sum(1 for n in os.listdir(d) if n.endswith(".md")) if os.path.isdir(d) else 0

    def line_count(fname):
        text = read_md(os.path.join(kb_dir, fname))
        return len(text.splitlines()) if text is not None else 0

    print(f"KB: {kb_dir}")
    print(f"adr: {count_md('adr')} files")
    print(f"repos: {count_md('repos')} files")
    print(f"glossary: {line_count('glossary.md')} lines")
    print(f"MOC: {line_count('MOC.md')} lines")


if __name__ == "__main__":
    main(sys.argv[1:])
