#!/bin/bash
# story-verify — enforce COMPLETE-RUN CHECKLIST 5 bước TRƯỚC khi Linear Done
# (tool hóa bước kiểm của story-workflow — chống "Done sớm": tick Done mà chưa merge)
#
# 5 bước (thứ tự cố định — B5 chỉ hợp lệ khi B1-B4 pass):
#   B1 CODE+TESTS   — có commit code thật (ngoài CREATE/APPROVE/plan) + file test
#   B2 PLAN TICKED  — plan file còn 0 task [ ] chưa tick
#   B2b SURFACE LINT — bounded-rewrite enforcer (GH-30): story-surface-lint <base>
#                      trên SF worktree; FAIL → story-verify INCOMPLETE (exit 1).
#                      Base từ env STORY_LINT_BASE, fallback wakii-dev. No-op (exit 0
#                      "no diff") → không đổi verdict.
#   B3 REVIEW       — Linear comments có VERDICT APPROVED (code-reviewer)
#   B4 MERGED       — HEAD của SF là ancestor của nhánh đích (story/<dest>)
#   B5 LINEAR DONE  — issue state = Done
#
# Verdict: COMPLETE (đủ 5) · READY-TO-DONE (B1-B4 pass, còn B5) · INCOMPLETE (thiếu
# bước trước) · VIOLATION (Done nhưng B1-B4 fail — Done sớm) · NOT-LAUNCHED (chưa
# có worktree). Story-level: mọi SF COMPLETE → STORY-COMPLETE (user merge main).
#
# Usage: story-verify [<sf-name>] [--json]
# Exit: 0 sạch/ready · 1 có INCOMPLETE · 2 có VIOLATION
set -u

ORCA_BIN="${ORCA_BIN:-}"
[ -x "$ORCA_BIN" ] || ORCA_BIN="$(command -v orca 2>/dev/null)"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/opt/homebrew/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/usr/local/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Wakii.app/Contents/Resources/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Orca.app/Contents/Resources/bin/orca"
# verify config — ~/.claude/story-kit.json (STORY_KIT_CONFIG override cho test).
# Toggle các gate MỚI (plugin panel bật/tắt — FI-380 review plan); B1-B5 cốt lõi
# luôn bật, không tắt được. Mặc định: evidence/realMode/checklist ON, smoke OFF.
VERIFY_CFG_FILE="${STORY_KIT_CONFIG:-$HOME/.claude/story-kit.json}"
EVIDENCE_GATE=1; REALMODE_GATE=1; CHECKLIST_GATE=1; SMOKE_GATE=0; TDD_GATE=1
if [ -f "$VERIFY_CFG_FILE" ]; then
  cfg_vals=$(python3 - "$VERIFY_CFG_FILE" <<'CFGEOF'
import json, sys
try: v = json.load(open(sys.argv[1])).get('verify', {})
except Exception: v = {}
print(int(bool(v.get('evidenceGate', True))), int(bool(v.get('realModeRule', True))), int(bool(v.get('reviewerChecklist', True))), int(bool(v.get('runtimeSmoke', False))), int(bool(v.get('tddMode', True))))
CFGEOF
) 2>/dev/null
  if [ -n "$cfg_vals" ]; then read -r EVIDENCE_GATE REALMODE_GATE CHECKLIST_GATE SMOKE_GATE TDD_GATE <<< "$cfg_vals"; fi
fi
export VERIFY_CHECKLIST="$CHECKLIST_GATE"
ORCA_DEV="$HOME/Library/Application Support/orca-dev"
ORCA_PROD="$HOME/Library/Application Support/orca"
JSON_OUT=0
SF_ARG=""

while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON_OUT=1 ;;
    --print-config)
      printf '{"evidenceGate":%s,"realModeRule":%s,"reviewerChecklist":%s,"runtimeSmoke":%s,"tddMode":%s}\n' \
        "$EVIDENCE_GATE" "$REALMODE_GATE" "$CHECKLIST_GATE" "$SMOKE_GATE" "$TDD_GATE"
      exit 0 ;;
    -*) echo "Unknown: $1"; exit 2 ;;
    *) SF_ARG="$1" ;;
  esac
  shift
done

orca() {
  # capture rồi mới forward — dev-path error JSON (exit 1) không được lẫn vào
  # stdout của prod, nếu không json.load downstream fail trên output ghép đôi
  local out
  out=$(ORCA_USER_DATA_PATH="$ORCA_DEV" "$ORCA_BIN" "$@" 2>/dev/null) \
    && { printf '%s' "$out"; return 0; }
  out=$(ORCA_USER_DATA_PATH="$ORCA_PROD" "$ORCA_BIN" "$@" 2>/dev/null) \
    && { printf '%s' "$out"; return 0; }
  # Why: Windows keeps runtime metadata under %APPDATA%\orca, not the macOS
  # Library paths above — every forced override fails there and bare orca
  # autodetects. A bare call never mixes dev/prod output, safe to forward.
  out=$("$ORCA_BIN" "$@" 2>/dev/null) \
    && { printf '%s' "$out"; return 0; }
  return 1
}

# linear state + comments cho 1 issue → in "<state>|<approved 0/1>"
# orca CLI trước; keychain hỏng (bài học FI-187) → GraphQL fallback cùng
# key file như watchdog (~/.claude/.linear-key, chmod 600)
linear_meta() {
  local out
  out=$(orca linear issue "$1" --comments --json 2>/dev/null | python3 -c "
import json, sys, re, os
try: r = json.load(sys.stdin)['result']
except: print('unknown|0'); sys.exit(0)
iss = r.get('issue') or {}
st = (iss.get('state') or {}).get('name', '?')
# orca CLI: comments nằm ở result.comments (NGANG HÀNG issue) — không
# phải issue.comments (bug 30/8: đọc nhầm chỗ → B3 FAIL dù verdict có)
cs = r.get('comments')
nodes = cs.get('nodes', []) if isinstance(cs, dict) else (cs or [])
approved = 0
for c in nodes:
    body = (c.get('body') or '') if isinstance(c, dict) else str(c)
    if re.search(r'VERDICT[^\n]{0,40}APPROVED', body, re.I):
        # checklist gate (verify.reviewerChecklist): APPROVED phải kèm
        # CHECKLIST-4Q (4 câu network-in-tx/timeout/best-effort/partial-fail)
        if os.environ.get('VERIFY_CHECKLIST') != '1' or 'CHECKLIST-4Q' in body: approved = 1
print(f'{st}|{approved}')" 2>/dev/null || echo "unknown|0")
  case "$out" in unknown\|*) ;; *) echo "$out"; return ;; esac
  # GraphQL fallback
  local key="${LINEAR_API_KEY:-}"
  if [ -z "$key" ] && [ -f "$HOME/.claude/.linear-key" ]; then
    key=$(head -1 "$HOME/.claude/.linear-key" | tr -d '[:space:]')
  fi
  [ -z "$key" ] && { echo "unknown|0"; return; }
  curl -s -m 15 -X POST https://api.linear.app/graphql \
    -H "Authorization: $key" -H "Content-Type: application/json" \
    -d "{\"query\":\"query{issue(id:\\\"$1\\\"){state{name} comments(first:50){nodes{body}}}}\"}" 2>/dev/null \
    | python3 -c "
import json, sys, re, os
try: d = json.load(sys.stdin)['data']['issue']
except: print('unknown|0'); sys.exit(0)
st = (d.get('state') or {}).get('name', '?')
approved = 0
for c in (d.get('comments') or {}).get('nodes', []):
    if re.search(r'VERDICT[^\n]{0,40}APPROVED', c.get('body') or '', re.I):
        if os.environ.get('VERIFY_CHECKLIST') != '1' or 'CHECKLIST-4Q' in (c.get('body') or ''): approved = 1
print(f'{st}|{approved}')" 2>/dev/null || echo "unknown|0"
}

dest_fetch_check() { # $1 repo $2 dest — pattern dest_fetch_check (story-launch); rc = git rc
  DEST_REMOTE="$(git -C "$1" config "branch.$2.remote" 2>/dev/null)"
  [ -n "$DEST_REMOTE" ] || DEST_REMOTE=origin
  local fc # HTTPS treo câm → low-speed env cắt sau 30s (timeout cmd chỉ có Linux)
  fc=(git -C "$1" fetch "$DEST_REMOTE" "$2")
  command -v timeout >/dev/null 2>&1 && fc=(timeout 60 "${fc[@]}")
  FERR=$(GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 "${fc[@]}" 2>&1 1>/dev/null)
}

dc_enabled_read() { # stdout 0/1 — .distributed.enabled từ VERIFY_CFG_FILE (default 0)
  python3 -c "
import json, sys
try: print(int(bool(json.load(open(sys.argv[1])).get('distributed', {}).get('enabled', False))))
except Exception: print(0)" "$VERIFY_CFG_FILE" 2>/dev/null
}

# resolve-mindmap (B3 scoping — spec LOCAL-5 sf-3): story ID từ basename worktree —
# cắt đuôi -sf-<n> (<story>-sf-<n>) HOẶC cắt đầu sf-<n>- (sf-<n>-<slug>); match
# exact <hint>.wakii → boundary-anchored <hint>-* (dash-normalized: fi-458 ≡ fi458).
# 0/>1 match → MM_PICK rỗng (fail-open như linear-rỗng, KHÔNG chọn hộ theo
# alphabet — bệnh FI-305/local4-sf-3); MM_ERR chỉ khác rỗng khi AMBIGUOUS.
resolve_mindmap() { # $1 wt $2 sf-basename → MM_PICK path|rỗng · MM_ERR ""|ambiguous:<names>
  MM_PICK=""; MM_ERR=""
  local dir="$1/docs/superpowers/mindmaps" out
  [ -d "$dir" ] || return 0
  out=$(MM_DIR="$dir" MM_BASE="$2" python3 - <<'PYMM' 2>/dev/null
import os, re
base = os.environ.get('MM_BASE', '').lower()
m = re.search(r'-sf-?\d+$', base)
if m: hint = base[:m.start()]
elif re.match(r'^sf-?\d+-', base): hint = re.sub(r'^sf-?\d+-', '', base)
else: hint = base
tok = hint.replace('-', '')
exact, bnd = [], []
try: names = sorted(os.listdir(os.environ.get('MM_DIR', '')))
except Exception: names = []
for f in names:
    if not f.endswith('.wakii'): continue
    stem = f[:-6]
    if stem.replace('-', '') == tok: exact.append(f); continue
    parts = stem.split('-')
    for i in range(1, len(parts)):
        if '-'.join(parts[:i]).replace('-', '') == tok: bnd.append(f); break
picks = exact or bnd
if len(picks) == 1: print(os.path.join(os.environ['MM_DIR'], picks[0]))
elif len(picks) > 1: print('AMBIGUOUS ' + ','.join(sorted(picks)))
else: print('NONE')
PYMM
  ) || out=""
  case "$out" in
    NONE|"") ;;
    AMBIGUOUS\ *) MM_ERR="ambiguous: ${out#AMBIGUOUS }" ;;
    *) MM_PICK="$out" ;;
  esac
}

b4_check() { # $1 wt $2 dest $3 enabled(0/1) → stdout 2 dòng: "<PASS|FAIL>\n<stale-note>"
  local wt="$1" dest="$2" rt note=""
  if [ "$3" = "1" ]; then
    if dest_fetch_check "$wt" "$dest"; then
      # FETCH_HEAD chỉ đọc khi fetch rc=0 — fetch cũ không nhiễm verdict
      rt=$(git -C "$wt" rev-parse FETCH_HEAD 2>/dev/null)
      if [ -n "$rt" ] && git -C "$wt" merge-base --is-ancestor HEAD "$rt" 2>/dev/null; then
        printf 'PASS\n\n'; return
      fi
    else
      note="fetched-stale (fetch ${DEST_REMOTE:-origin}/$dest fail — verdict local)"
      [ -n "${FERR:-}" ] && note="$note [$(printf '%s' "$FERR" | head -1)]"
    fi
  fi
  git -C "$wt" merge-base --is-ancestor HEAD "$dest" 2>/dev/null && printf 'PASS\n' || printf 'FAIL\n'
  printf '%s\n' "$note"
}

verify_sf() { # $1 worktree → in "<sf>|<verdict>|<detail>|<b1>|<b2>|<b3>|<b4>|<b5>"
  wt="$1"; sf=$(basename "$wt")

  # meta từ bracket (linear ID + destination) — cùng logic story-resume
  linear=""; dest=""
  # ƯU TIÊU orca worktree metadata (linked issue + base branch) — bracket glob
  # chỉ là fallback (repo nhiều bracket → glob-first chọn nhầm story cũ)
  # MSYS/Git Bash: $HOME-derived wt is /c/... but orca JSON emits C:/... —
  # normalize or metadata priority never matches on Windows.
  wt_norm=$(cygpath -m "$wt" 2>/dev/null || printf '%s' "$wt")
  mline=$(printf '%s\n' "$WT_META" | grep -F "$wt_norm|" | head -1)
  if [ -n "$mline" ]; then
    linear=$(printf '%s' "$mline" | cut -d'|' -f2)
    dest=$(printf '%s' "$mline" | cut -d'|' -f3)
  fi
  # Metadata-first tiếp: dest rỗng (worktree tạo trước khi orca lưu baseRef,
  # hoặc tạo manual) → branch của worktree cha là đích merge của SF (cấu trúc
  # workflow quy định SF fork từ cha) — bracket glob vẫn là lớp cuối.
  if [ -z "$dest" ]; then
    pline=$(printf '%s\n' "$WT_META" | grep -F "$wt_norm|" | head -1)
    [ -n "$pline" ] && dest=$(printf '%s' "$pline" | cut -d'|' -f4)
  fi
  if [ -z "$linear" ] || [ -z "$dest" ]; then
  # lớp fallback 1: mindmap KHỚP story ID (scoping resolve_mindmap — glob-first
  # theo alphabet từng chọn nhầm story cũ: fi305 chặn story local → B3 FAIL ảo);
  # 0/>1 match → không phán (dest/linear để trống cho lớp kế). Lớp 2: bracket legacy
  sfnum=$(echo "$sf" | grep -oE 'sf-?[0-9]+' | head -1 | tr 'a-z' 'A-Z')
  resolve_mindmap "$wt" "$sf"
  if [ -n "$MM_PICK" ]; then
    wline=$(SFNUM="$sfnum" python3 - "$MM_PICK" <<'PYVW'
import json, os, sys
try:
    doc = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    sys.exit(0)
meta = doc.get('meta') or {}
lin = ''
for x in doc.get('nodes') or []:
    if isinstance(x, dict) and x.get('kind') == 'sf' and x.get('id') == os.environ.get('SFNUM', '').lower():
        lin = str(x.get('linear') or '')
        break
print(str(meta.get('dest') or '') + '|' + lin)
PYVW
    ) || wline=""
    [ -z "$dest" ] && dest=${wline%%|*}
    if [ -z "$linear" ]; then
      linear=${wline#*|}
      [ "$linear" = "|" ] && linear=""
    fi
  fi
  for bf in "$wt"/docs/superpowers/brackets/*.md; do
    [ -f "$bf" ] || continue
    [ -z "$dest" ] && dest=$(grep -m1 '^Destination:' "$bf" | sed 's/Destination: //')
    # Why not cut -d- -f1-2: coordinators name worktrees `<story>-sf-<n>`
    # (fi28-sf-1) — that cut yields FI28-SF, which matches no `## SF-<n>`
    # section. Extract the sf-<n> token wherever it sits in the name.
    sfnum=$(echo "$sf" | grep -oE 'sf-?[0-9]+' | head -1 | tr 'a-z' 'A-Z')
    # Metadata linear wins — fallback awk only fills an empty value
    # (unconditional overwrite let a stale bracket clobber a correct link).
    if [ -z "$linear" ]; then
      linear=$(awk -v sfx="$sfnum" '
        $0 ~ "^## " sfx "([ :]|$)" { in_sf = 1; next }
        /^## SF-/ { in_sf = 0 }
        in_sf && /linear:/ { gsub(/.*linear: /,""); print; exit }' "$bf" 2>/dev/null)
    fi
    [ -n "$linear" ] && break
  done
  fi

  # B1 code+tests — commit code thật ngoài CREATE/APPROVE/plan + file test
  # (grep -c in "0" + exit 1 khi 0 match — KHÔNG dùng '|| echo 0' sẽ thành 2 dòng)
  code_commits=$(git -C "$wt" log --format=%s 2>/dev/null | grep -cvE '^(story (CREATE|APPROVE)|Initial|plan)'); code_commits=${code_commits:-0}
  test_files=$(git -C "$wt" ls-files 2>/dev/null | grep -cE '(test|spec)\.'); test_files=${test_files:-0}
  if   [ "$code_commits" -gt 0 ] && [ "$test_files" -gt 0 ]; then b1="PASS"
  elif [ "$code_commits" -gt 0 ]; then b1="WARN"; else b1="FAIL"; fi
  b1_note=""
  N=$(echo "$sf" | grep -oE '[0-9]+' | head -1)
  # context-pack budget (team discipline v1.1): pack > 8KB (~2k tokens) →
  # WARN slice lại — pack phình đốt token mỗi lần agent đọc (caveman doctrine)
  cp_size=0
  for cand in "$wt"/docs/superpowers/contexts/*-sf-"$N".md "$wt"/docs/superpowers/contexts/sf-"$N".md; do
    [ -f "$cand" ] && { cp_size=$(wc -c < "$cand"); break; }
  done
  if [ "${cp_size:-0}" -gt 8192 ]; then b2="WARN"; fi
  head_hash=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null)
  sftok=$(echo "$sf" | grep -oE 'sf-?[0-9]+' | head -1)

  # B1+ evidence gate (verify.evidenceGate) — test phải PASS CÓ BẰNG CHỨNG:
  # docs/superpowers/evidence/<sf>/test-run.txt chứa HEAD hash hiện tại.
  # Học FI-380/Ahamove #77: file test tồn tại ≠ test đã chạy được.
  if [ "$EVIDENCE_GATE" = 1 ] && [ "$b1" != "FAIL" ]; then
    ev="$wt/docs/superpowers/evidence/$sf/test-run.txt"
    # Established convention on this repo is slug evidence dirs (sf-1-<slug>)
    # while worktrees are named <story>-sf-<n> — fall back to the token glob,
    # NEO BIÊN `sf-<n>-*`/`sf-<n>.*` (glob `sf-1*` cũ bắt cả `sf-10-*`, chỉ sai
    # error message — spec LOCAL-5 sf-3 #2). Hash rỗng KHÔNG được auto-match
    # (grep '' match mọi file — từng làm stale-check thành no-op).
    [ -f "$ev" ] || ev=$(ls "$wt"/docs/superpowers/evidence/"$sftok"-*/test-run.txt "$wt"/docs/superpowers/evidence/"$sftok".*/test-run.txt 2>/dev/null | head -1)
    # chấp nhận HEAD hoặc HEAD~1: evidence commit ngay sau code commit —
    # hash trong evidence = code commit (HEAD~1), không thể tự chứa chính nó
    parent_hash=$(git -C "$wt" rev-parse --short HEAD~1 2>/dev/null)
    hash_hit=0
    { [ -f "$ev" ] && [ -n "$head_hash" ] && grep -q "$head_hash" "$ev" 2>/dev/null; } && hash_hit=1
    { [ "$hash_hit" = 0 ] && [ -n "$parent_hash" ] && grep -q "$parent_hash" "$ev" 2>/dev/null; } && hash_hit=1
    if [ ! -f "$ev" ] || [ "$hash_hit" = 0 ]; then
      b1="FAIL"; b1_note="evidence thiếu/cũ: docs/superpowers/evidence/$sf/test-run.txt (phải chứa HEAD ${head_hash:-?} hoặc code commit trước đó) — chạy test + ghi output"
    elif [ "$TDD_GATE" = 1 ] && ! grep -q "^tdd:" "$ev" 2>/dev/null; then
      b1="FAIL"; b1_note="thiếu dòng 'tdd: RED→GREEN' hoặc 'tdd: skipped-tdd: <lý do>' trong test-run.txt (verify.tddMode — chống tautology assert, học gh27 b6)"
    fi
  fi

  # real-mode rule (verify.realModeRule) — plan/spec nhắc dual-mode/mock/
  # adapter → phải có test real-path; học Ahamove #77: mock xanh che orphan
  # booking + no-timeout chỉ nổ ở real mode.
  real_note=""
  if [ "$REALMODE_GATE" = 1 ] && grep -qliE 'dual.mode|mock|adapter' "$wt"/docs/superpowers/plans/*.md 2>/dev/null; then
    real_tests=$(git -C "$wt" ls-files 2>/dev/null | grep -ciE '(real|integration)[^/]*(test|spec)'); real_tests=${real_tests:-0}
    [ "$real_tests" -eq 0 ] && real_note="⚠ spec nhắc mock/dual-mode mà không thấy test real-path (*real*test*/*integration*) — mock xanh có thể che bug real-mode"
  fi

  # B2 plan ticked — còn bao nhiêu task [ ]?
  # (chấp nhận cả "sf-3" lẫn "sf3" — agents đặt tên plan không đồng nhất dash)
  plan=""; open_tasks=0
  # Same sf-token rule as the bracket derive: p1 = the sf-<n> token itself
  # (matches `*-sf-1-*` plan names), p2 = first two dash fields (matches
  # story-prefixed names like *fi28-sf-*).
  local p1=$(echo "$sf" | grep -oE 'sf-?[0-9]+' | head -1); local p2=$(echo "$sf" | cut -d- -f1-2)
  for pf in "$wt"/docs/superpowers/plans/*.md; do
    [ -f "$pf" ] || continue
    case "$(basename "$pf")" in *"$p1"*|*"$p2"*) plan="$pf"; break ;; esac
  done
  if [ -n "$plan" ]; then
    open_tasks=$(grep -c '^\- \[ \]' "$plan" 2>/dev/null); open_tasks=${open_tasks:-0}
    [ "$open_tasks" -eq 0 ] && b2="PASS" || b2="FAIL"
  else b2="WARN"; fi

  # B2b surface lint (GH-30) — lint FAIL → FAIL; lint crash/no-bin → WARN (enforcer
  # chính là lint; story-verify không tự đoán bounded-rewrite). Chạy từ $wt để
  # diff scope là commits của SF, base mặc định wakii-dev (STORY_LINT_BASE override).
  b2b="PASS"
  lint_note="" # tokens FAIL của lint — đi qua detail (OB_NOTE chết trong subshell verify_sf)
  lint_base="${STORY_LINT_BASE:-wakii-dev}"
  # Windows: bare python3 dính Store alias stub (exit 9009, chết im) — resolve
  # python3→python→py như surface-lint-tests.mjs
  PY_BIN=""
  for p in python3 python py; do
    if command -v "$p" >/dev/null 2>&1 && "$p" --version >/dev/null 2>&1; then PY_BIN="$p"; break; fi
  done
  lint_bin=""
  for cand in "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)/resources/plugins/launch/stablyai.orca-superpowers-launcher/kit/bin/story-surface-lint" "$HOME/.claude/bin/story-surface-lint"; do
    [ -n "${cand%%$'\n'*}" ] && [ -f "$cand" ] && { lint_bin="$cand"; break; }
  done
  if [ -n "$PY_BIN" ] && [ -n "$lint_bin" ]; then
    lint_out=$(STORY_LINT_DIR="$wt" "$PY_BIN" "$lint_bin" "$lint_base" 2>/dev/null)
    lint_code=$?
    case "$lint_code" in
      0) b2b="PASS" ;;
      1) b2b="FAIL"; lint_note="lint: $(printf '%s' "$lint_out" | grep -E '^(MISSING-|BAD-DATE|EXPIRED)' | head -3 | tr '\n' ' ')" ;;
      *) b2b="WARN" ;;
    esac
  else
    b2b="WARN" # lint bin chưa cài — không chặn verify, doctrine sống ở lint
  fi

  # B3 review APPROVED (từ Linear comments)
  if [ -n "$linear" ] && [ "$linear" != "unknown" ]; then
    IFS='|' read -r lstate approved <<< "$(linear_meta "$linear")"
    if [ "$approved" = 1 ]; then b3="PASS"
    else
      # fallback: verdict kẹt OUTBOX (bài học SF-1 19:48: reviewer viết file
      # xong nhưng chưa post lên Linear — B3 FAIL mù dù review ĐÃ xong)
      sfp=$(echo "$sf" | grep -oE 'sf-?[0-9]+' | head -1)
      ob=$(grep -l "VERDICT: APPROVED" /tmp/story/*/code-reviewer-"$sfp"*.md 2>/dev/null | head -1)
      b3="FAIL"
      [ -n "$ob" ] && { b3="OUTBOX"; OB_NOTE="verdict trong $ob — CHƯA post lên Linear (agent cần post + Done)"; }
    fi
  else lstate="unknown"; approved=0; b3="UNKNOWN"; fi

  # B4 merged — HEAD là ancestor của nhánh đích (cùng object store mọi worktree).
  # SF-2 remote-safe: distributed ON → fetch dest trước (máy khác push merge);
  # fetch fail → verdict local + ⚠ fetched-stale; OFF → path cũ nguyên vẹn (zero-diff)
  b4_note=""
  if [ -n "$dest" ] && git -C "$wt" rev-parse --verify -q "$dest" >/dev/null; then
    b4line=$(b4_check "$wt" "$dest" "$DC_ON")
    # $(...) xé newline đuôi — chỉ có dòng 2 khi b4line chứa newline thật
    case "$b4line" in
      *$'\n'*) b4=${b4line%%$'\n'*}; b4_note=${b4line#*$'\n'} ;;
      *) b4="$b4line" ;;
    esac
    [ -n "$b4_note" ] && echo "distributed: ⚠ $b4_note" >&2
  else b4="FAIL"; fi

  # B3.5 runtime smoke (verify.runtimeSmoke — mặc định OFF): evidence
  # docs/superpowers/evidence/<sf>/smoke.txt chứa HEAD hash — executor chạy
  # smoke (app/service boots + 0 ERROR mới) rồi ghi output. Bật khi cần
  # chặn bug chỉ thấy ở runtime (panel chết, icon trắng, exec-bit — FI-380).
  b_smoke="OFF"; smoke_note=""
  if [ "$SMOKE_GATE" = 1 ]; then
    sev="$wt/docs/superpowers/evidence/$sf/smoke.txt"
    # cùng neo biên `sf-<n>-*`/`sf-<n>.*` như evidence gate (P2 SF-3)
    [ -f "$sev" ] || sev=$(ls "$wt"/docs/superpowers/evidence/"$sftok"-*/smoke.txt "$wt"/docs/superpowers/evidence/"$sftok".*/smoke.txt 2>/dev/null | head -1)
    parent_hash=$(git -C "$wt" rev-parse --short HEAD~1 2>/dev/null)
    smoke_hit=0
    { [ -f "$sev" ] && [ -n "$head_hash" ] && grep -q "$head_hash" "$sev" 2>/dev/null; } && smoke_hit=1
    { [ "$smoke_hit" = 0 ] && [ -n "$parent_hash" ] && grep -q "$parent_hash" "$sev" 2>/dev/null; } && smoke_hit=1
    if [ "$smoke_hit" = 1 ]; then b_smoke="PASS"
    else b_smoke="FAIL"; smoke_note="smoke evidence thiếu: docs/superpowers/evidence/$sf/smoke.txt (HEAD ${head_hash:-?})"; fi
  fi

  # B5 Linear Done
  [ "$lstate" = "Done" ] && b5="PASS" || b5="PENDING"

  # verdict tổng — B2b surface-lint FAIL được tính core (enforcer semantics)
  core_fail=$(printf '%s\n%s\n%s\n%s\n%s\n' "$b1" "$b2" "$b2b" "$b4" "$b_smoke" | grep -c '^FAIL')
  if   [ "$b5" = "PASS" ] && [ "$core_fail" -gt 0 ]; then verdict="VIOLATION"
  elif [ "$b5" = "PASS" ] && [ "$b3" = "FAIL" ]; then verdict="VIOLATION"
  elif [ "$core_fail" -gt 0 ] || [ "$b3" = "FAIL" ] || [ "$b3" = "OUTBOX" ]; then verdict="INCOMPLETE"
  elif [ "$b5" = "PASS" ]; then verdict="COMPLETE"
  else verdict="READY-TO-DONE"; fi
  detail="code:${code_commits}c tests:${test_files}f plan:${open_tasks} open review:${linear:-?} dest:${dest:-?}${lint_note:+ $lint_note}${b1_note:+ ⚠ $b1_note}${real_note:+ $real_note}${smoke_note:+ ⚠ $smoke_note}${b4_note:+ ⚠ $b4_note}${MM_ERR:+ ⚠ mindmap ${MM_ERR}}"

  echo "$sf|$verdict|$detail|$b1|$b2|$b2b|$b3|$b4|$b5|$b_smoke"
}

# ═══ MAIN ═══
# worktree → linked Linear issue + base branch (orca metadata — NGUỒN ĐÚNG khi
# repo chứa NHIỀU bracket của các story khác nhau. Bug 2/9 FI-246: glob bracket
# lấy file đầu alphabetically (fi233) → B3/B4/B5 đọc nhầm story cũ → VIOLATION ảo)
WT_META=$(orca worktree list --json 2>/dev/null | python3 -c "
import json, sys
try: wts = json.load(sys.stdin)['result']['worktrees']
except Exception: wts = []
by_id = {w.get('id'): w for w in wts}
for w in wts:
    p = (w.get('git') or {}).get('path') or w.get('path') or ''
    li = w.get('linkedLinearIssue') or ''
    br = w.get('baseRef') or ''
    pw = by_id.get((w.get('lineage') or {}).get('parentWorktreeId'))
    pb = ((pw or {}).get('git') or {}).get('branch') or ''
    if p: print(p + '|' + li + '|' + br + '|' + pb)
") || WT_META=""

# SF-2 remote-safe: distributed flag đọc 1 lần (zero-diff khi OFF — B4 không fetch)
DC_ON=$(dc_enabled_read); DC_ON=${DC_ON:-0}

WTS=()
# Why two globs: coordinators name SF worktrees `<story>-sf-<n>` (fi28-sf-1) —
# the legacy `sf-*` glob silently missed every real worktree on this layout.
for ws in "$HOME"/orca/workspaces/*/; do
  for wt in "$ws"sf-*/ "$ws"*-sf-*/; do
    [ -d "$wt" ] && git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 && WTS+=("${wt%/}")
  done
done
[ ${#WTS[@]} -eq 0 ] && { echo "Không có sf-* worktree nào."; exit 0; }
if [ -n "$SF_ARG" ]; then
  FILTERED=()
  for wt in "${WTS[@]}"; do case "$(basename "$wt")" in *"$SF_ARG"*) FILTERED+=("$wt");; esac; done
  [ ${#FILTERED[@]} -eq 0 ] && { echo "Không thấy worktree khớp: $SF_ARG"; exit 2; }
  WTS=("${FILTERED[@]}")
fi

ROWS=(); EXIT=0
for wt in "${WTS[@]}"; do ROWS+=("$(verify_sf "$wt")"); done

# ── story-level derive từ Linear (FI-458 SF-4): bracket×Linear là nguồn story —
# máy này thiếu worktree máy khác → local-only kết luận STORY-COMPLETE sai.
# Dual-path đọc (linear_meta: orca CLI trước, curl fallback). Per-issue không
# đọc được → warn-only (fail-open — stale bracket id không được block story);
# KHÔNG đọc được Linear (không orca/key) → warn + fallback local-only.
BR_SEEN=""; BR_LIST=""
LIN_TOTAL=0; LIN_DONE=0; LIN_OPEN=0; LIN_UNKNOWN=0; LIN_OPEN_IDS=""; DERIVE_ROWS=""
for wt in ${WTS[@]+"${WTS[@]}"}; do
  # mindmap khớp story ID của wt (canonical — cùng scoping resolve_mindmap như
  # verify_sf: mindmap story lạ trong worktree không thành derive rows chéo story);
  # 0/>1 match → wt không đóng góp mindmap (fail-open, worktree rows vẫn thay mặt)
  resolve_mindmap "$wt" "$(basename "$wt")"
  if [ -n "$MM_PICK" ]; then
    wbase=$(basename "$MM_PICK")
    case "$BR_SEEN" in *"|$wbase|"*) ;; *) BR_SEEN="$BR_SEEN|$wbase|"; BR_LIST="$BR_LIST$MM_PICK"$'\n' ;; esac
  fi
  for bf in "$wt"/docs/superpowers/brackets/*.md; do
    [ -f "$bf" ] || continue
    bbase=$(basename "$bf")   # dedupe basename — full-path chứa wt → 2 wt cùng story đếm nhân (review B P1)
    case "$BR_SEEN" in *"|$bbase|"*) continue ;; esac
    BR_SEEN="$BR_SEEN|$bbase|"
    BR_LIST="$BR_LIST$bf"$'\n'
  done
done
if [ -n "$BR_LIST" ]; then
  WTN=""  # worktree sống (basename) — SF còn wt sống thì B-rows của wt thay mặt
  for wt in ${WTS[@]+"${WTS[@]}"}; do WTN="$WTN|$(basename "$wt")"; done
  # linear_meta per-SF (N+1): orca CLI = keychain app (không rate-limit API);
  # batch chỉ đáng khi curl fallback — rào rate-limit đã ở watchdog batch.
  while IFS= read -r bf; do
    [ -n "$bf" ] || continue
    case "$bf" in
      *.wakii)
        # .wakii: SF rows từ nodes (kind sf, có linear) — python3 JSON parse
        SFROWS=$(python3 - "$bf" <<'PYVROWS'
import json, sys
try:
    doc = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    sys.exit(0)
for x in doc.get('nodes') or []:
    if isinstance(x, dict) and x.get('kind') == 'sf':
        i, lin = str(x.get('id') or ''), str(x.get('linear') or '')
        if lin and i.startswith('sf-') and i[3:].isdigit():
            print(i.upper() + '|' + lin)
PYVROWS
        ) ;;
      *) SFROWS=$(awk '
      function emit() { if (sf != "" && lin != "") print sf "|" lin }
      /^## / { if ($0 !~ /^## SF-/) { emit(); sf = ""; next }
               emit(); sf = $2; lin = ""; next }
      /^linear:/ && sf != "" { lin = $2 }
      END { emit() }' "$bf") ;;
    esac
    while IFS='|' read -r sfnum lin; do
      [ -n "$lin" ] || continue
      LIN_TOTAL=$((LIN_TOTAL+1))
      lmeta=$(linear_meta "$lin")
      lst=${lmeta%%|*}
      n=$(printf '%s' "$sfnum" | grep -oE '[0-9]+' | head -1)
      case "$WTN" in
        *"|sf-$n-"*|*"|sf-$n|") HASWT=1 ;;
        *) HASWT=0 ;;
      esac
      case "$lst" in
        Done)
          LIN_DONE=$((LIN_DONE+1))
          [ "$HASWT" = "0" ] && DERIVE_ROWS="${DERIVE_ROWS}  ✓ $sfnum Done theo Linear — worktree đã dọn [derive]"$'\n' ;;
        unknown|"")
          LIN_UNKNOWN=$((LIN_UNKNOWN+1)) ;;
        *)
          LIN_OPEN=$((LIN_OPEN+1)); LIN_OPEN_IDS="$LIN_OPEN_IDS $lin"
          DERIVE_ROWS="${DERIVE_ROWS}  ○ $sfnum ($lin) chưa Done [derive]"$'\n' ;;
      esac
    done <<< "$SFROWS"
  done <<< "$BR_LIST"
fi
LIN_READ=0
if [ "$LIN_DONE" -gt 0 ] || [ "$LIN_OPEN" -gt 0 ]; then LIN_READ=1; fi

if [ "$JSON_OUT" = 1 ]; then
  echo "["
  first=1
  for r in "${ROWS[@]}"; do
    IFS='|' read -r sf verdict detail b1 b2 b2b b3 b4 b5 b_smoke <<< "$r"
    [ $first = 0 ] && echo ","
    printf '  {"sf":"%s","verdict":"%s","steps":{"code_tests":"%s","plan_ticked":"%s","surface_lint":"%s","review":"%s","merged":"%s","linear_done":"%s","runtime_smoke":"%s"},"detail":"%s"}' \
      "$sf" "$verdict" "$b1" "$b2" "$b2b" "$b3" "$b4" "$b5" "$b_smoke" "$detail"
    first=0
  done
  echo ""
  echo "]"
else
  echo "═══ COMPLETE-RUN VERIFY ═══ (B1 code+tests · B2 plan · B2b surface-lint · B3 review · B4 merge · B5 Done)"
  for r in "${ROWS[@]}"; do
    IFS='|' read -r sf verdict detail b1 b2 b2b b3 b4 b5 b_smoke <<< "$r"
    icon="●"; case "$verdict" in VIOLATION) icon="🚨";; INCOMPLETE) icon="○";; COMPLETE) icon="✓";; READY-TO-DONE) icon="▶";; esac
    smoke_col=""; [ "$b_smoke" != "OFF" ] && smoke_col=" Smoke:$b_smoke"
    printf '  %s %-22s %-14s [B1:%s B2:%s B2b:%s B3:%s B4:%s B5:%s%s]\n' "$icon" "$sf" "$verdict" "$b1" "$b2" "$b2b" "$b3" "$b4" "$b5" "$smoke_col"
    printf '      %s\n' "$detail"
    [ -n "${OB_NOTE:-}" ] && printf '      ⚠ %s\n' "$OB_NOTE"; OB_NOTE=""
  done
  # story-level summary
  all_done=1; incomplete=0; violation=0
  for r in "${ROWS[@]}"; do
    v=$(echo "$r" | cut -d'|' -f2)
    case "$v" in
      COMPLETE) ;;
      VIOLATION) violation=1; all_done=0 ;;
      *) incomplete=1; all_done=0 ;;
    esac
  done
  # bracket×Linear fold (SF-4): per-SF rows + chặn khi còn SF chưa Done;
  # per-issue không đọc được → warn-only (fail-open). Nhánh warn CẤM chứa
  # substring "STORY-COMPLETE" — test assert điểm đó (chỉ verdict dương mới in).
  [ -n "$DERIVE_ROWS" ] && printf '%s' "$DERIVE_ROWS"
  if [ "$LIN_TOTAL" -gt 0 ] && [ "$LIN_READ" = 1 ]; then
    if [ "$LIN_OPEN" -gt 0 ]; then
      all_done=0
      echo "⚠ Linear derive:${LIN_OPEN_IDS# } chưa Done theo bracket/mindmap — story chưa hoàn thành."
    else
      echo "Linear derive: $LIN_DONE/$LIN_TOTAL SF Done theo bracket/mindmap."
    fi
    [ "$LIN_UNKNOWN" -gt 0 ] && echo "⚠ Linear derive: $LIN_UNKNOWN issue không đọc được — bỏ qua (fail-open)."
  elif [ "$LIN_TOTAL" -gt 0 ]; then
    echo "⚠ không đọc được Linear từ máy này (không orca/key, hoặc id không tồn tại) — story-level chỉ dựa worktree máy này."
  fi
  if [ "$all_done" = 1 ]; then
    echo "STORY-COMPLETE ✓ — mọi SF đủ 5 bước. User merge main được."
  elif [ "$violation" = 1 ]; then
    echo "🚨 VIOLATION — có SF Done nhưng thiếu bước trước. Xử lý trước mọi việc khác."
    EXIT=2
  else
    echo "Chưa hoàn thành — xem bước FAIL đầu tiên mỗi SF (thứ tự bước là thứ tự sửa)."
    EXIT=1
  fi
fi
exit $EXIT
