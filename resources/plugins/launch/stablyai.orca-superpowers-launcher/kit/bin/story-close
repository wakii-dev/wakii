#!/bin/bash
# story-close — chuẩn hoá CLOSE phase (học 20/09: CLOSE làm tay mỗi story một kiểu)
#
# Audit + dọn dẹp AN TOÀN sau khi mọi SF đã merge về nhánh đích:
#   1. Audit branch sf-*: đã merge vào dest chưa (chưa merge → BLOCK, không xoá)
#   2. Ownership probe: worktree còn worker live → BLOCK (dùng lib SF-3 LOCAL-1)
#   3. Cleanup: worktree remove + branch -D (CHỈ branch đã merge, tree sạch)
#   4. Next-steps: story-verify COMPLETE + Linear deferred + pr-playbook
#
# KHÔNG làm: merge hộ SF, story-verify thay, set Linear Done, push main — của user/worker.
# Fail-open: ownership probe hỏng/không có → bỏ check worker (không phán mù),
#            vẫn audit merge — an toàn hơn là chặn cả CLOSE vì probe chết.
#
# Usage: story-close <dest-branch> [--dry-run] [--json]
# Exit: 0 (sạch/đã dọn) · 1 (BLOCK — liệt kê) · 2 (usage)
set -u

DEST="${1:?Usage: story-close <dest-branch> [--dry-run] [--json]}"
DRY=0; JSON_OUT=0
shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --json) JSON_OUT=1 ;;
    *) echo "Unknown: $1"; exit 2 ;;
  esac
  shift
done

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "❌ không phải git repo"; exit 2; }
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── 1. Audit branch sf-* vs dest ─────────────────────────────────────────────
# Mỗi branch CLEAN kèm worktree path (rỗng nếu không có worktree).
CLEAN=(); CLEAN_WT=(); BLOCKED=()
while read -r br; do
  short="${br#wakii-dev/}"
  case "$short" in
    "$DEST"|main|master|wakii-main) continue ;;
  esac
  if git merge-base --is-ancestor "$br" "$DEST" 2>/dev/null; then
    wt=$(git worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$br" '
      /^worktree / { cur = substr($0, 10) }
      $0 == "branch " b { print cur; exit }')
    if [ -n "$wt" ]; then
      dirty=$(git -C "$wt" status --short 2>/dev/null | grep -cv "^??")
      if [ "$dirty" != "0" ]; then
        BLOCKED+=("$short — worktree dirty ($dirty files): $wt"); continue
      fi
      CLEAN+=("$short"); CLEAN_WT+=("$wt")
    else
      CLEAN+=("$short"); CLEAN_WT+=("")
    fi
  else
    n=$(git rev-list --count "$DEST..$br" 2>/dev/null)
    BLOCKED+=("$short — CHƯA merge ($n commits ngoài $DEST)")
  fi
done < <(git branch --format='%(refname:short)' 2>/dev/null | grep -E '(^|/)sf-[0-9]')

# ── 2. Ownership probe (lib SF-3 LOCAL-1): worktree có worker live → BLOCK ──
# Fail-open: probe hỏng → bỏ check worker (không phán mù), vẫn audit merge.
PROBE="$SELF_DIR/story-ownership-probe"
[ -f "$PROBE" ] || PROBE="$HOME/.claude/bin/story-ownership-probe"
PROBE_JSON=""
if [ -f "$PROBE" ] && [ ${#CLEAN_WT[@]} -gt 0 ]; then
  PROBE_JSON=$(cd "$ROOT" && "$PROBE" --json 2>/dev/null)
fi
if [ -n "$PROBE_JSON" ]; then
  i=0
  for wt in "${CLEAN_WT[@]}"; do
    if printf '%s' "$PROBE_JSON" | grep -qF "$wt"; then
      BLOCKED+=("$(basename "$wt") — worker live (ownership probe)")
      CLEAN_WT[$i]="__blocked__"
    fi
    i=$((i + 1))
  done
  # lọc các entry bị block ra khỏi CLEAN/CLEAN_WT (giữ cặp index khớp nhau)
  NEWCLEAN=(); NEWWT=()
  i=0
  for b in "${CLEAN[@]}"; do
    [ "${CLEAN_WT[$i]}" != "__blocked__" ] && NEWCLEAN+=("$b") && NEWWT+=("${CLEAN_WT[$i]}")
    i=$((i + 1))
  done
  CLEAN=("${NEWCLEAN[@]:-}"); CLEAN_WT=("${NEWWT[@]:-}")
fi

# ── 3. Verdict ───────────────────────────────────────────────────────────────
if [ ${#BLOCKED[@]} -gt 0 ]; then
  if [ "$JSON_OUT" = "1" ]; then
    printf '{"verdict":"BLOCKED","blocked":%s}\n' "${#BLOCKED[@]}"
  else
    echo "═══ STORY-CLOSE AUDIT: $DEST ═══"
    for b in ${CLEAN[@]+"${CLEAN[@]}"}; do echo "  ✓ merged: $b"; done
    for b in "${BLOCKED[@]}"; do echo "  ❌ BLOCK: $b"; done
    echo "🚫 CLOSE BLOCK — xử lý các mục BLOCK phía trên"
  fi
  exit 1
fi

# ── 4. Cleanup (chỉ branch đã merge + worktree sạch) ────────────────────────
CLOSED=0
if [ "$DRY" != "1" ]; then
  for wt in ${CLEAN_WT[@]+"${CLEAN_WT[@]}"}; do
    [ -n "$wt" ] && git worktree remove "$wt" --force >/dev/null 2>&1
  done
  for b in ${CLEAN[@]+"${CLEAN[@]}"}; do
    git branch -D "$b" >/dev/null 2>&1 && CLOSED=$((CLOSED + 1))
  done
fi

if [ "$JSON_OUT" = "1" ]; then
  printf '{"verdict":"OK","closed":%s,"dry_run":%s}\n' "$CLOSED" "$DRY"
else
  echo "═══ STORY-CLOSE AUDIT: $DEST ═══"
  for b in ${CLEAN[@]+"${CLEAN[@]}"}; do echo "  ✓ merged: $b"; done
  [ "$DRY" = "1" ] && echo "  (dry-run — không có gì bị xoá)"
  echo "✓ CLOSE xong: $CLOSED branch dọn. Next:"
  echo "  1. story-verify COMPLETE trên $DEST"
  echo "  2. Linear Done (deferred nếu local-first)"
  echo "  3. dest ──▶ main: của USER (pr-playbook)"
  echo "  story-hub cleanup (SAU khi PR merge): orca worktree rm story worktree + branch -d <dest> + push --delete"
fi
exit 0
