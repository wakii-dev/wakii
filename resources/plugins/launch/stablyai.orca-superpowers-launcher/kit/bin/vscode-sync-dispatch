#!/bin/bash
# vscode-sync-dispatch — điều phối sync feature VS Code, MỖI PASS 1 FEATURE.
# Mỗi feature chạy QUA STORY-WORKFLOW ĐẦY ĐỦ (epic + SF + coordinator pass) —
# bin này chỉ làm bookkeeping state machine trong backlog file:
#   docs/superpowers/vscode-sync/backlog.md
#
# State:  `- [ ]` chờ · `- [~]` scout đang tạo story (song song được) ·
#         `- [S]` staged chờ auto-launch · `- [x]` đã merged.
#
# next:
#   1. Reconcile: dòng [~] có epic id mà branch chứa epic-id ĐÃ merged vào
#      $VSCODE_SYNC_BASE (mặc định wakii-dev) → tự flip [x].
#   2. Còn [~] → exit 3 (story trước chưa xong — pass sau thử lại).
#   3. Lấy dòng [ ] ĐẦU TIÊN → flip [~] + ghi `<!-- dispatch: <ts> -->` →
#      in stdout `FEATURE <id>|<title>|<desc>` cho agent chạy story-workflow.
#   4. Hết [ ] → exit 3 (backlog trống).
# mark-done <epic-id> → flip dòng [~] chứa epic-id thành [x] (gọi sau khi
#   merge story vào wakii-dev).
# status → tổng quan 3 nhóm.
# Exit: next có feature 0 · noop 3 · mark-done ok 0 · lỗi 2.
#
# Env seams: VSCODE_SYNC_BACKLOG (path backlog), VSCODE_SYNC_BASE (branch đích).
set -u

cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" || exit 2
BACKLOG="${VSCODE_SYNC_BACKLOG:-docs/superpowers/vscode-sync/backlog.md}"
BASE_BRANCH="${VSCODE_SYNC_BASE:-wakii-dev}"

[ -f "$BACKLOG" ] || { echo "backlog không tồn tại: $BACKLOG" >&2; exit 2; }

CMD="${1:-status}"

# ---- helpers -------------------------------------------------------------
# rewrite_line <số-thứ-tự-dòng> <nội-dung-mới> — atomic replace 1 dòng
rewrite_line() {
  local n="$1" line="$2" tmp
  tmp="${BACKLOG}.tmp.$$"
  awk -v n="$n" -v line="$line" 'NR==n { print line; next } { print }' \
    "$BACKLOG" > "$tmp" && mv "$tmp" "$BACKLOG"
}

epic_merged() {
  # epic_merged <epic-id-lowercase> → 0 nếu branch chứa epic-id đã merged
  local epic="$1"
  git branch --merged "$BASE_BRANCH" 2>/dev/null | tr -d ' +*' | grep -qi "$epic"
}

# Đếm số dòng state (^[ ] ngoài code fence ``` — ví dụ format trong fence không
# được tính là feature). in_fence toggle ở mỗi dòng bắt đầu bằng ```
count_state() {
  local mark="$1" in_fence=0 count=0 line
  while IFS= read -r line; do
    case "$line" in '```'*) in_fence=$((1 - in_fence)); continue ;; esac
    if [ "$in_fence" -eq 0 ]; then
      case "$line" in "$mark"*) count=$((count + 1)) ;; esac
    fi
  done < "$BACKLOG"
  echo "$count"
}

# ---- reconcile: [~] đã merged → [x] (bỏ qua dòng trong code fence) --------
reconcile() {
  local n=1 line epic in_fence=0
  while IFS= read -r line; do
    case "$line" in '```'*) in_fence=$((1 - in_fence)); n=$((n + 1)); continue ;; esac
    if [ "$in_fence" -eq 0 ]; then
      case "$line" in
        '- [~]'*)
          epic="$(printf '%s' "$line" | grep -oE 'VSC-[0-9]+' | head -1 | tr 'A-Z' 'a-z')"
          if [ -n "$epic" ] && epic_merged "$epic"; then
            rewrite_line "$n" "$(printf '%s' "$line" | sed 's/^- \[~\]/- [x]/')"
            echo "reconcile: $epic đã merged vào $BASE_BRANCH → [x]" >&2
          fi
          ;;
      esac
    fi
    n=$((n + 1))
  done < "$BACKLOG"
}

case "$CMD" in
  next)
    reconcile
    # SERIAL (đúng ý owner): 1 story tại 1 thời điểm — tính từ claim đến khi
    # MERGED. [~] (scout đang tạo) lẫn [S] (staged chờ launch/merge) đều là
    # in-flight — chỉ claim feature mới khi hàng đã [x].
    if [ "$(count_state '- [~]')" -gt 0 ] || [ "$(count_state '- [S]')" -gt 0 ]; then
      echo "IN-FLIGHT: story trước chưa merged ([~]/[S]) — không dispatch thêm" >&2
      exit 3
    fi
    # claim dòng [ ] đầu tiên (ngoài code fence)
    n=1
    local_in_fence=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      if [ "$local_in_fence" -eq 0 ]; then
        case "$line" in
          '- [ ]'*'VSC-'*)
            id="$(printf '%s' "$line" | grep -oE 'VSC-[0-9]+' | head -1)"
            rest="$(printf '%s' "$line" | sed 's/^- \[ \] //' | sed 's/<!-- .*//')"
            title="$(printf '%s' "$rest" | cut -d'|' -f1 | sed 's/^[^:]*: *//;s/ — .*//')"
            desc="$(printf '%s' "$rest" | sed 's/^[^|]*| *//')"
            new_line="- [~] $(printf '%s' "$rest" | sed 's/ *$//') <!-- dispatch: $(date -u +%Y-%m-%dT%H:%M:%SZ) -->"
            rewrite_line "$n" "$new_line"
            echo "FEATURE ${id}|${title}|${desc}"
            exit 0
            ;;
        esac
      fi
      n=$((n + 1))
    done < "$BACKLOG"
    echo "EMPTY: không còn feature chờ trong backlog" >&2
    exit 3
    ;;
  board)
    # board — bảng quản lý tổng hợp cho chế độ SERIAL: 1 story đang chạy
    # (state, epic, worktree, PR, tuổi), hàng chờ, đã xong. Người + agent
    # cùng đọc từ backlog file — không phải mở app.
    reconcile
    echo "=== vscode-sync board (base=$BASE_BRANCH) ==="
    n=1
    local_in_fence=0
    creating="" ; waiting=0 ; done_count=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      [ "$local_in_fence" -eq 1 ] && { n=$((n + 1)); continue; }
      case "$line" in
        '- [~]'*)
          creating="$line"
          ;;
        '- [ ]'*'VSC-'*)
          waiting=$((waiting + 1))
          ;;
        '- [x]'*'VSC-'*)
          done_count=$((done_count + 1))
          ;;
      esac
      n=$((n + 1))
    done < "$BACKLOG"

    if [ -n "$creating" ]; then
      epic="$(printf '%s' "$creating" | grep -oE 'epic: *[A-Za-z]+-[0-9]+' | head -1 | sed 's/epic: *//')"
      pr="$(printf '%s' "$creating" | grep -oE 'pr: *#[0-9]+' | head -1 | sed 's/pr: *//')"
      ts="$(printf '%s' "$creating" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+' | head -1)"
      vsc="$(printf '%s' "$creating" | grep -oE 'VSC-[0-9]+' | head -1)"
      echo "▶ ĐANG CHẾ BIẾN: $creating"
      echo "    epic: ${epic:-chưa tạo} | PR: ${pr:-chưa có} | dispatch: ${ts:-?} UTC"
      if [ -n "$epic" ]; then
        match="$(git worktree list | grep -i "$(printf '%s' "$epic" | tr 'A-Z' 'a-z')" | head -1 | cut -d' ' -f1)"
        if [ -n "$match" ]; then echo "    worktree: $match"; else echo "    worktree: (không thấy worktree chứa $epic)"; fi
      fi
    fi
    # [S] staged — story đã tạo, đang trong vòng auto-launch/merge
    n=1
    local_in_fence=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      if [ "$local_in_fence" -eq 0 ]; then
        case "$line" in
          '- [S]'*'VSC-'*)
            epic_s="$(printf '%s' "$line" | grep -oE 'epic: *[A-Za-z]+-[0-9]+' | head -1 | sed 's/epic: *//')"
            echo "⏳ STAGED chờ launch/merge: $line"
            ;;
        esac
      fi
      n=$((n + 1))
    done < "$BACKLOG"
    if [ -z "$creating" ]; then
      echo "▶ Không story mới đang tạo — scout có thể claim feature kế tiếp khi hàng [S] Clear"
    fi
    echo "⏳ Hàng chờ: $waiting feature"
    echo "✔ Đã merged: $done_count story"
    exit 0
    ;;
  should-run)
    # precheck cho story-auto-launch: exit 0 CHỈ khi có việc — feature chờ
    # [ ] hoặc story in-flight [~] cần supervise. Không việc → exit 1.
    reconcile
    if [ "$(count_state '- [~]')" -gt 0 ] || [ "$(count_state '- [ ]')" -gt 0 ]; then
      exit 0
    fi
    exit 1
    ;;
  scout-should-run)
    # precheck cho vscode-feature-scout: exit 0 khi có feature chờ [ ] HOẶC
    # story [~] dang dở cần RESUME (agent thoát sớm giữa CREATE là thường —
    # skip [~] vĩnh viễn sẽ kẹt story). Không việc → exit 1.
    reconcile
    if [ "$(count_state '- [~]')" -gt 0 ] || [ "$(count_state '- [ ]')" -gt 0 ]; then
      exit 0
    fi
    exit 1
    ;;
  claim-pane)
    # in handle của terminal automation MỚI NHẤT (pane hiện tại của agent —
    # vừa được Orca spawn cho pass này). Match theo TẤT CẢ tên automation
    # vscode-sync family — hardcode 1 tên khiến pane protocol trượt khi đổi
    # tên automation (bug thật 30/9: pane rác tích tụ vì claim trượt).
    ORCA="${ORCA_BIN:-orca}"
    env -u ORCA_USER_DATA_PATH "$ORCA" terminal list --json 2>/dev/null | \
      python -c "import json,sys
d = json.load(sys.stdin)
terms = d.get('terminals') or d.get('result', {}).get('terminals') or []
pats = ('vscode-sync pass', 'story-auto-launch', 'vscode-feature-scout', 'vscode-sync supervisor')
mine = [t for t in terms if any(p in (t.get('title') or '') for p in pats)]
if mine:
    print(mine[-1]['handle'])
else:
    print('')" 2>/dev/null
    ;;
  cleanup-pane)
    # cleanup-pane <handle> — đóng terminal automation (cuối pass, mọi nhánh).
    # Close gọi từ chính pane đó: CLI báo app đóng; PTY bị kill sau khi lệnh
    # đã tới daemon nên exit code có thể mất — caller dùng `|| true`.
    handle="${2:-}"
    [ -n "$handle" ] || { echo "usage: cleanup-pane <handle>" >&2; exit 2; }
    ORCA="${ORCA_BIN:-orca}"
    env -u ORCA_USER_DATA_PATH "$ORCA" terminal close --terminal "$handle" >/dev/null 2>&1
    echo "pane $handle closed"
    ;;
  cleanup-stale)
    # đóng các terminal automation CŨ (title-match nhưng KHÔNG phải newest —
    # newest là pane hiện tại). Gọi ở ĐẦU pass để dọn pane chết sót từ lần
    # trước (run bị kill, agent quên close…).
    # Gom handles vào biến TRƯỚC khi loop: orca.cmd (batch) đọc stdin của
    # pipe → nuốt input của while nếu close chạy trong pipe loop (bug thật
    # 30/9: báo closed nhưng không pane nào bị đóng).
    ORCA="${ORCA_BIN:-orca}"
    stale_handles="$(env -u ORCA_USER_DATA_PATH "$ORCA" terminal list --json 2>/dev/null | \
      python -c "import json,sys
d = json.load(sys.stdin)
terms = d.get('terminals') or d.get('result', {}).get('terminals') or []
pats = ('vscode-sync pass', 'story-auto-launch', 'vscode-feature-scout', 'vscode-sync supervisor')
mine = [t['handle'] for t in terms if any(p in (t.get('title') or '') for p in pats)]
for h in mine[:-1]:
    print(h)" 2>/dev/null)"
    for h in $stale_handles; do
      [ -n "$h" ] || continue
      env -u ORCA_USER_DATA_PATH "$ORCA" terminal close --terminal "$h" >/dev/null 2>&1
      echo "stale pane closed: $h"
    done
    ;;

  add-feature)
    # add-feature "<tên> | <mô tả>" hoặc "<tên> :: <mô tả>" (form :: dành cho
    # caller qua PowerShell/cmd — ký tự | vỡ native argv). Đánh số VSC kế tiếp,
    # dedupe theo title (case-insensitive).
    payload="${2:-}"
    [ -n "$payload" ] || { echo "usage: add-feature \"<tên> | <mô tả>\"" >&2; exit 2; }
    case "$payload" in
      *' :: '*) title="${payload%% :: *}";;
      *) title="${payload%% | *}";;
    esac
    title="$(printf '%s' "$title" | sed 's/^ *//;s/ *$//')"
    [ -n "$title" ] || { echo "title rỗng" >&2; exit 2; }
    if grep -qiF -- "$title" "$BACKLOG"; then
      echo "DUPLICATE: '$title' đã có trong backlog — bỏ qua"
      exit 3
    fi
    maxn="$(grep -oE 'VSC-[0-9]+' "$BACKLOG" | grep -oE '[0-9]+' | sort -n | tail -1)"
    maxn="${maxn:-0}"
    id="$(printf 'VSC-%03d' $((maxn + 1)))"
    echo "- [ ] $id: $payload" >> "$BACKLOG"
    echo "ADDED $id: $title"
    ;;
  now)
    # fire vscode-feature-scout NGAY theo tên (không chờ cron)
    ORCA="${ORCA_BIN:-orca}"
    AUTO_ID="$(env -u ORCA_USER_DATA_PATH "$ORCA" automations list --json 2>/dev/null | \
      python -c "import json,sys
d = json.load(sys.stdin)
autos = d.get('automations') or d.get('result', {}).get('automations') or []
for a in autos:
    if a.get('name') == 'vscode-feature-scout':
        print(a['id']); break" 2>/dev/null)"
    [ -n "$AUTO_ID" ] || { echo "automation vscode-sync-pass chưa được cài" >&2; exit 2; }
    echo "firing vscode-sync-pass ($AUTO_ID)…"
    exec env -u ORCA_USER_DATA_PATH "$ORCA" automations run "$AUTO_ID"
    ;;
  annotate)
    # annotate <VSC-XXX> <text> — nối thông tin (epic/worktree) vào comment của
    # dòng [~] đang chạy, để backlog tự mô tả story sống ở đâu
    fid="${2:-}"; text="${3:-}"
    [ -n "$fid" ] && [ -n "$text" ] || { echo "usage: vscode-sync-dispatch annotate VSC-001 'epic: VSC-1 | wt: vsc-1-coord'" >&2; exit 2; }
    n=1
    local_in_fence=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      if [ "$local_in_fence" -eq 0 ]; then
        case "$line" in
          '- [~]'*)
            if printf '%s' "$line" | grep -qi "$fid"; then
              base="$(printf '%s' "$line" | sed 's/ *<!-- .*//')"
              rewrite_line "$n" "$base <!-- $text -->"
              echo "annotated: $fid ← $text"
              exit 0
            fi
            ;;
        esac
      fi
      n=$((n + 1))
    done < "$BACKLOG"
    echo "không thấy dòng [~] chứa $fid" >&2
    exit 2
    ;;
  mark-staged)
    # mark-staged <VSC-XXX> <epic-id> — scout tạo story xong: [~] → [S]
    # (story ĐÃ TẠO trên Linear, chờ story-auto-launch approve + launch).
    fid="${2:-}"; epic="${3:-}"
    [ -n "$fid" ] && [ -n "$epic" ] || { echo "usage: mark-staged VSC-001 FI-44" >&2; exit 2; }
    n=1
    local_in_fence=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      if [ "$local_in_fence" -eq 0 ]; then
        case "$line" in
          '- [~]'*)
            if printf '%s' "$line" | grep -qi "$fid"; then
              base="$(printf '%s' "$line" | sed 's/ *<!-- .*//' | sed 's/^- \[~\]/- [S]/')"
              rewrite_line "$n" "$base <!-- epic: $epic | staged: $(date -u +%Y-%m-%dT%H:%M:%SZ) -->"
              echo "mark-staged: $fid → [S] (epic $epic)"
              exit 0
            fi
            ;;
        esac
      fi
      n=$((n + 1))
    done < "$BACKLOG"
    echo "không thấy dòng [~] chứa $fid" >&2
    exit 2
    ;;
  mark-done)
    epic_id="${2:-}"
    [ -n "$epic_id" ] || { echo "usage: vscode-sync-dispatch mark-done VSC-001" >&2; exit 2; }
    n=1
    local_in_fence=0
    while IFS= read -r line; do
      case "$line" in '```'*) local_in_fence=$((1 - local_in_fence)); n=$((n + 1)); continue ;; esac
      if [ "$local_in_fence" -eq 0 ]; then
        case "$line" in
          '- [~]'*|'- [S]'*)
            if printf '%s' "$line" | grep -qi "$epic_id"; then
              rewrite_line "$n" "$(printf '%s' "$line" | sed 's/^- \[\(~\|S\)\]/- [x]/')"
              echo "mark-done: $epic_id → [x]"
              # CHUYỀN DÂY: story xong → fire scout tạo story kế tiếp NGAY
              # (không chờ cron hourly) — chỉ khi còn [ ] chờ trong backlog.
              if [ "$(count_state '- [ ]')" -gt 0 ]; then
                ORCA="${ORCA_BIN:-orca}"
                AUTO_ID="$(env -u ORCA_USER_DATA_PATH "$ORCA" automations list --json 2>/dev/null | \
                  python -c "import json,sys
d = json.load(sys.stdin)
autos = d.get('automations') or d.get('result', {}).get('automations') or []
for a in autos:
    if a.get('name') == 'vscode-feature-scout':
        print(a['id']); break" 2>/dev/null)"
                if [ -n "$AUTO_ID" ]; then
                  echo "firing scout ($AUTO_ID) tạo story kế tiếp…"
                  env -u ORCA_USER_DATA_PATH "$ORCA" automations run "$AUTO_ID" >/dev/null 2>&1 &
                fi
              fi
              exit 0
            fi
            ;;
        esac
      fi
      n=$((n + 1))
    done < "$BACKLOG"
    echo "không thấy dòng [~] chứa $epic_id" >&2
    exit 2
    ;;
  status)
    echo "=== vscode-sync backlog ($BACKLOG, base=$BASE_BRANCH) ==="
    echo "chờ scout:       $(count_state '- [ ]')"
    echo "scout đang tạo:  $(count_state '- [~]')"
    echo "story chờ launch: $(count_state '- [S]')"
    echo "đã merged:       $(count_state '- [x]')"
    exit 0
    ;;
  *)
    echo "usage: vscode-sync-dispatch [next|now|should-run|claim-pane|cleanup-pane <handle>|cleanup-stale|annotate <VSC-XXX> <text>|mark-staged <VSC-XXX> <epic>|mark-done <VSC-XXX>|add-feature \"<tên> | <mô tả>\"|status]" >&2
    exit 2
    ;;
esac
