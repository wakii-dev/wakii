#!/bin/bash
# story-notify — thông minh: có context, có screenshot, có đề xuất
# Usage: story-notify <type> <sf> [detail]
# Types: stall | complete | gate-fail | gap | story-complete
set -u
TYPE="${1:?}"; SF="${2:-}"; DETAIL="${3:-}"

case "$TYPE" in
  stall)
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"' -e 'end run' -- "⚠ Agent Stall" "${SF} stall ${DETAIL} — watchdog sẽ tự resume"
    ;;
  complete)
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"' -e 'end run' -- "✓ SF Complete" "${SF} hoàn thành 5/5 — có thể launch tier kế"
    ;;
  gate-fail)
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"' -e 'end run' -- "🚨 Gate FAIL" "${SF}: ${DETAIL} — KHÔNG ĐƯỢC nói 'xong'"
    ;;
  gap)
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Ping"' -e 'end run' -- "⚠ REQUIREMENT-GAP" "Câu hỏi cần bạn trả lời: ${DETAIL}"
    ;;
  story-complete)
    osascript -e "display notification \"Story hoàn thành! Merge main khi sẵn sàng\" with title \"🏁 STORY-COMPLETE\" sound name \"Hero\""
    ;;
  *)
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' -- "$SF" "$DETAIL"
    ;;
esac
