#!/bin/bash
# story-test — RULE 0 ENFORCER: tự mở browser, đi flow, verify hoạt động
# Agents PHẢI chạy tool này PASS trước khi được tick Done.
#
# Usage: story-test <url> [--login user:pass] [--flow screen1,screen2]
# Exit: 0 = PASS (tôi đã thấy nó hoạt động) · 1 = FAIL (KHÔNG nói "xong")
set -u

URL="${1:?usage: story-test <url> [--login user:pass] [--flow screens]}"
LOGIN=""; FLOW=""
shift
while [ $# -gt 0 ]; do
  case "$1" in
    --login) LOGIN="$2"; shift 2 ;;
    --flow) FLOW="$2"; shift 2 ;;
    *) shift ;;
  esac
done

ORCA_BIN="${ORCA_BIN:-/opt/homebrew/bin/orca}"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Orca.app/Contents/Resources/bin/orca"
ORCA_DEV="$HOME/Library/Application Support/orca-dev"
export ORCA_USER_DATA_PATH="$ORCA_DEV"

FAIL=0
echo "═══ RULE 0: BROWSER TEST ═══"

# 1. MỞ TAB MỚI SẠCH
"$ORCA_BIN" tab close 2>/dev/null; sleep 1
"$ORCA_BIN" tab create --url "$URL" --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get('ok') else 1)" 2>/dev/null || { echo "❌ FAIL: không mở được tab"; exit 1; }
sleep 5

# 2. CONSOLE ERRORS
"$ORCA_BIN" eval --expression "window.__consoleErrors?.length || 0" 2>/dev/null | grep -q "^0$" && echo "✓ Console sạch" || {
  ERRS=$("$ORCA_BIN" eval --expression "window.__consoleErrors?.length || 'unknown'" 2>/dev/null | tail -1)
  echo "❌ Console errors: $ERRS"; FAIL=1
}

# 3. LOGIN (nếu --login)
if [ -n "$LOGIN" ]; then
  U="${LOGIN%%:*}"; P="${LOGIN#*:}"
  "$ORCA_BIN" eval --expression "
    (() => {
      const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
      const [u, p] = document.querySelectorAll('input');
      if (!u || !p) return 'no inputs';
      set.call(u, '$U'); u.dispatchEvent(new Event('input', {bubbles:true}));
      set.call(p, '$P'); p.dispatchEvent(new Event('input', {bubbles:true}));
      document.querySelector('form button')?.click();
      return 'submitted';
    })()
  " 2>/dev/null | tail -1
  sleep 6

  # OTP step?
  OTP=$("$ORCA_BIN" eval --expression "document.body.innerText.match(/(\\d{6})/)?.[1] || ''" 2>/dev/null | grep -oE '[0-9]{6}' | head -1)
  if [ -n "$OTP" ]; then
    echo "  OTP: $OTP"
    "$ORCA_BIN" eval --expression "
      (() => {
        const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
        const inp = document.querySelector('input[type=text]');
        if (inp) {
          set.call(inp, '$OTP'); inp.dispatchEvent(new Event('input', {bubbles:true}));
          document.querySelectorAll('button').forEach(b => {
            if (b.textContent.includes('Xác nhận') || b.textContent.includes('Confirm')) b.click();
          });
          return 'confirmed';
        }
        return 'no otp';
      })()
    " 2>/dev/null | tail -1
    sleep 8
    # Change password (first login)?
    H=$("$ORCA_BIN" eval --expression "document.querySelector('h1,h2')?.textContent || ''" 2>/dev/null)
    if echo "$H" | grep -qi "Đổi mật khẩu\|Change"; then
      PWS=($("$ORCA_BIN" eval --expression "document.querySelectorAll('input[type=password]').length" 2>/dev/null | tail -1))
      "$ORCA_BIN" eval --expression "
        (() => {
          const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
          const inputs = document.querySelectorAll('input[type=password]');
          if (inputs.length >= 3) {
            set.call(inputs[0], '$P'); inputs[0].dispatchEvent(new Event('input', {bubbles:true}));
            set.call(inputs[1], 'Test@2026x'); inputs[1].dispatchEvent(new Event('input', {bubbles:true}));
            set.call(inputs[2], 'Test@2026x'); inputs[2].dispatchEvent(new Event('input', {bubbles:true}));
            [...document.querySelectorAll('button')].find(b => b.textContent.includes('Đổi mật khẩu') || b.type === 'submit')?.click();
            return 'password changed';
          }
          return 'no change pw';
        })()
      " 2>/dev/null | tail -1
      sleep 8
    fi
  fi

  # VERIFY: navigate khỏi login?
  H=$("$ORCA_BIN" eval --expression "document.querySelector('h1,h2')?.textContent || 'EMPTY'" 2>/dev/null)
  if echo "$H" | grep -qi "đăng nhập\|login\|EMPTY"; then
    echo "❌ FAIL: vẫn ở màn login (auth không navigate)"; FAIL=1
  else
    echo "✓ Login navigate → $H"
  fi
fi

# 4. ĐI QUA TỪNG SCREEN
if [ -n "$FLOW" ]; then
  for SCREEN in $(echo "$FLOW" | tr ',' ' '); do
    "$ORCA_BIN" eval --expression "location.hash = '#/$SCREEN'" 2>/dev/null | head -1
    sleep 3
    H=$("$ORCA_BIN" eval --expression "document.querySelector('h1,h2')?.textContent || 'EMPTY'" 2>/dev/null)
    if [ "$H" = "EMPTY" ] || [ -z "$H" ]; then
      echo "❌ FAIL: #$SCREEN — không có heading"; FAIL=1
    else
      echo "✓ #$SCREEN → $H"
    fi
  done
fi

# 5. SCREENSHOT (audit trail)
"$ORCA_BIN" screenshot --format png --json 2>/dev/null | python3 -c "
import json,sys,base64
try:
    d=json.load(sys.stdin)
    open('/tmp/story-test-final.png','wb').write(base64.b64decode(d['result']['data']))
    print('✓ Screenshot: /tmp/story-test-final.png')
except: print('⚠ Screenshot fail (không chặn)')
" 2>/dev/null

# KẾT QUẢ
echo ""
if [ "$FAIL" = "1" ]; then
  echo "🚨 RULE 0 FAIL — KHÔNG ĐƯỢC nói 'xong'. Fix lỗi trên."
  exit 1
else
  echo "✓ RULE 0 PASS — tôi đã thấy nó hoạt động."
  exit 0
fi
