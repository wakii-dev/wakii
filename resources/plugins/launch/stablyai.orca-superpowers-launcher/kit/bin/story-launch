#!/bin/bash
# story-launch — NGUỒN DUY NHẤT dựng SF launch prompt + tạo worktree.
# PM / watchdog --launch-next / panel đều gọi tool này — hết nhân bản template
# 3 chỗ (bài học 2026-08-28: gate 4b phải sửa 2 chỗ, launch tay viết lần 3).
#
# Usage:
#   story-launch SF-2 [--repo <path>] [--dry-run]      # tự tìm nguồn: mindmaps/*.wakii trước, brackets/*.md fallback
#   story-launch --sf SF-2 --bracket <file> [--dry-run] # caller đã có context (legacy)
#   story-launch --sf SF-2 --wakii <file.wakii> [--dry-run]
# Validate: đã approve (có linear) · chưa Done · chưa có worktree · deps Done.
set -u

ORCA_BIN="${ORCA_BIN:-}"
[ -x "$ORCA_BIN" ] || ORCA_BIN="$(command -v orca 2>/dev/null)"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/opt/homebrew/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/usr/local/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Wakii.app/Contents/Resources/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Orca.app/Contents/Resources/bin/orca"
ORCA_DEV="$HOME/Library/Application Support/orca-dev"
ORCA_PROD="$HOME/Library/Application Support/orca"
orca() {
  ORCA_USER_DATA_PATH="$ORCA_DEV" "$ORCA_BIN" "$@" 2>/dev/null \
    || ORCA_USER_DATA_PATH="$ORCA_PROD" "$ORCA_BIN" "$@" 2>/dev/null || return 1
}

linear_state() { # $1 issue-id → state name ("" nếu không biết) — retry 1 lần
  # Dual-path (học story-verify): orca CLI trước (keychain), curl+key fallback
  local out
  out=$("$ORCA_BIN" linear issue "$1" --json 2>/dev/null | python3 -c "
import json, sys
try: print(json.load(sys.stdin)['result']['issue']['state']['name'])
except Exception: print('')" 2>/dev/null)
  [ -n "$out" ] && { echo "$out"; return; }
  local key="${LINEAR_API_KEY:-}"
  if [ -z "$key" ] && [ -f "$HOME/.claude/.linear-key" ]; then
    key=$(head -1 "$HOME/.claude/.linear-key" | tr -d '[:space:]')
  fi
  [ -z "$key" ] && { echo ""; return; }
  local st i
  # endpoint honor env — mock test/C3 offline (mặc định giữ nguyên prod)
  local ep="${LINEAR_GRAPHQL_ENDPOINT:-https://api.linear.app/graphql}"
  for i in 1 2; do
    st=$(curl -s -m 10 -X POST "$ep" \
      -H "Authorization: $key" -H "Content-Type: application/json" \
      -d "{\"query\":\"query{issue(id:\\\"$1\\\"){state{name}}}\"}" 2>/dev/null \
      | python3 -c "import json,sys
try: print(json.load(sys.stdin)['data']['issue']['state']['name'])
except: print('')" 2>/dev/null)
    [ -n "$st" ] && { echo "$st"; return; }
    sleep 1
  done
  echo ""
}

dest_fetch_check() { # $1 repo $2 dest — fetch + timeout + stderr capture; rc = git rc
  DEST_REMOTE="$(git -C "$1" config "branch.$2.remote" 2>/dev/null)"
  [ -n "$DEST_REMOTE" ] || DEST_REMOTE=origin
  local fc # HTTPS treo câm → low-speed env fail sau 30s (timeout cmd chỉ có Linux)
  fc=(git -C "$1" fetch "$DEST_REMOTE" "$2")
  command -v timeout >/dev/null 2>&1 && fc=(timeout 60 "${fc[@]}")
  FERR=$(GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 "${fc[@]}" 2>&1 1>/dev/null)
}

SF_ARG=""; BRACKET=""; WAKII=""; REPO_ARG=""; DRY_RUN=0
CLAIM=0; CLAIM_MACHINE_ID=""; HOST_ID=""  # distributed flags (SF-1: nhận + resolve)
GUARD_EXPECT=""; DEST_SHA=""  # C1 git-guard: tip SF branch remote (takeover) + tip dest vừa fetch
LIST_CLAIMS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --sf) SF_ARG="$2"; shift ;;
    --bracket) BRACKET="$2"; shift ;;
    --wakii) WAKII="$2"; shift ;;
    --repo) REPO_ARG="$2"; shift ;;
    --dry-run) DRY_RUN=1 ;;
    --claim) CLAIM=1 ;;
    --local) LOCAL_STORY=1 ;;
    --machine-id) CLAIM_MACHINE_ID="$2"; shift ;;
    --host) HOST_ID="$2"; shift ;;
    --list-claims) LIST_CLAIMS=1 ;;
    *) SF_ARG="$1" ;;
  esac
  shift
done

DCLIB="$(dirname "$0")/story-distributed-claim"
# ── --list-claims: read-only JSON mọi SF của bracket (SF-3 panel) — không cần enabled
if [ "$LIST_CLAIMS" = 1 ]; then
  [ -f "$DCLIB" ] || { echo "distributed: thiếu thư viện $DCLIB"; exit 1; }
  [ -f "$BRACKET" ] || { echo "--list-claims cần --bracket <file> tồn tại"; exit 2; }
  source "$DCLIB"
  if claim_list_all "$BRACKET"; then exit 0; fi
  echo "distributed: list-claims đọc thất bại (endpoint/key)" >&2
  exit 1
fi

[ -n "$SF_ARG" ] || { echo "usage: story-launch SF-N [--repo <path>] [--dry-run]"; exit 2; }
SF_NUM=$(echo "$SF_ARG" | grep -oE 'SF-[0-9]+' || echo "$SF_ARG" | grep -oE 'sf-[0-9]+' | tr 'a-z' 'A-Z')
[ -n "$SF_NUM" ] || { echo "không hiểu SF: $SF_ARG"; exit 2; }
N=$(echo "$SF_NUM" | cut -d- -f2)

# ── distributed claim: chỉ load lib khi --claim — disabled = 0 call mới (zero-diff)
if [ "$CLAIM" = 1 ]; then
  [ -f "$DCLIB" ] || { echo "distributed: thiếu thư viện $DCLIB"; exit 1; }
  source "$DCLIB"
  distributed_config_load
fi

# ── tìm nguồn story: mindmaps/*.wakii TRƯỚC (canonical VU-14), brackets/*.md
# fallback cho story CHƯA migrate (không ép migrate giữa run — VI-1)
if [ -z "$BRACKET" ] && [ -z "$WAKII" ]; then
  roots=()
  rl=$(orca repo list --json 2>/dev/null | python3 -c "
import json,sys
try:
    for r in json.load(sys.stdin).get('result',{}).get('repos',[]):
        if r.get('path'): print(r['path'])
except: pass" 2>/dev/null)
  while IFS= read -r p; do [ -n "$p" ] && roots+=("$p"); done <<< "$rl"
  for p in "$HOME"/orca/projects/*; do [ -d "$p" ] && roots+=("$p"); done
  [ -n "$REPO_ARG" ] && roots=("$REPO_ARG" "${roots[@]}")
  for repo in "${roots[@]}"; do
    for wf in "$repo"/docs/superpowers/mindmaps/*.wakii; do
      [ -f "$wf" ] || continue
      if grep -q "\"sf-$N\"" "$wf" 2>/dev/null; then WAKII="$wf"; REPO="${repo%/}"; break 2; fi
    done
    for bf in "$repo"/docs/superpowers/brackets/*.md; do
      [ -f "$bf" ] || continue
      if grep -q "^## ${SF_NUM}[ :]" "$bf" 2>/dev/null; then BRACKET="$bf"; REPO="${repo%/}"; break 2; fi
    done
  done
else
  REPO="${REPO_ARG:-$(dirname "$(dirname "$(dirname "$(dirname "${WAKII:-$BRACKET}")")")")}"
fi
if [ -n "$WAKII" ]; then
  [ -f "$WAKII" ] || { echo "không tìm thấy mindmap: $WAKII"; exit 2; }
elif [ -f "$BRACKET" ]; then
  : # legacy nguồn
else
  echo "không tìm thấy mindmap/bracket chứa $SF_NUM"; exit 2
fi
SRC_FILE="${WAKII:-$BRACKET}"
REPOB=$(basename "$REPO")

# ── parse SF section — .wakii qua python3 (bash không parse JSON), bracket giữ awk
DEPMAP=""
if [ -n "$WAKII" ]; then
  PARSED=$(python3 - "$WAKII" "$N" <<'PYWAKII'
import json, sys
path, n = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding='utf-8') as f:
        doc = json.load(f)
except Exception as e:
    sys.stderr.write(f'wakii khong doc duoc: {e}\n'); sys.exit(2)
nodes = [x for x in (doc.get('nodes') or []) if isinstance(x, dict)]
edges = [x for x in (doc.get('edges') or []) if isinstance(x, dict)]
meta = doc.get('meta') or {}
sf = next((x for x in nodes if x.get('kind') == 'sf' and x.get('id') == f'sf-{n}'), None)
if not sf:
    sys.stderr.write(f'khong co node sf-{n}\n'); sys.exit(2)
title = str(sf.get('title') or '').replace('|', '/')
linear = str(sf.get('linear') or '')
deps, depmap = [], []
for e in edges:
    if e.get('rel') != 'depends-on' or e.get('from') != sf.get('id'):
        continue
    to = str(e.get('to') or '')
    m = to[3:] if to.startswith('sf-') else ''
    if not m.isdigit():
        continue
    deps.append('SF-' + m)
    dep = next((str(x.get('linear') or '') for x in nodes if x.get('id') == to), '')
    depmap.append(f'SF-{m}={dep}')
dest = str(meta.get('dest') or '')
wtmodel = str(meta.get('worktreeModel') or '')
epic = str(meta.get('epic') or (str(meta.get('story') or '').split(' ')[0]))
sys.stdout.write('|'.join([title, linear, ','.join(deps), dest, wtmodel, epic, ','.join(depmap)]))
PYWAKII
  ) || { echo "$SF_NUM — mindmap không đọc được"; exit 2; }
  IFS='|' read -r TITLE LINEAR DEPS DEST WTMODEL EPIC DEPMAP <<< "$PARSED"
else
  IFS='|' read -r TITLE LINEAR DEPS << EOF
$(awk -v sfx="$SF_NUM" '
  $0 ~ "^## " sfx "([ :]|$)" { in_sf = 1; t = $0; sub(/^## SF-[0-9]+ +/, "", t); title = t; next }
  /^## / { in_sf = 0 }
  in_sf && /^linear:/ { linear = $2 }
  in_sf && /^Depends on:/ { sub(/^Depends on: */, ""); deps = $0 }
  END { print title "|" linear "|" deps }' "$BRACKET")
EOF
  DEST=$(grep -m1 '^Destination:' "$BRACKET" | sed 's/Destination: *//;s/ *$//')
  WTMODEL=$(grep -m1 '^Worktree model:' "$BRACKET" | sed 's/Worktree model: *//;s/ *$//')
  EPIC=$(grep -m1 '^# Story:' "$BRACKET" | sed 's/# Story: *//;s/ *—.*//;s/ *- .*//')
fi
# --local (04/10): story KHÔNG Linear — gate Linear tắt, distributed claim tắt
# (claim lưu trên Linear), Done-check bỏ (idempotency qua worktree-exists),
# worker báo Done qua evidence + worktree comment. Flow còn lại nguyên vẹn.
if [ "${LOCAL_STORY:-0}" = "1" ]; then
  CLAIM=0
  LIN_LABEL="LOCAL (không Linear — Done = evidence + story-verify sạch, báo qua worktree comment)"
else
  LIN_LABEL="$LINEAR"
fi
[ -n "$LINEAR" ] || [ "${LOCAL_STORY:-0}" = "1" ] || { echo "$SF_NUM chưa approve (không có linear ID) — không thuộc quyền launch; story không Linear dùng --local"; exit 1; }

# ── resolve machineId claim: flag --machine-id thắng config; --host chỉ lưu
# phiên (persist qua panel SF-3 — không tự ghi config)
CLAIM_MID=""
if [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ]; then
  [ -n "$CLAIM_MACHINE_ID" ] || CLAIM_MACHINE_ID="$(distributed_config_get machineId)"
  CLAIM_MACHINE_ID="$(sanitize_machine_id "$CLAIM_MACHINE_ID")"  # guard GraphQL interpolation
  CLAIM_MID="$CLAIM_MACHINE_ID"
  [ -n "$HOST_ID" ] && echo "distributed: --host=$(sanitize_machine_id "$HOST_ID") chỉ lưu trong phiên — persist qua panel SF-3 (distributed.hostId trong story-kit.json)" >&2
  [ "$DRY_RUN" = 1 ] && echo "── distributed claim: machine=$CLAIM_MID ttl=$(distributed_config_get claimTtlMinutes)min ($LINEAR)"
fi

# ── validate
if [ "${LOCAL_STORY:-0}" != "1" ]; then
  ST=$(linear_state "$LINEAR")
  [ "$ST" = "Done" ] && { echo "$SF_NUM ($LINEAR) đã Done — không launch lại"; exit 0; }
fi
WT=$(ls -d "$HOME"/orca/workspaces/"$REPOB"/sf-"$N"-* 2>/dev/null | head -1)
# ── pre-dispatch ownership: (SF-3 LOCAL-1) worker live trong SF worktree qua
# run/worker-list + (LOCAL-4 SF-1) 2 vùng mù đêm 03/10 — agent cwd-trên-primary
# + agent ngoài orchestration (spawn tay). Probe/scan hỏng → fail-open (không
# chặn mù). KHÔNG kill — chỉ chặn + in bằng chứng, người xử lý tay.
OPLIB="$(dirname "$0")/story-ownership-probe"
[ -f "$OPLIB" ] || OPLIB="$HOME/.claude/bin/story-ownership-probe"
if [ -f "$OPLIB" ]; then
  # shellcheck disable=SC1091
  . "$OPLIB"
  if ownership_probe_load; then
    # vùng mù 03/10: process agent ngoài tầm run/worker-list → chặn kèm pid+cwd
    phits="$(OP_PRIMARY="$REPO" OP_WT_PATHS="$WT" ownership_probe_process_hits)"
    if [ -n "$phits" ]; then
      echo "⛔ BLOCKED: $SF_NUM — còn agent live ngoài tầm ownership-probe (process-scan):"
      while IFS='|' read -r ph_pid ph_zone ph_cwd ph_comm; do
        [ -n "$ph_pid" ] || continue
        echo "  pid=$ph_pid zone=$ph_zone cwd=$ph_cwd comm=${ph_comm:-?}"
      done <<< "$phits"
      echo "probe KHÔNG kill — xác nhận process rồi xử lý tay, launch lại sau"
      exit 1
    fi
    if [ -n "$WT" ]; then
      # SF-3 pre-dispatch: worktree có worker live của coordinator khác → CHẶN
      # (bài học collision 19/09 — 2 coordinator cùng đụng SF-4).
      # parent-dir scope — basename trùng giữa 2 repo không được block nhầm
      wtrun="$(ownership_probe_worktree_owner "$(basename "$WT")" "$(dirname "$WT")")"
      wtrun2="$(ownership_probe_worktree_owner "$WT" "$(dirname "$WT")")"
      [ -n "$wtrun2" ] && wtrun="$wtrun2"
      wowner="$(printf '%s' "$wtrun" | cut -f2)"
      wrun="$(printf '%s' "$wtrun" | cut -f1)"
      wself="$(ownership_probe_self)"
      if [ -n "$wtrun" ] && { [ -z "$wself" ] || [ "$wowner" != "$wself" ]; }; then
        echo "⛔ BLOCKED: $SF_NUM foreign-owned — worktree $(basename "$WT") đang có worker live của coordinator ${wowner:-?} (run ${wrun:-?}) — KHÔNG dispatch"
        exit 1
      fi
      echo "$SF_NUM đã có worktree: $(basename "$WT")"; exit 0
    fi
  else
    echo "ownership-probe: đọc không được — không chặn được (degrade)" >&2
    if [ -n "$WT" ]; then echo "$SF_NUM đã có worktree: $(basename "$WT")"; exit 0; fi
  fi
elif [ -n "$WT" ]; then
  echo "$SF_NUM đã có worktree: $(basename "$WT")"; exit 0
fi
for d in $(echo "$DEPS" | tr ',' ' '); do
  d=$(echo "$d" | tr -d ' ')
  echo "$d" | grep -q '^SF-' || continue
  dn=$(echo "$d" | sed 's/SF-//')
  if [ -n "$WAKII" ]; then
    depid=$(printf '%s' "$DEPMAP" | tr ',' '\n' | grep "^${d}=" | head -1 | cut -d= -f2)
  else
    depid=$(awk -v dn="SF-$dn" '
      $0 ~ "^## " dn "([ :]|$)" { in_sf = 1; next }
      /^## / { in_sf = 0 }
      in_sf && /^linear:/ { gsub(/.*linear: /,""); print; exit }' "$BRACKET")
  fi
  [ -n "$depid" ] || { echo "chờ: dep $d chưa có linear ID"; exit 1; }
  dst=$(linear_state "$depid")
  [ "$dst" = "Done" ] || { echo "chờ: dep $d = $depid ($dst)"; exit 1; }
done

# ── prompt CHUẨN (nguồn duy nhất — mọi caller dùng bản này)
BFILE=$(basename "$SRC_FILE")
if [ -n "$WAKII" ]; then SRC_REL="docs/superpowers/mindmaps/$BFILE"; else SRC_REL="docs/superpowers/brackets/$BFILE"; fi
# slug: chỉ giữ từ ASCII ≥3 chữ (tiếng Việt strip hết dash-xấu — bài học
# 'sf-5-print-convergence-v-n-n-bi-n-b'), fallback gọn
SLUG=$(echo "$TITLE" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/ /g' \
  | tr ' ' '\n' | awk 'length($0)>=3' | head -3 | paste -sd- - | cut -c1-30)
[ -n "$SLUG" ] || SLUG="sf-$N-convergence"
STORY_DIR=${BFILE%.*}
BRACKET_PREFIX=$(echo "${BFILE%.*}" | cut -d- -f1 | tr 'A-Z' 'a-z')
PACK="docs/superpowers/contexts/sf-$N.md"
for cand in "docs/superpowers/contexts/${BRACKET_PREFIX}-sf-$N.md" "docs/superpowers/contexts/$STORY_DIR/sf-$N.md"; do
  [ -f "$cand" ] && { PACK="$cand"; break; }
done
# Worktree model quyết định phần cuối protocol executor (spec story-worktree-hub):
# story-hub → executor KHÔNG merge — commit + push sf-branch rồi DONE, coordinator
# merge trong story worktree (merge-playbook); legacy/không model → merge-ngược như cũ.
if [ "$WTMODEL" = "story-hub" ]; then
  HARDLIMIT="GIỚI HẠN CỨNG: KHÔNG merge/ff vào $DEST — coordinator merge trong story worktree; TUYỆT ĐỐI KHÔNG đụng primary/main (main là gate của USER)."
  CHECK5="CHECK 5 COMMIT + PUSH nhánh sf-$N-$SLUG (git push -u origin sf-$N-$SLUG) + chạy ~/.claude/bin/story-verify sf-$N-$SLUG — sạch mới tiếp. KHÔNG merge, KHÔNG đụng $DEST."
  CHECK6="CHECK 6 DONE — CHỈ sau CHECK 5: report DONE. Cleanup: chỉ xoá worktree mình — GIỮ nhánh sf trên remote (coordinator merge từ đó), TUYỆT ĐỐI KHÔNG xoá $DEST."
  DONE_RULE="Linear Done do coordinator set sau khi merge sf-branch vào $DEST — KHÔNG tự set Done."
else
  HARDLIMIT="GIỚI HẠN CỨNG: merge/ff CHỈ trong $DEST — TUYỆT ĐỐI KHÔNG đụng main (main là gate của USER)."
  CHECK5="CHECK 5 MERGE vào $DEST (merge-ngược + ancestor-guard) + audit comment merge-hash + chạy ~/.claude/bin/story-verify sf-$N-$SLUG — sạch mới tiếp."
  CHECK6="CHECK 6 DONE — CHỈ sau CHECK 5. Cleanup: chỉ xoá worktree + NHÁNH SF mình — TUYỆT ĐỐI KHÔNG xoá $DEST (nhánh đích giữ làm audit)."
  DONE_RULE="Done TRƯỚC merge = INCOMPLETE."
fi
PROMPT="Use orca-superpowers-workflow skill for ONE sub-feature: $TITLE ($LIN_LABEL). Story: $EPIC — READ FIRST: context pack $PACK (spec slice + touch map + ACCEPTANCE + boundary) + story doc $SRC_REL. Epic đã trả lời mọi câu — KHÔNG re-ask; câu hỏi mới → REQUIREMENT-GAP comment lên epic. Run full Phase 0-5 cho SF này. Linear: $LIN_LABEL. Worktree base: $DEST. $HARDLIMIT

CHECKLIST — chạy TUẦN TỰ, mỗi mục xong phải CÓ BẰNG CHỨNG (lệnh + output), cấm tick trước bằng chứng:
CHECK 1 CODE+TESTS — TDD RED→GREEN khi khả thi (test thất bại trước → code tối thiểu); commit atomic; tick plan file sau mỗi task.
CHECK 2 PLAN TICKED — mọi '- [ ]' trong plan → '- [x]' (meta-steps dùng numbered list, không dùng '- [ ]').
CHECK 3 ROLLING REVIEW — mỗi 4-5 tasks dispatch code-reviewer ĐỘC LẬP trên diff nhóm đó (KHÔNG dồn 1 review lớn cuối SF — FI-187: đứng chờ 30+ phút). Verdict post lên $LIN_LABEL, KHÔNG để kẹt outbox.
CHECK 4 BROWSER VERIFY (Rule 0) — mở app (orca tab create --url http://localhost:<port> hoặc curl nếu chỉ API) → TỰ ĐI TRỌN FLOW (login/navigate/thao tác) + CHỤP SCREENSHOT; UI sai/flow đứt → FIX TRƯỚC KHI TIẾP. KHÔNG ĐƯỢC nói xong khi chưa thấy nó chạy.
$CHECK5
$CHECK6
BLOCKED → report 4 mục evidence: đã thử gì / output nào / giả định nào / cần gì — không im lặng. Linear: orca keychain hỏng → đọc key ~/.claude/.linear-key gọi GraphQL (Authorization: <key>, POST https://api.linear.app/graphql). Shell: probes cmd > log; echo \$? — KHÔNG pipe head/tail. SSL/cert → đợi 30s retry tối đa 3 lần. $DONE_RULE"

# HOLDS check (team discipline v1): repo đang được session khác giữ → WARN,
# không chặn (người quyết). File: ~/.claude/holds.md — dòng: <repo-path> | <holder> | <since>
HOLDS_FILE="$HOME/.claude/holds.md"
REPO_ABS=$(cd "$(dirname "$SRC_FILE")/../.." 2>/dev/null && pwd)
if [ -f "$HOLDS_FILE" ] && [ -n "$REPO_ABS" ]; then
  HOLD_HIT=$(grep -F "$REPO_ABS" "$HOLDS_FILE" | head -1)
  [ -n "$HOLD_HIT" ] && echo "⚠ HOLDS: repo đang bị giữ — $HOLD_HIT (liên hệ holder trước khi launch)"
fi

if [ "$DRY_RUN" = 1 ]; then
  echo "── DRY-RUN launch sf-$N-$SLUG ($LINEAR) từ $DEST"
  echo "$PROMPT" | head -6; echo "..."
  # dry-run + claim phải chạy fetch gate (read-only) — không báo OK cho launch
  # thật sẽ fail-closed; không --claim → output nguyên vẹn (zero-diff)
  if [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ]; then
    if dest_fetch_check "$REPO" "$DEST"; then
      echo "── distributed dry-run: dest fetch OK ($DEST ← $DEST_REMOTE)"
    else
      echo "── distributed dry-run: dest fetch SẼ FAIL — launch thật sẽ fail-closed ($DEST ← $DEST_REMOTE)"
      [ -n "${FERR:-}" ] && printf 'distributed: fetch stderr: %s\n' "$(printf '%s' "$FERR" | tail -2)" >&2
    fi
  fi
  exit 0
fi

# ── claim flow (B1): sau validate deps, TRƯỚC dest fetch — thứ tự normative
# claim → git-guard → fork. Read → (a) write | (b) renew | (c) skip | (d) stale
if [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ]; then
  # gọi TRỰC TIẾP (không $()) — giữ được rc của claim_read (curl rc xuyên thẳng)
  dc_rd="$(mktemp "${TMPDIR:-/tmp}/dc-claim-read.XXXXXX")"
  if claim_read "$LINEAR" > "$dc_rd"; then
    cinfo=$(cat "$dc_rd"); rm -f "$dc_rd"
  else
    drrc=$?; rm -f "$dc_rd"
    # C3 fail-closed phân loại: thiếu key ≠ mạng chết ≠ HTTP error — hết đoán mò
    case "$drrc" in
      3) echo "distributed: LINEAR_API_KEY thiếu — fail-closed" ;;
      22) echo "distributed: Linear HTTP error — fail-closed" ;;
      *) echo "distributed: Linear unreachable (rc $drrc) — fail-closed" ;;
    esac
    exit 1
  fi
  cmid=$(printf '%s' "$cinfo" | cut -f1)
  cts=$(printf '%s' "$cinfo" | cut -f2)
  ccid=$(printf '%s' "$cinfo" | cut -f3)
  clids=$(printf '%s' "$cinfo" | cut -f5)
  cnames=$(printf '%s' "$cinfo" | cut -f6)
  cpartial=$(printf '%s' "$cinfo" | cut -f7)
  clts=$(printf '%s' "$cinfo" | cut -f8)   # createdAt (server) label claimed/*
  if [ "$cpartial" = "1" ]; then
    # age-gate partial (plan §4): label tươi = comment bị evict nhưng claim còn
    # sống — overwrite mù quáng giành claim của máy đang làm thật
    page=$(dc_age_minutes "$clts")
    pser=$(printf '%s' "$cnames" | tr ',' '\n' | grep '^claimed/' | head -1)
    pthr=$(( DC_TTL * 2 ))
    if [ -n "$clts" ] && [ "$page" -lt "$pthr" ]; then
      echo "distributed: partial fresh label $pser age${page}m — không overwrite (SKIP)"
      exit 0
    fi
    echo "distributed: partial-detected — stale ≥${pthr}m — takeover path (ghi đè)"
  fi
  if [ -z "$cmid" ]; then
    claim_write "$LINEAR" "$CLAIM_MID" "$cnames" "$clids" >/dev/null; wrc=$?
    [ "$wrc" = "0" ] || { echo "distributed: claim write failed (rc=$wrc) — thua race/fail — skip"; exit 1; }
  elif [ "$cmid" = "$CLAIM_MID" ]; then
    # renew fail-open — claim đã của mình, timestamp hụt 1 nhịp không chặn launch
    claim_renew "$LINEAR" "$ccid" "$CLAIM_MID" "$cnames" "$clids" >/dev/null 2>&1 \
      || echo "distributed: renew failed — tiếp tục (fail-open)" >&2
  else
    age=$(dc_age_minutes "$cts")
    thr=$(( DC_TTL * 2 ))
    if [ "$age" -lt "$thr" ]; then
      echo "distributed: $SF_NUM claimed by $cmid — SKIP"
      exit 0
    else
      # (d) stale ≥ 2×TTL (B3): commits-fresh guard rồi revoke + claim lại
      sf_branch="sf-$N-$SLUG"
      sf_remote="$(git -C "$REPO" config "branch.$DEST.remote" 2>/dev/null)"
      [ -n "$sf_remote" ] || sf_remote=origin
      gtip=$(claim_takeover "$LINEAR" "$cmid" "$CLAIM_MID" "$REPO" "$sf_branch" \
        "$sf_remote" "$DC_TTL" "$cnames" "$clids")
      trc=$?
      # tip SF branch quan sát được — guard force-with-lease (stale branch của
      # máy cũ không được chặn takeover hợp lệ, nhưng race takeover vẫn atomic)
      [ "$trc" = "0" ] && GUARD_EXPECT="$gtip"
      case "$trc" in
        0) echo "TAKEOVER $SF_NUM: $cmid → $CLAIM_MID" ;;
        1) echo "distributed: $SF_NUM không takeover — commits-fresh, skip"; exit 0 ;;
        *) echo "distributed: takeover fail (rc=$trc) — fail-closed"; exit 1 ;;
      esac
    fi
  fi
fi

# ── dest contract (A5): fetch dest TRƯỚC fork — dest stale = push-race,
# fail-closed khi enabled; disabled/không --claim = không git call nào (zero-diff)
if [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ]; then
  if ! dest_fetch_check "$REPO" "$DEST"; then
    echo "distributed: dest fetch failed — fail-closed ($DEST ← $DEST_REMOTE)"
    [ -n "${FERR:-}" ] && printf 'distributed: fetch stderr: %s\n' "$(printf '%s' "$FERR" | tail -2)" >&2
    exit 1
  fi
  DEST_SHA=$(git -C "$REPO" rev-parse FETCH_HEAD 2>/dev/null)
fi
# ── git-guard (C1): serialization atomic — push nhánh SF tạo-mới-chỉ-khi-còn-trống;
# thua = máy khác đang làm thật → skip (claim để tự stale/takeover, không revoke thêm)
if [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ]; then
  [ -n "$DEST_SHA" ] || { echo "distributed: git-guard thiếu dest SHA — fail-closed"; exit 1; }
  if [ -n "$GUARD_EXPECT" ]; then
    guard_out=$(LC_ALL=C GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 \
      git -C "$REPO" push "--force-with-lease=refs/heads/sf-$N-$SLUG:$GUARD_EXPECT" \
      "$DEST_REMOTE" "$DEST_SHA:refs/heads/sf-$N-$SLUG" 2>&1 1>/dev/null)
  else
    guard_out=$(LC_ALL=C GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 \
      git -C "$REPO" push "$DEST_REMOTE" "$DEST_SHA:refs/heads/sf-$N-$SLUG" 2>&1 1>/dev/null)
  fi
  guard_rc=$?
  # plain push cùng SHA với branch có sẵn = "up-to-date" rc0 — chỉ [new branch] mới là thắng
  guard_win=0
  if [ "$guard_rc" = "0" ] && { [ -n "$GUARD_EXPECT" ] \
    || printf '%s' "$guard_out" | grep -q '\[new branch\]'; }; then
    guard_win=1
  fi
  if [ "$guard_win" != "1" ]; then
    # phân lớp: rc0-up-to-date / rejected / stale-info = branch có thật (lost);
    # rc≠0 khác = network/lỗi push — đúng bệnh, vẫn fail-closed không fork
    if [ "$guard_rc" = "0" ] \
      || printf '%s' "$guard_out" | grep -qE '\(stale info\)|rejected'; then
      echo "distributed: git-guard lost — sf-$N-$SLUG đã tồn tại trên $DEST_REMOTE (máy khác đang làm) — nếu là branch SF lần trước của máy bạn, xoá remote branch để launch lại"
      echo "distributed: claim vừa ghi sẽ tự stale (≥2×TTL) — máy khác takeover; không tự revoke"
    else
      echo "distributed: git-guard push FAIL (rc=$guard_rc) — fail-closed"
      printf '%s\n' "$(printf '%s' "$guard_out" | tail -2)" >&2
    fi
    exit 1
  fi
fi
echo "── launch sf-$N-$SLUG ($LINEAR) ← $DEST"
# lineage cha (kit ≥2.16.7): SF worktree là CON của worktree story — 1 story =
# 1 cây. story-hub: không có legacy coordinator worktree — cha = chính story
# worktree (basename DEST, tạo ở APPROVE). Legacy: cha "<dest-slug>-coordinator".
# Chưa có cha → degrade --no-parent, không chặn launch (fail-open).
if [ "$WTMODEL" = "story-hub" ]; then
  COORD_WT="$(basename "$DEST")"
else
  COORD_WT="$(basename "$DEST")-coordinator"
fi
PARENT_FLAG="--no-parent"
# selector đúng: orca đòi path:/branch:/name: — bare path/bare name bị nuốt (sf-2 VU-32
# mồ côi 04/10: probe bare name chết → degrade --no-parent âm thầm). Cha = worktree đang
# checkout nhánh đích (story-hub lẫn legacy coordinator đều đứng trên DEST) → branch:
_hub_json="$(orca worktree show --worktree "branch:$DEST" --json 2>/dev/null || true)"
_hub_path="$(printf '%s' "$_hub_json" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const r=JSON.parse(s);const w=(r.result&&r.result.worktree)||r.result;console.log(w.path||"")}catch{console.log("")}})' 2>/dev/null || true)"
if [ -n "$_hub_path" ]; then
  PARENT_FLAG="--parent-worktree path:$_hub_path"
else
  echo "  (worktree cha trên branch $DEST chưa có — tạo ở APPROVE; launch tiếp không lineage)"
fi
# LUẬT 24/09 (enforce 04/10): cấm spawn bypass — template agent 'claude' của Orca
# cài sẵn --dangerously-skip-permissions (bằng chứng: pid 20066 LOCAL-4 sf-4 worker).
# Hai bước theo guide orca-cli custom-argv: create trần → terminal create argv tường
# minh acceptEdits → wait tui-idle → send prompt qua --text (khỏi nhét prompt vào argv).
CREATE_OUT="$(orca worktree create --name "sf-$N-$SLUG" ${LINEAR:+"--linear-issue" "$LINEAR"} \
  --base-branch "$DEST" $PARENT_FLAG --json 2>&1)"
WID="$(printf '%s' "$CREATE_OUT" | python3 -c 'import json,sys
try:
  print(json.load(sys.stdin)["result"]["worktree"]["id"])
except Exception:
  print("")')"
if [ -z "$WID" ]; then
  echo "LAUNCH FAIL — worktree không tạo được; read-back: worktree list"
  # guard branch giữ lại trên remote = dấu vết vô hại — máy khác thấy sẽ skip
  [ "$CLAIM" = 1 ] && [ "$(distributed_enabled)" = "1" ] \
    && echo "distributed: guard branch sf-$N-$SLUG còn trên remote — vô hại (máy khác sẽ skip)"
  exit 1
fi
AGENT_CH="$(orca terminal create --worktree "id:$WID" --title "sf-$N-$SLUG" \
  --command "claude --permission-mode acceptEdits" --json 2>/dev/null \
  | python3 -c 'import json,sys
try:
  r=json.load(sys.stdin)["result"]
  print(r.get("terminal",{}).get("handle") or r.get("handle") or "")
except Exception:
  print("")')"
orca terminal wait --terminal "$AGENT_CH" --for tui-idle --timeout-ms 90000 --json >/dev/null 2>&1 || true
if orca terminal send --terminal "$AGENT_CH" --text "$PROMPT" --enter --json >/dev/null 2>&1; then
  echo "LAUNCHED ✓ sf-$N-$SLUG (acceptEdits, human-in-the-loop)"
else
  echo "LAUNCH FAIL ở bước send prompt — worktree ĐÃ tạo ($WID), gửi tay prompt theo references/sf-launch-prompt.md"
  exit 1
fi
# mindmap snapshot (VU-14 SF-1 — fail-open; dry-run đã exit trước nên preview không ghi).
# Nguồn .wakii canonical → mindmap đã có, không regenerate từ bracket.
if [ -z "$WAKII" ]; then
  MT="$(dirname "$0")/story-mindmap-trigger"
  [ -f "$MT" ] && "$MT" --reason launch --bracket "$BRACKET" >/dev/null 2>&1 || true
fi
