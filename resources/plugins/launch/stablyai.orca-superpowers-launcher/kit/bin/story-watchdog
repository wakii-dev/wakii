#!/bin/bash
# story-watchdog — self-sustainment loop cho stories (tool hóa STORY-WATCHDOG trong
# story-workflow). Chạy 1 pass: diagnose mọi SF → notify khi stall MỚI → optionally
# auto-resume. Đăng ký cron/loop để story không bao giờ stall 12 ngày không ai biết.
#
# Bài học vận hành (2/2 stories watchdog chết theo session): watchdog phải sống
# NGOÀI Claude session — cron hoặc nohup loop. Script này được thiết kế cho cả hai.
#
# Usage:
#   story-watchdog                      1 pass — diagnose + notify stall mới
#   story-watchdog --auto-resume        1 pass + GỬI resume prompt cho SF stalled
#   story-watchdog --enforce-done       Done mà verify ≠ COMPLETE → tự hạ In Progress
#   story-watchdog --with-index         1 pass + memory index hook (fail-safe — lỗi index không đổi exit code)
#   story-watchdog --loop 30            tự lặp mỗi 30 phút (nohup pattern)
#   story-watchdog --install-cron       đăng ký crontab entry (mỗi 30', idempotent)
#   Options: --stall-hours N (default 2, pass xuống story-resume)
#
# Exit: 0 = mọi SF sống · 1 = có stalled (dù đã auto-resume — để cron wrapper biết)
set -u

DIR="$(cd "$(dirname "$0")" && pwd)"
RESUME="${STORY_RESUME_BIN:-}"   # env override (test) — default giữ nguyên chain dưới
[ -n "$RESUME" ] || RESUME="$DIR/story-resume"
LAUNCH="$DIR/story-launch"
[ -x "$LAUNCH" ] || LAUNCH="$HOME/.claude/bin/story-launch"
[ -x "$RESUME" ] || RESUME="$HOME/.claude/bin/story-resume"
[ -x "$RESUME" ] || { echo "story-resume không tìm thấy (cần nằm cạnh story-watchdog)"; exit 2; }
# index hook chỉ cần khi --with-index — resolve sẵn, die muộn hơn (sau arg parse)
IDX_HOOK="$DIR/story-memory-index-hook"
[ -x "$IDX_HOOK" ] || IDX_HOOK="$HOME/.claude/bin/story-memory-index-hook"
# validator gate cho launch-next (2 parser độc lập = drift lặng lẽ — giờ awk chỉ
# chạy sau khi story-validate OK; bracket hỏng thì SKIP, không đoán)
VALIDATE="$DIR/story-validate"
[ -x "$VALIDATE" ] || VALIDATE="$HOME/.claude/bin/story-validate"
VERIFY="$DIR/story-verify"
[ -x "$VERIFY" ] || VERIFY="$HOME/.claude/bin/story-verify"

# cron PATH tối giản — resolve production binary + runtime dev-trước-prod-sau
ORCA_BIN="${ORCA_BIN:-/opt/homebrew/bin/orca}"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/usr/local/bin/orca"
[ -x "$ORCA_BIN" ] || ORCA_BIN="/Applications/Orca.app/Contents/Resources/bin/orca"
ORCA_DEV="$HOME/Library/Application Support/orca-dev"
ORCA_PROD="$HOME/Library/Application Support/orca"
orca() {
  ORCA_USER_DATA_PATH="$ORCA_DEV" "$ORCA_BIN" "$@" 2>/dev/null \
    || ORCA_USER_DATA_PATH="$ORCA_PROD" "$ORCA_BIN" "$@" 2>/dev/null \
    || return 1
}

STATE_FILE="${STATE_FILE:-$HOME/.claude/.story-watchdog-state}"
STALL_HOURS=2
AUTO_RESUME=0
ENFORCE_DONE=${ENFORCE_DONE:-0}
WITH_INDEX=0
LOOP_MIN=0
LAUNCH_NEXT=0
DRY_RUN=0

notify() { # $1 title, $2 body — macOS notification (không chết khi thiếu osascript)
  # escape \ và " — detail chứa quote không được giết osascript/đổi nghĩa chuỗi
  command -v osascript >/dev/null 2>&1 || return 0
  local t b
  t=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  b=$(printf '%s' "$2" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  osascript -e "display notification \"$b\" with title \"$t\"" >/dev/null 2>&1 || true
}

load_state() { # in state của sf ($1) từ lần trước
  [ -f "$STATE_FILE" ] && grep -m1 "^$1|" "$STATE_FILE" | cut -d'|' -f2
}

save_state() { # $1 sf, $2 verdict — RMW dưới with_file_lock (GH-37): python
  # one-shot spawn (pattern index-hook), tmp+rename trong fn — 2 pass đồng
  # thời không mất verdict. Lock timeout → giữ state cũ (benign).
  # cygpath -m: Git Bash path /c/... → C:/... cho Windows python (macOS/Linux
  # không có cygpath → path giữ nguyên). Giá trị truyền qua env (WD_SF,
  # WD_VERDICT, WD_DIR, WD_STATE, WD_SDIR) — KHÔNG nhét vào python source
  # (bash-3.2 không có ${var@Q}; escape qua heredoc gãy theo từng lớp quoting).
  local sf="$1" verdict="$2" sdir sdir_w sfile_w dir_w stmp
  sdir="$(dirname "$STATE_FILE")"
  if command -v cygpath >/dev/null 2>&1; then
    sdir_w="$(cygpath -m "$sdir")"; sfile_w="$(cygpath -m "$STATE_FILE")"
    dir_w="$(cygpath -m "$DIR")"
  else
    sdir_w="$sdir"; sfile_w="$STATE_FILE"; dir_w="$DIR"
  fi
  stmp="$(mktemp "${TMPDIR:-/tmp}/wd-save-XXXXXX.py" 2>/dev/null)" || return 0
  # export CHO PYTHON (env-prefix chỉ trên cat là không đủ — python đọc os.environ)
  WD_SF="$sf" WD_VERDICT="$verdict" WD_DIR="$dir_w" WD_STATE="$sfile_w" \
    WD_SDIR="$sdir_w"
  export WD_SF WD_VERDICT WD_DIR WD_STATE WD_SDIR
  cat > "$stmp" <<'PYEOF'
import sys
sys.dont_write_bytecode = True
import importlib.machinery
import importlib.util
import os
import pathlib
sf = os.environ["WD_SF"]
verdict = os.environ["WD_VERDICT"]
sf_dir = pathlib.Path(os.environ["WD_SDIR"])
state = pathlib.Path(os.environ["WD_STATE"])
candidates = [pathlib.Path(os.environ["WD_DIR"]) / "story-checkpoint",
              pathlib.Path(os.path.expanduser("~")) / ".claude" / "bin" / "story-checkpoint"]
cp = None
for cand in candidates:
    if cand.is_file():
        try:
            loader = importlib.machinery.SourceFileLoader("cp_wd", str(cand))
            spec = importlib.util.spec_from_loader("cp_wd", loader)
            cp = importlib.util.module_from_spec(spec)
            loader.exec_module(cp)
            break
        except Exception:
            continue
if cp is None:
    sys.exit(0)  # donor thiếu — skip write (fail-open, không hỏng watchdog)

def rmw():
    lines = []
    if state.exists():
        lines = [l for l in state.read_text(encoding="utf-8", errors="replace").splitlines()
                 if l.strip() and l.split("|", 1)[0] != sf]
    lines.append(sf + "|" + verdict + "|" + str(int(__import__("time").time())))
    tmp = state.with_name(state.name + ".tmp-" + str(os.getpid()))
    with open(tmp, "w", encoding="utf-8", newline="") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, state)
    return True

log = state.with_name(state.name + ".log")
try:
    cp.with_file_lock(sf_dir, ".story-watchdog-state.lock", rmw, 10.0,
                      mkdir=True, log_path=log)
except Exception:
    pass
PYEOF
  python3 "$stmp" >/dev/null 2>&1 || python "$stmp" >/dev/null 2>&1 || true
  rm -f "$stmp"
}

# ── Linear state qua dual-path (SF-4): orca CLI trước (keychain app — không
# cần ~/.claude/.linear-key), GraphQL fallback khi keychain chết (bài học FI-187)
linear_state() { # $1 = issue-id → in state name ("" nếu không biết) — retry 1 lần
  local out
  out=$(orca linear issue "$1" --json 2>/dev/null | python3 -c "
import json, sys
try: print(json.load(sys.stdin)['result']['issue']['state']['name'])
except Exception: print('')" 2>/dev/null)
  [ -n "$out" ] && { echo "$out"; return; }
  local key="${LINEAR_API_KEY:-}"
  if [ -z "$key" ] && [ -f "$HOME/.claude/.linear-key" ]; then
    key=$(head -1 "$HOME/.claude/.linear-key" | tr -d '[:space:]')
  fi
  [ -z "$key" ] && { echo ""; return; }
  local st i
  for i in 1 2; do
    st=$(curl -s -m 10 -X POST https://api.linear.app/graphql \
      -H "Authorization: $key" -H "Content-Type: application/json" \
      -d "{\"query\":\"query{issue(id:\\\"$1\\\"){state{name}}}\"}" 2>/dev/null \
      | python3 -c "import json,sys
try: print(json.load(sys.stdin)['data']['issue']['state']['name'])
except: print('')" 2>/dev/null)
    [ -n "$st" ] && { echo "$st"; return; }
    sleep 1
  done
  echo ""
}

# batch: 1 request GraphQL cho nhiều issue (tránh N+1 → Linear rate-limit khi 11 agents gọi cùng lúc)
linear_states_batch() { # $@ = issue identifiers (FI-247...) → in "ID<TAB>state" mỗi dòng
  # dual-path (SF-4): curl batch khi có key; không key / curl hỏng → orca CLI
  # lần lượt (keychain app) — launch-next không còn nhầm SF Done thành Todo
  local key="${LINEAR_API_KEY:-}"
  if [ -z "$key" ] && [ -f "$HOME/.claude/.linear-key" ]; then
    key=$(head -1 "$HOME/.claude/.linear-key" | tr -d '[:space:]')
  fi
  [ $# -eq 0 ] && return 0
  local out="" ids_json resp i id st
  if [ -n "$key" ]; then
    ids_json=$(printf '"%s",' "$@" | sed 's/,$//')
    for i in 1 2; do
      resp=$(curl -s -m 15 -X POST https://api.linear.app/graphql \
        -H "Authorization: $key" -H "Content-Type: application/json" \
        -d "{\"query\":\"query{issues(filter:{identifier:{in:[$ids_json]}}){nodes{identifier state{name}}}}\"}" 2>/dev/null)
      if echo "$resp" | grep -qi "rate limit\|429\|too many requests"; then
        sleep 5
        continue
      fi
      out=$(echo "$resp" | python3 -c "
import json,sys
try:
    d = json.load(sys.stdin)
    for n in (d.get('data') or {}).get('issues', {}).get('nodes', []):
        st = (n.get('state') or {}).get('name', '')
        print(n.get('identifier', '') + '\t' + st)
except: pass" 2>/dev/null)
      break
    done
  fi
  if [ -z "$out" ]; then
    for id in "$@"; do
      st=$(linear_state "$id")
      [ -n "$st" ] && printf '%s\t%s\n' "$id" "$st"
    done
  fi
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

# ── launch-next: bracket → SF chưa có worktree + deps Done → launch.
#    Đây là mảnh đưa story TỰ TIẾN tier khi không có session nào sống.
#    Chỉ launch SF trong bracket ĐÃ DUYỆT (có linear ID) — không tự ý mở scope.
launch_next() { # DRY_RUN=1 → chỉ in kế hoạch
  local launched=0
  # distributed passthrough (B4): enabled → thêm --claim (machine-id do
  # story-launch tự resolve từ config — watchdog không copy flags); disabled =
  # lời gọi y nguyên bản cũ (zero-diff). File-read local, không call mạng.
  local claim_arg=""
  if [ -f "$DIR/story-distributed-claim" ]; then
    # shellcheck disable=SC1091
    . "$DIR/story-distributed-claim" 2>/dev/null || true
    distributed_config_load || true
    [ "$(distributed_enabled)" = "1" ] && claim_arg="--claim"
  fi
  # cap launch mỗi pass — tránh nổ nhiều SF song song (rate limit, review dồn, port xung đột)
  local max_launch="${STORY_WATCHDOG_MAX_LAUNCH:-2}"
  local roots=()
  local nroots=0
  local rl
  rl=$(orca repo list --json 2>/dev/null | python3 -c "
import json,sys
try:
    for r in json.load(sys.stdin).get('result',{}).get('repos',[]):
        p = r.get('path')
        if p: print(p)
except: pass" 2>/dev/null)
  while IFS= read -r p; do [ -n "$p" ] && { roots+=("$p"); nroots=$((nroots+1)); }; done <<< "$rl"
  for p in "$HOME"/orca/projects/*; do [ -d "$p" ] && { roots+=("$p"); nroots=$((nroots+1)); }; done
  # bash 3.2 + set -u: mảng rỗng local crash khi expand — luôn guard bằng counter
  [ "$nroots" -gt 0 ] || { [ "$DRY_RUN" = 1 ] && echo "  (không có repo nào — orca repo list rỗng)"; return 0; }
  # dedup theo path thật (repo list + projects/* có thể trùng)
  local SEEN="" r2 FILTERED=()
  for r2 in ${roots[@]+"${roots[@]}"}; do
    case "$SEEN" in *"|$r2|"*) continue ;; esac
    SEEN="$SEEN|$r2|"; FILTERED+=("$r2")
  done
  roots=(${FILTERED[@]+"${FILTERED[@]}"})
  for repo in ${roots[@]+"${roots[@]}"}; do
    local bdir="$repo/docs/superpowers/brackets"
    [ -d "$bdir" ] || continue
    local repob=$(basename "$repo")
    local bf
    for bf in "$bdir"/*.md; do
      [ -f "$bf" ] || continue
      # ── validator gate: bracket phải story-validate OK trước khi awk parse ──
      # (awk parser lỏng — format trôi nó im lặng; validator là nguồn sự thật.
      #  Validator thiếu/hỏng → fail-closed: không launch gì cả, in cảnh báo 1 lần)
      if [ ! -x "$VALIDATE" ]; then
        echo "  ⚠ story-validate không tìm thấy — launch-next SKIP mọi bracket (fail-closed)"
        return 0
      fi
      local vjson vverdict
      vjson=$("$VALIDATE" "$bf" --json 2>/dev/null) || true
      vverdict=$(printf '%s' "$vjson" | python3 -c "import json,sys
try: print(json.load(sys.stdin).get('verdict',''))
except: print('')" 2>/dev/null)
      if [ "$vverdict" != "OK" ]; then
        echo "  ⚠ skip $(basename "$bf") — story-validate: ${vverdict:-KHÔNG-ĐỌC-ĐƯỢC} (sửa bracket rồi cron pass kế sẽ launch)"
        [ "$DRY_RUN" = 1 ] && printf '%s' "$vjson" | python3 -m json.tool 2>/dev/null | sed 's/^/    /'
        continue
      fi
      local dest epic
      dest=$(grep -m1 '^Destination:' "$bf" | sed 's/Destination: *//;s/ *$//')
      epic=$(grep -m1 '^# Story:' "$bf" | sed 's/# Story: *\([A-Za-z]*-[0-9]*\).*/\1/')
      [ -n "$dest" ] || continue
      # các SF: "num|title|linear|deps" (deps = "SF-2, SF-3")
      # 1 request duy nhất cho mọi issue của bracket (linear_state per-issue → rate-limit khi nhiều SF)
      local state_map="" bid
      bid=$(grep -oE 'linear: *[A-Za-z]+-[0-9]+' "$bf" | awk '{print $2}' | sort -u)
      [ -n "$bid" ] && state_map=$(linear_states_batch $bid)
      local bk_total=0 bk_done=0
      while IFS='|' read -r sfnum title linear deps; do
        [ -n "$linear" ] || continue   # chưa APPROVE → không thuộc quyền launch
        bk_total=$((bk_total+1))
        # SF đã Done = hoàn thành, không phải "chưa launch" (worktree đã dọn)
        local ownst=$(printf '%s\n' "$state_map" | awk -v id="$linear" -F'\t' '$1==id{print $2}')
        if [ "$ownst" = "Done" ]; then
          bk_done=$((bk_done+1))
          [ "$DRY_RUN" = 1 ] && echo "  xong: $sfnum ($linear) — Done"
          continue
        fi
        # đã có worktree sf-N-* chưa?
        local n=$(echo "$sfnum" | sed 's/SF-//')
        local wt=$(ls -d "$HOME"/orca/workspaces/"$repob"/sf-"$n"-* 2>/dev/null | head -1)
        [ -n "$wt" ] && continue
        # deps Done hết chưa?
        local ok=1 why=""
        local d
        for d in $(echo "$deps" | tr ',' ' '); do
          d=$(echo "$d" | tr -d ' ')
          case "$d" in ""|—|—|*) ;; esac
          echo "$d" | grep -q '^SF-' || continue
          local dn=$(echo "$d" | sed 's/SF-//')
          local depid=$(awk -v dn="SF-$dn" '
            $0 ~ "^## " dn "([ :]|$)" { in_sf = 1; next }
            /^## / { in_sf = 0 }
            in_sf && /^linear:/ { gsub(/.*linear: /,""); print; exit }' "$bf")
          [ -n "$depid" ] || { ok=0; why="$why $d(?id)"; continue; }
          local st=$(printf '%s\n' "$state_map" | awk -v id="$depid" -F'\t' '$1==id{print $2}')
          if [ "$st" != "Done" ]; then ok=0; why="$why $d=$st"; fi
        done
        local slug=$(echo "$title" | tr '[:upper:]' '[:lower:]' \
          | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-30)
        [ -n "$slug" ] || slug="sf"
        if [ "$ok" != 1 ]; then
          [ "$DRY_RUN" = 1 ] && echo "  chờ: $sfnum ($linear) — deps:$why"
          continue
        fi
        if [ "$DRY_RUN" = 1 ]; then
          echo "  SẴN SÀNG LAUNCH: sf-$n-$slug ($linear) ← bracket $repob · đích $dest"
          continue
        fi
        if [ "$launched" -ge "$max_launch" ]; then
          echo "  cap: sf-$n-$slug ($linear) sẵn sàng — đạt giới hạn $max_launch launch/pass, chờ pass kế (STORY_WATCHDOG_MAX_LAUNCH để tăng)"
          continue
        fi
        local launch_out
        if [ "$DRY_RUN" = 1 ]; then
          launch_out=$("$LAUNCH" --sf "$sfnum" --bracket "$bf" $claim_arg --dry-run 2>&1 | head -3)
        else
          launch_out=$("$LAUNCH" --sf "$sfnum" --bracket "$bf" $claim_arg 2>&1)
        fi
        echo "$launch_out" | sed 's/^/    /'
        if echo "$launch_out" | grep -q "LAUNCHED"; then
          notify "story-watchdog ▶" "$sfnum launched — tier kế tự tiến"
          launched=$((launched+1))
        fi
      done < <(awk '
        function emit() { if (sf != "") print sf "|" title "|" linear "|" deps }
        /^## / { if ($0 !~ /^## SF-/) { emit(); sf = ""; insf = 0; next } }
        /^## SF-/ {
          emit()
          sf = $2
          title = $0; sub(/^## SF-[0-9]+ +/, "", title)
          linear = ""; deps = ""; insf = 1; next
        }
        insf && /^linear:/ { linear = $2 }
        insf && /^Depends on:/ { sub(/^Depends on: */, ""); deps = $0 }
        END { emit() }' "$bf")
      # ── STORY-COMPLETE per bracket (SF-4): derive từ Linear — mọi SF có id
      # đều Done → story xong thật (kể khi worktree máy khác đã dọn)
      if [ "$bk_total" -gt 0 ] && [ "$bk_total" -eq "$bk_done" ]; then
        echo "  STORY-COMPLETE: $epic — mọi SF Done theo Linear (bracket $(basename "$bf"))"
      fi
    done
  done
  return $launched
}

# ── heartbeat (B4): renew claim của MÁY MÌNH cho SF phiên đang sống — IFF
# terminal verdict RUNNING/BUSY (từ story-resume --check — nguồn liveness có sẵn,
# không xác định được → KHÔNG renew) VÀ worktree có commit mới trong TTL.
# ≤1 mutation renew/SF/pass. Renew fail → log + chạy tiếp (fail-open, không đổi
# exit watchdog). Disabled = return sớm — 0 call, zero-diff.
heartbeat_renew() {
  [ -f "$DIR/story-distributed-claim" ] || return 0
  # shellcheck disable=SC1091
  . "$DIR/story-distributed-claim" 2>/dev/null || return 0
  distributed_config_load || return 0
  [ "$(distributed_enabled)" = "1" ] || return 0
  # dry-run chỉ xem — renew là mutation, không được chạy khi --dry-run (P1-1)
  [ "$DRY_RUN" = 1 ] && { echo "dry-run: skip heartbeat renew"; return 0; }
  local ttl mid check_out sf verdict sfnum repob repo wt linear cinfo cmid ccid cn ci
  local roots=() nroots=0 p rl
  ttl="$(distributed_config_get claimTtlMinutes)"
  mid="$(distributed_config_get machineId)"
  check_out=$("$RESUME" --check --stall-hours "$STALL_HOURS" 2>/dev/null)
  [ -n "$check_out" ] || return 0
  # repo roots — pattern launch_next (orca repo list + ~/orca/projects/*)
  rl=$(orca repo list --json 2>/dev/null | python3 -c "
import json,sys
try:
    for r in json.load(sys.stdin).get('result',{}).get('repos',[]):
        if r.get('path'): print(r['path'])
except: pass" 2>/dev/null)
  while IFS= read -r p; do [ -n "$p" ] && { roots+=("$p"); nroots=$((nroots+1)); }; done <<< "$rl"
  for p in "$HOME"/orca/projects/*; do [ -d "$p" ] && { roots+=("$p"); nroots=$((nroots+1)); }; done
  [ "$nroots" -gt 0 ] || return 0
  printf '%s\n' "$check_out" | while IFS='|' read -r sf verdict _; do
    case "$verdict" in RUNNING|BUSY) ;; *) continue ;; esac
    sfnum=$(printf '%s' "$sf" | grep -oE '[0-9]+' | head -1)
    [ -n "$sfnum" ] || continue
    for repo in ${roots[@]+"${roots[@]}"}; do
      repob=$(basename "$repo")
      wt=$(ls -d "$HOME/orca/workspaces/$repob/sf-$sfnum-"* 2>/dev/null | head -1)
      [ -d "$wt" ] || continue
      # commit mới trong TTL trên branch worktree? không có → có thể agent đứng
      # im — không renew (nhường takeover logic tự phán)
      git -C "$wt" log --since "$ttl minutes ago" -1 --oneline 2>/dev/null | grep -q . || continue
      for bf in "$repo"/docs/superpowers/brackets/*.md; do
        [ -f "$bf" ] || continue
        grep -q "^## SF-$sfnum[ :]" "$bf" 2>/dev/null || continue
        linear=$(awk -v sfx="SF-$sfnum" '
          $0 ~ "^## " sfx "([ :]|$)" { in_sf = 1; next }
          /^## / { in_sf = 0 }
          in_sf && /^linear:/ { gsub(/.*linear: /,""); print; exit }' "$bf")
        [ -n "$linear" ] || continue
        # read fail phải lộ ra — im lặng khiến heartbeat chết mà không ai biết
        cinfo=$(claim_read "$linear") || { echo "$(date '+%H:%M') heartbeat: claim read fail $sf" >&2; continue; }
        cmid=$(printf '%s' "$cinfo" | cut -f1)
        [ "$cmid" = "$mid" ] || continue   # chỉ renew claim của máy mình
        ccid=$(printf '%s' "$cinfo" | cut -f3)
        cn=$(printf '%s' "$cinfo" | cut -f6)
        ci=$(printf '%s' "$cinfo" | cut -f5)
        if claim_renew "$linear" "$ccid" "$mid" "$cn" "$ci" >/dev/null 2>&1; then
          echo "$(date '+%H:%M') heartbeat: $sf renew ($linear)"
        else
          echo "$(date '+%H:%M') heartbeat: $sf renew FAIL — tiếp tục (fail-open)"
        fi
        break 2   # bracket đầu khớp là đủ — ≤1 renew/SF/pass
      done
      break
    done
  done
  return 0
}

# ── enforce-done (FI-458 team discipline): Linear Done mà story-verify verdict
# ≠ COMPLETE → tự hạ về In Progress + notify (chống Done-early TẠI NGUỒN).
enforce_done_pass() {
  local wts=() ws wt sf linear sfnum st vj vv demoted=0
  for ws in "$HOME"/orca/workspaces/*/; do
    for wt in "$ws"sf-*/; do
      [ -d "$wt" ] && git -C "$wt" rev-parse --git-dir >/dev/null 2>&1 && wts+=("${wt%/}")
    done
  done
  local linear_id
  for wt in "${wts[@]}"; do
    sf=$(basename "$wt")
    linear_id=""
    sfnum=$(echo "$sf" | grep -oE '[0-9]+' | head -1)
    for bf in "$wt"/docs/superpowers/brackets/*.md; do
      [ -f "$bf" ] || continue
      grep -q "^## SF-$sfnum[ :]" "$bf" 2>/dev/null || continue
      linear_id=$(awk -v sfx="SF-$sfnum" '$0 ~ "^## " sfx "([ :]|$)" { in_sf=1; next } /^## SF-/ { in_sf=0 } in_sf && /^linear:/ { gsub(/.*linear: /,""); print; exit }' "$bf" 2>/dev/null)
      [ -n "$linear_id" ] && break
    done
    [ -n "$linear_id" ] || continue
    st=$(linear_state "$linear_id")
    [ "$st" = "Done" ] || continue
    vj=$("$VERIFY" "$sf" --json 2>/dev/null)
    vv=$(printf '%s' "$vj" | python3 -c "
import json, sys
try:
    rows = json.load(sys.stdin)
    print(next((r.get('verdict','?') for r in rows if r.get('sf') == '$sf'), '?'))
except Exception: print('UNKNOWN')")
    if [ "$vv" != "COMPLETE" ]; then
      "$ORCA_BIN" linear status set "$linear_id" --to "In Progress" --json >/dev/null 2>&1 || true
      notify "watchdog --enforce-done" "$sf Done bị hạ về In Progress — story-verify verdict: $vv (Done trước merge = INCOMPLETE)"
      echo "$(date '+%H:%M') enforce-done: $sf Done → In Progress (verdict=$vv)"
      demoted=$((demoted+1))
    fi
  done
  [ "$demoted" -gt 0 ] && echo "$(date '+%H:%M') enforce-done: hạ $demoted Done về In Progress"
  return 0
}

one_pass() {
  [ "$ENFORCE_DONE" = 1 ] && enforce_done_pass
  local stalled=0
  while IFS='|' read -r sf verdict detail; do
    [ -n "$sf" ] || continue
    prev=$(load_state "$sf")

    case "$verdict" in
      RUNNING|BUSY)
        [ "$prev" = "STALLED" ] || [ "$prev" = "STALLED-COLD" ] && \
          notify "story-watchdog" "$sf đã sống lại ($verdict)"
        echo "$(date '+%H:%M') $sf: $verdict — $detail"
        ;;
      STALLED*)
        stalled=1
        if [ "$prev" != "$verdict" ]; then  # stall MỚI (transition) → notify
          notify "story-watchdog ⚠" "$sf STALLED — $detail"
          echo "$(date '+%H:%M') $sf: ⚠ $verdict (MỚI) — $detail"
        else
          echo "$(date '+%H:%M') $sf: ⚠ $verdict (đã biết) — $detail"
        fi
        if [ "$AUTO_RESUME" = 1 ]; then
          echo "  → auto-resume:"
          "$RESUME" "$sf" --send --stall-hours "$STALL_HOURS" 2>&1 | sed 's/^/    /'
          # một resume mỗi pass là đủ — agent cần thời gian để bắt đầu
          save_state "$sf" "RESUMED"
          stalled=0  # đã hành động — pass này không tính là "còn stall"
          break
        fi
        ;;
    esac
    save_state "$sf" "$verdict"
  done < <("$RESUME" --check --stall-hours "$STALL_HOURS" 2>/dev/null)
  # heartbeat renew claim (B4) — tự guard enabled; disabled = không đụng gì
  heartbeat_renew
  # story tự TIẾN: SF deps Done hết → launch tier kế (kể cả không session nào sống)
  if [ "$LAUNCH_NEXT" = 1 ] || [ "$DRY_RUN" = 1 ]; then
    echo "── launch-next$( [ "$DRY_RUN" = 1 ] && echo ' (DRY-RUN)' ):"
    launch_next
  fi
  # memory index (post-pass): subshell + || true — lỗi index KHÔNG đổi exit code pass
  if [ "$WITH_INDEX" = 1 ]; then
    ( "$IDX_HOOK" ) || true
  fi
  return $stalled
}

cron_next_entry() { # entry cron chuẩn — pure echo (test độc lập được, không đụng crontab)
  echo "*/30 * * * * $HOME/.claude/bin/story-watchdog --auto-resume --with-index --enforce-done >> $HOME/.claude/story-watchdog.log 2>&1 # story-team-kit"
}

install_cron() {
  local entry cur
  entry=$(cron_next_entry)
  cur=$(crontab -l 2>/dev/null || true)
  if printf '%s\n' "$cur" | grep -qF "$entry"; then
    echo "Cron entry đã tồn tại — không thêm nữa:"
    printf '%s\n' "$cur" | grep "story-watchdog"
    return 0
  fi
  if printf '%s\n' "$cur" | grep -q "story-watchdog"; then
    # entry cũ (thiếu --with-index) → REPLACE idempotent: bỏ mọi dòng cũ, thêm mới — không đúp
    { printf '%s\n' "$cur" | grep -v "story-watchdog"; echo "$entry"; } | crontab -
    rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "Không ghi được crontab (rc=$rc) — giữ nguyên entry cũ" >&2
      return "$rc"
    fi
    echo "đã cập nhật cron entry thêm --with-index:"
    crontab -l 2>/dev/null | grep "story-watchdog"
    return 0
  fi
  (crontab -l 2>/dev/null; echo "$entry") | crontab - && \
    echo "Đã đăng ký cron (mỗi 30', --auto-resume --with-index, log: ~/.claude/story-watchdog.log)"
}

# ═══ MAIN ═══
# parse args SAU khi functions định nghĩa xong (--install-cron gọi được ngay)
while [ $# -gt 0 ]; do
  case "$1" in
    --auto-resume) AUTO_RESUME=1 ;;
    --enforce-done) ENFORCE_DONE=1 ;;
    --with-index) WITH_INDEX=1 ;;
    --launch-next) LAUNCH_NEXT=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --loop) LOOP_MIN="${2:-30}"; shift ;;
    --stall-hours) STALL_HOURS="$2"; shift ;;
    --install-cron) install_cron; exit $? ;;
    *) echo "Unknown: $1"; exit 2 ;;
  esac
  shift
done

# die muộn: chỉ chặn khi --with-index THẬT SỰ dùng mà hook thiếu
if [ "$WITH_INDEX" = 1 ] && [ ! -x "$IDX_HOOK" ]; then
  echo "story-memory-index-hook không tìm thấy (cần nằm cạnh story-watchdog)"; exit 2
fi

if [ "$LOOP_MIN" -gt 0 ]; then
  echo "story-watchdog loop — mỗi ${LOOP_MIN}ph (PID $$). Ctrl-C để dừng."
  while true; do
    one_pass
    sleep $((LOOP_MIN * 60))
  done
else
  one_pass
fi
