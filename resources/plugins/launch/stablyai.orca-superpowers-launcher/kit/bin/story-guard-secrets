#!/usr/bin/env python3
"""story-guard-secrets — PreToolUse Bash guard: chặn command chứa secret.

Đọc stdin JSON Claude Code PreToolUse (tool_name, tool_input.command); chỉ xử
lý tool_name == "Bash". Deny-list HẸP (false-positive = treo mọi Bash — mỗi
pattern phải literal/anchored, review trước khi thêm):
  aws-key        AKIA[0-9A-Z]{16}
  github-token   gh[pousr]_[A-Za-z0-9]{36}
  slack-token    xox[baprs]-[A-Za-z0-9-]{10,}
  secret-assign  (TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE_KEY)\\s*=\\s*["'][^"']{20,}
Match → exit 2 (Claude Code block contract) + stderr lý do; không match →
exit 0. Mọi exception/parse error/malformed stdin → exit 0 fail-open (guard
KHÔNG được treo Bash). WAKII_GUARD_OFF=1 → exit 0 ngay (escape có ghi nhận).
Perf: chỉ regex string ops, không subprocess (GH-87).
"""
import json
import os
import re
import sys

# Bin chạy trực tiếp — không đẻ __pycache__ (GH-27).
sys.dont_write_bytecode = True

# Pipe/stdin Windows mặc định cp1252 → chết UnicodeError (GH-27).
for _s in (sys.stdin, sys.stdout, sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

GUARD_NAME = "story-guard-secrets"
PATTERNS = (
    ("aws-key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("github-token", re.compile(r"gh[pousr]_[A-Za-z0-9]{36}")),
    ("slack-token", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("secret-assign", re.compile(
        r"(TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE_KEY)\s*=\s*[\"'][^\"']{20,}")),
)


def main():
    if os.environ.get("WAKII_GUARD_OFF") == "1":
        return 0
    data = json.loads(sys.stdin.read())
    if not isinstance(data, dict) or data.get("tool_name") != "Bash":
        return 0
    tool_input = data.get("tool_input")
    cmd = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(cmd, str):
        return 0
    for name, pat in PATTERNS:
        if pat.search(cmd):
            sys.stderr.write(
                f"BLOCKED {GUARD_NAME}: {name} — đặt WAKII_GUARD_OFF=1 để tắt nếu nhầm\n")
            return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)  # fail-open — guard không được treo Bash
