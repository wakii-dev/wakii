#!/usr/bin/env python3
"""story-doctor — kit health check + repair/uninstall (GH-85 SF-1, c9 GH-87 SF-1,
ECC-6 install lifecycle).

Chế độ check (mặc định): 9 checks PASS/WARN/FAIL, mỗi WARN/FAIL kèm dòng `fix:`.
Máy khoẻ exit 0 (WARN không FAIL), ≥1 FAIL → exit 1.

--repair: chạy checks → tự fix AN TOÀN (xoá orphan bin dưới root, chmod 755
bins, re-run installKit cho marker/bins/hooks/agents-skills drift) → chạy lại
checks → in bảng before/after. KHÔNG BAO GIỜ sửa settings.json trực tiếp (merge
hooks là việc của installKit), đụng KB, hay đụng gì ngoài install root.

--uninstall [--yes]: không --yes → in PLAN (sẽ xoá gì theo kit.json provides +
marker) rồi exit 2 chờ xác nhận. Có --yes → xoá skills/agents/bins theo provides
+ marker; giữ nguyên skill/bin của user ngoài provides; in hướng dẫn xoá tay
hook entries trong settings.json + đường dẫn KB để user tự quyết. Exit 0.
Học pattern --health-check của claude-code-templates (aitmpl.com 31.7k★).

CLI: story-doctor [--root <install-dir>] [--kb-dir <path>] [--json]
     story-doctor --repair [--root <install-dir>] [--kb-dir <path>]
     story-doctor --uninstall [--yes] [--root <install-dir>]
  --root   install dir (mặc định ~/.claude); kit root luôn resolve từ vị trí bin
  --kb-dir override KB dir (resolve như story-kb: --kb-dir > WAKII_KB_DIR > candidates)
  --json   machine-readable (chế độ check): {"checks":[{name,status,detail,fix}],"exit":"ok|fail"}

Checks: marker · kit-hash · bins · deps · hooks · kb · orphans · agents-skills
· hooks-manifests (c9 — mỗi kit/hooks/*.json phải có entry command chứa tên bin
tương ứng trong settings.json; kit/hooks vắng → skip im lặng).
--live: thêm check môi trường sống — sf-lineage (SF worktree mồ côi, không lineage
cha qua `orca worktree list`; fail-open khi orca chết).
Chạy từ kit/bin (dev): kit.json sibling có → full check. Chạy từ ~/.claude/bin:
installKit không copy kit.json → check_bins đọc sidecar .kit-provides.json
(provides + srcKitRoot + kitHash, installKit ghi mỗi install); sidecar vắng →
fail-open WARN. Exit: 0 (chỉ PASS/WARN) · 1 (≥1 FAIL) · 2 (usage /
uninstall PLAN chờ --yes).
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Bin chạy trực tiếp — không đẻ __pycache__ vào kit/ (contentHash ổn định).
sys.dont_write_bytecode = True

# Pipe stdout trên Windows mặc định cp1252 → chết UnicodeEncodeError (GH-27).
for _s in (sys.stdout, sys.stderr):
    try:
        _s.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

MARKER_NAME = ".story-team-kit-version"
MARKER_RE = re.compile(r"^([1-9]\d*\.\d+\.\d+)(?::([0-9a-f]{8,64}))?$")
# Sidecar install-coverage (LOCAL-5 SF-1): installKit ghi <root>/bin/.kit-provides.json
# {provides:[bin names], srcKitRoot, kitHash} — máy CÀI không có kit.json → đây là
# nguồn truth cho check_bins (hết tautology kit_root==root).
SIDECAR_NAME = ".kit-provides.json"
HOOK_WRAPPERS = (
    ("SessionStart", "hook-session-start"),
    ("PostToolUse", "hook-post-tool-use"),
    ("Stop", "hook-stop"),
)
# Bỏ qua khi hash/walk cây kit — giống kitTreeFiles (main.mjs).
SKIP_NAMES = {"__pycache__", ".git", "node_modules", ".DS_Store"}
KB_MARKERS = ("adr", "repos", "glossary.md", "MOC.md")
MIN_NODE_MAJOR = 20


def usage(msg=None):
    if msg:
        print(f"usage error: {msg}", file=sys.stderr)
    print("usage: story-doctor [--root <install-dir>] [--kb-dir <path>] [--json]",
          file=sys.stderr)
    sys.exit(2)


class Check:
    def __init__(self, name, status, detail, fix=None, repair=None):
        self.name, self.status, self.detail = name, status, detail
        self.fix, self.repair = fix, repair


def run_cmd(cmd, timeout=15):
    """subprocess arg-list, utf-8/replace (GH-27). Returns (rc, stdout)."""
    try:
        r = subprocess.run(cmd, capture_output=True, encoding="utf-8",
                           errors="replace", timeout=timeout)
        return r.returncode, (r.stdout or "")
    except Exception:
        return None, ""


# ── kit.json + provides ───────────────────────────────────────────────────────

def load_kit_json(kit_root):
    """Returns (dict|None, err|None). kit.json KHÔNG được cài vào ~/.claude →
    máy user trả None (checks phụ thuộc nó fail-open WARN)."""
    path = os.path.join(kit_root, "kit.json")
    if not os.path.isfile(path):
        return None, "không tồn tại"
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f), None
    except (OSError, ValueError) as e:
        return None, str(e)


def provides(kit_json):
    bins, agents, skills = set(), set(), set()
    for e in (kit_json.get("provides") or []):
        if not isinstance(e, dict) or not e.get("name"):
            continue
        {"bin": bins, "agent": agents, "skill": skills}.setdefault(
            e.get("type"), set()).add(e["name"])
    return bins, agents, skills


def load_sidecar(root):
    """Sidecar do installKit ghi ở <root>/bin — Returns (dict|None, err|None).
    Vắng → (None, None) — không phải lỗi (fail-open ở caller)."""
    path = os.path.join(root, "bin", SIDECAR_NAME)
    if not os.path.isfile(path):
        return None, None
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        return None, str(e)
    if not isinstance(data, dict) or not isinstance(data.get("provides"), list):
        return None, "schema sai (cần object {provides:[...], srcKitRoot, kitHash})"
    return data, None


# ── computeKitHash python-port (main.mjs) ────────────────────────────────────

def _walk_files(base):
    out = []
    stack = [""]
    while stack:
        rel = stack.pop()
        d = os.path.join(base, rel) if rel else base
        for ent in os.listdir(d):
            if ent in SKIP_NAMES or ent.endswith(".pyc"):
                continue
            sub = f"{rel}/{ent}" if rel else ent
            full = os.path.join(base, sub)
            if os.path.isdir(full):
                stack.append(sub)
            elif os.path.isfile(full):
                out.append(sub)
    return out


def compute_kit_hash_py(kit_root):
    """sha256(sort(files) · rel·\\0·bytes·\\0)[:16] — port 1:1 computeKitHash.
    Sort key utf-16-be = đúng UTF-16 code-unit order của JS Array.sort."""
    h = hashlib.sha256()
    files = []
    for sub in ("skills", "agents", "bin"):
        base = os.path.join(kit_root, sub)
        if os.path.isdir(base):
            files.extend(f"{sub}/{f}" for f in _walk_files(base))
    files.sort(key=lambda s: s.encode("utf-16-be"))
    for rel in files:
        with open(os.path.join(kit_root, rel), "rb") as f:
            h.update(rel.encode("utf-8"))
            h.update(b"\0")
            h.update(f.read())
            h.update(b"\0")
    return h.hexdigest()[:16]


# ── deps resolve (Windows Store stub 9009 — pattern surface-lint-tests) ──────

def resolve_python():
    for name in ("python3", "python", "py"):
        rc, out = run_cmd([name, "--version"])
        if rc == 0 and out.strip():
            return name, out.strip()
    return None, None


def node_version():
    rc, out = run_cmd(["node", "--version"])
    if rc != 0:
        return None
    m = re.match(r"^v(\d+)\.", out.strip())
    return int(m.group(1)) if m else None


# ── KB resolve (như story-kb: cli > WAKII_KB_DIR > candidates) ───────────────

def git_root():
    rc, out = run_cmd(["git", "rev-parse", "--show-toplevel"])
    return out.strip() if rc == 0 and out.strip() else None


def is_kb_dir(path):
    if not path or not os.path.isdir(path):
        return False
    return any(os.path.exists(os.path.join(path, m)) for m in KB_MARKERS)


def resolve_kb_dir(cli_dir):
    if cli_dir:
        probed = [os.path.abspath(cli_dir)]
        return (probed[0] if is_kb_dir(probed[0]) else None), probed
    probed = []
    env_dir = os.environ.get("WAKII_KB_DIR")
    if env_dir:
        probed.append(os.path.abspath(env_dir))
        if is_kb_dir(probed[0]):
            return probed[0], probed
    base = git_root() or os.getcwd()
    candidates = [
        os.path.join(base, "docs", "knowledge"),
        os.path.normpath(os.path.join(base, os.pardir, "wakii-site", "docs", "knowledge")),
    ]
    for c in candidates:
        probed.append(c)
        if is_kb_dir(c):
            return c, probed
    return None, probed


# ── 8 checks ──────────────────────────────────────────────────────────────────

def check_marker(root, kit_json):
    path = os.path.join(root, MARKER_NAME)
    if not os.path.isfile(path):
        return Check("marker", "fail",
                     f"{MARKER_NAME} không tồn tại ở {root} (chưa cài kit?)",
                     "kích hoạt lại plugin launcher (installKit tự cài) hoặc copy kit/ sang install dir",
                     repair={"kind": "install"})
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
    except OSError as e:
        return Check("marker", "fail", f"đọc {MARKER_NAME} lỗi: {e}", "cài lại kit",
                     repair={"kind": "install"})
    m = MARKER_RE.match(text)
    if not m:
        return Check("marker", "fail", f"marker sai format: {text!r} (kỳ vọng version[:kitHash])",
                     "cài lại kit (installKit ghi lại marker)",
                     repair={"kind": "install"})
    ver, mhash = m.group(1), m.group(2)
    if kit_json:
        kver = str(kit_json.get("version") or "")
        khash = str(kit_json.get("kitHash") or "").strip()
        if kver and ver != kver:
            return Check("marker", "fail",
                         f"marker version {ver} ≠ kit.json {kver}",
                         "cài lại kit (marker stale so với kit source)",
                         repair={"kind": "install"})
        if mhash and khash and mhash != khash:
            return Check("marker", "fail",
                         f"marker kitHash {mhash} ≠ kit.json {khash} (drift)",
                         "kit/ đổi mà version chưa bump — rehash kit.json (computeKitHash) rồi cài lại",
                         repair={"kind": "install"})
        return Check("marker", "pass", f"marker {text} khớp kit.json")
    return Check("marker", "pass", f"marker {text} (không có kit.json sibling để đối chiếu)")


def check_kit_hash(kit_root, kit_json, marker_hash):
    declared = str(kit_json.get("kitHash") or "").strip() if kit_json else ""
    if not declared:
        declared = marker_hash or ""
    if not declared:
        return Check("kit-hash", "warn",
                     f"không có kit.json ở {kit_root} và marker không mang kitHash — không xác minh được drift",
                     "chạy story-doctor từ kit source (kit/bin) hoặc cài lại kit mới")
    if kit_json is None:
        return Check("kit-hash", "warn",
                     f"kit.json không có ở {kit_root} — marker hash {declared} không đối chiếu được tree",
                     "chạy story-doctor từ kit source (kit/bin) để xác minh đầy đủ")
    try:
        actual = compute_kit_hash_py(kit_root)
    except OSError as e:
        return Check("kit-hash", "warn", f"hash tree lỗi: {e}", "kiểm quyền đọc kit/")
    if actual != declared:
        return Check("kit-hash", "fail",
                     f"kit.json kitHash {declared} ≠ tree {actual} (đổi kit mà không rehash)",
                     "rehash: node -e computeKitHash(kit/) rồi cập nhật kit.json")
    return Check("kit-hash", "pass", f"kitHash {actual} khớp tree")


def check_bins(kit_root, root, kit_json):
    # Chế độ CÀI (kit.json vắng ở kit_root — doctor chạy từ vị trí cài): so
    # provides từ sidecar với installed — 2 chiều, hết tautology kit_root==root.
    if kit_json is None:
        return check_bins_sidecar(root)
    src_dir = os.path.join(kit_root, "bin")
    if not os.path.isdir(src_dir):
        return Check("bins", "fail", f"kit/bin không tồn tại ở {kit_root}",
                     "kit hỏng — checkout lại repo/plugin")
    src = sorted(f for f in os.listdir(src_dir)
                 if os.path.isfile(os.path.join(src_dir, f)) and not f.endswith(".html"))
    dst = os.path.join(root, "bin")
    missing = [f for f in src if not os.path.isfile(os.path.join(dst, f))]
    if missing:
        return Check("bins", "fail",
                     f"thiếu {len(missing)} bin ở {dst}: {', '.join(missing[:5])}"
                     + ("…" if len(missing) > 5 else ""),
                     f"cài lại kit hoặc copy thủ công từ {src_dir}",
                     repair={"kind": "install"})
    if sys.platform != "win32":
        nonexec = [f for f in src if not os.access(os.path.join(dst, f), os.X_OK)]
        if nonexec:
            return Check("bins", "fail",
                         f"bin không executable (POSIX): {', '.join(nonexec[:5])}",
                         f"chmod +x {dst}/* hoặc cài lại (installKit chmod 755)",
                         repair={"kind": "chmod",
                                 "files": [os.path.join(dst, f) for f in nonexec]})
    return Check("bins", "pass", f"{len(src)} bins đủ ở {dst}"
                 + ("" if sys.platform == "win32" else ", executable"))


def cp_hint(src_root, dst_dir, names):
    return " · ".join(f"cp '{src_root}/bin/{n}' '{dst_dir}/'" for n in names[:5])


def check_bins_sidecar(root):
    dst = os.path.join(root, "bin")
    sidecar, err = load_sidecar(root)
    installed = sorted(
        f for f in (os.listdir(dst) if os.path.isdir(dst) else [])
        if os.path.isfile(os.path.join(dst, f))
        and not f.endswith(".html") and not f.endswith(".pyc"))
    if sidecar is None:
        if err is not None:
            return Check("bins", "warn",
                         f"sidecar {SIDECAR_NAME} không đọc được ({err}) — không xác minh được install coverage",
                         "cài lại kit qua launcher (installKit ghi lại sidecar)")
        if not installed:
            return Check("bins", "fail", f"{dst} không tồn tại/rỗng (chưa cài kit?)",
                         "kích hoạt lại plugin launcher (installKit tự cài)",
                         repair={"kind": "install"})
        return Check("bins", "warn",
                     f"không có sidecar {SIDECAR_NAME} và kit.json — không xác minh được install coverage ({len(installed)} bins tìm thấy)",
                     "cài lại kit qua launcher (installKit ghi sidecar)")
    prov = sorted({str(n) for n in sidecar.get("provides") if isinstance(n, str)})
    pset = set(prov)
    missing = [n for n in prov if not os.path.isfile(os.path.join(dst, n))]
    orph = [f for f in installed
            if f not in pset and f != SIDECAR_NAME and f != ".DS_Store"]
    if missing:
        src = str(sidecar.get("srcKitRoot") or "")
        hint = f" hoặc copy tay: {cp_hint(src, dst, missing)}" if src else ""
        detail = (f"thiếu {len(missing)} bin theo sidecar ở {dst}: {', '.join(missing[:5])}"
                  + ("…" if len(missing) > 5 else ""))
        if orph:
            detail += f"; orphan theo sidecar: {', '.join(sorted(orph)[:5])}"
        return Check("bins", "fail", detail,
                     "cài lại kit qua launcher" + hint,
                     repair={"kind": "copy-bins", "src": src, "names": missing,
                             "kitHash": str(sidecar.get("kitHash") or "")})
    if sys.platform != "win32":
        nonexec = [n for n in prov if not os.access(os.path.join(dst, n), os.X_OK)]
        if nonexec:
            return Check("bins", "fail",
                         f"bin không executable (POSIX): {', '.join(nonexec[:5])}",
                         f"chmod +x {dst}/* hoặc cài lại (installKit chmod 755)",
                         repair={"kind": "chmod",
                                 "files": [os.path.join(dst, f) for f in nonexec]})
    if orph:
        # WARN-only: sidecar stale có thể che bin mới hợp lệ — không FAIL mù.
        return Check("bins", "warn",
                     f"{len(prov)} bins đủ; orphan theo sidecar (installed ∉ provides"
                     f" — sidecar stale?): {', '.join(sorted(orph)[:5])}",
                     "đối chiếu sidecar với cài mới (cài lại kit qua launcher để refresh)")
    return Check("bins", "pass", f"{len(prov)} bins đủ theo sidecar ở {dst}"
                 + ("" if sys.platform == "win32" else ", executable"))


def check_deps():
    py, py_ver = resolve_python()
    node_major = node_version()
    problems, detail = [], []
    if py:
        detail.append(f"python {py_ver.replace('Python ', '')} (via {py})")
    else:
        problems.append("python3/python/py không chạy được (Windows Store stub?)")
    if node_major is None:
        problems.append("node không chạy được")
        detail.append("node: không có")
    elif node_major < MIN_NODE_MAJOR:
        problems.append(f"node v{node_major} < {MIN_NODE_MAJOR}")
        detail.append(f"node v{node_major}")
    else:
        rc, out = run_cmd(["node", "--version"])
        detail.append(f"node {out.strip()}")
    if problems:
        return Check("deps", "fail", "; ".join(problems),
                     "cài Python 3.10+ (python.org, bỏ Store alias) và Node.js ≥ 20")
    return Check("deps", "pass", " · ".join(detail))


def check_hooks(root):
    path = os.path.join(root, "settings.json")
    if not os.path.isfile(path):
        return Check("hooks", "fail", f"settings.json không tồn tại ở {root}",
                     f"chạy {root}/bin/story-hooks-install hoặc cài lại kit",
                     repair={"kind": "install"})
    try:
        with open(path, encoding="utf-8") as f:
            settings = json.load(f)
    except (OSError, ValueError) as e:
        return Check("hooks", "fail", f"settings.json malformed (không parse được JSON): {e}",
                     "sửa JSON hoặc xoá file rồi cài lại kit")
    if not isinstance(settings, dict):
        return Check("hooks", "fail", f"settings.json không phải object (got {type(settings).__name__})",
                     "sửa settings.json rồi chạy story-hooks-install")
    hooks = settings.get("hooks")
    missing, broken = [], []
    for event, wrapper in HOOK_WRAPPERS:
        found_cmd = None
        groups = hooks.get(event) if isinstance(hooks, dict) else None
        for group in (groups or []):
            if not isinstance(group, dict):
                continue
            for hook in (group.get("hooks") or []):
                cmd = str((hook or {}).get("command") or "")
                if f"bin/{wrapper}" in cmd.replace("\\", "/"):
                    found_cmd = cmd
        if found_cmd is None:
            missing.append(event)
        elif not os.path.isfile(found_cmd.replace("\\", "/")):
            broken.append(f"{event} → {found_cmd}")
    if missing:
        return Check("hooks", "fail",
                     f"settings.json thiếu hook entries: {', '.join(missing)}",
                     f"chạy {root}/bin/story-hooks-install hoặc cài lại kit",
                     repair={"kind": "install"})
    if broken:
        return Check("hooks", "fail",
                     f"hook entry trỏ file không tồn tại: {'; '.join(broken)}",
                     "cài lại kit (bin/ wrappers copy lại)",
                     repair={"kind": "install"})
    return Check("hooks", "pass", "wired: " + ", ".join(e for e, _ in HOOK_WRAPPERS))


def check_kb(cli_dir):
    kb_dir, probed = resolve_kb_dir(cli_dir)
    if kb_dir:
        return Check("kb", "pass", f"KB configured: {kb_dir}")
    return Check("kb", "warn", f"KB not configured — probed: {', '.join(probed)}",
                 "đặt WAKII_KB_DIR hoặc --kb-dir trỏ dir KB (adr/repos/glossary.md/MOC.md) — tuỳ chọn")


def check_orphans(root, kit_json):
    bin_dir = os.path.join(root, "bin")
    if kit_json is None:
        return Check("orphans", "warn",
                     f"kit.json vắng — không có manifest provides để xác định orphan ở {bin_dir}",
                     "chạy story-doctor từ kit source để quét orphan")
    if not os.path.isdir(bin_dir):
        return Check("orphans", "warn", f"{bin_dir} không tồn tại — bỏ qua quét orphan")
    bins, _, _ = provides(kit_json)
    extra = sorted(
        f for f in os.listdir(bin_dir)
        if os.path.isfile(os.path.join(bin_dir, f))
        and f not in bins
        and not f.endswith(".html")
        and not f.endswith(".pyc")
        and f != ".DS_Store"
        and f != SIDECAR_NAME)
    if extra:
        return Check("orphans", "warn",
                     f"orphan bins (retire sót): {', '.join(extra)}",
                     "xoá tay các file trên — không thuộc kit.json provides",
                     repair={"kind": "remove",
                             "paths": [os.path.join(bin_dir, f) for f in extra]})
    return Check("orphans", "pass", f"không orphan trong {bin_dir}")


def check_agents_skills(root, kit_json):
    if kit_json is None:
        return Check("agents-skills", "warn",
                     f"kit.json vắng — không có manifest để xác minh agents/skills ở {root}",
                     "chạy story-doctor từ kit source để xác minh đầy đủ")
    _, agents, skills = provides(kit_json)
    missing = [f"agents/{a}.md" for a in sorted(agents)
               if not os.path.isfile(os.path.join(root, "agents", f"{a}.md"))]
    missing += [f"skills/{s}/SKILL.md" for s in sorted(skills)
                if not os.path.isfile(os.path.join(root, "skills", s, "SKILL.md"))]
    if missing:
        return Check("agents-skills", "fail",
                     f"thiếu {len(missing)}: {', '.join(missing[:5])}"
                     + ("…" if len(missing) > 5 else ""),
                     "cài lại kit (skills/ + agents/ được copy lại)",
                     repair={"kind": "install"})
    return Check("agents-skills", "pass", f"{len(agents)} agents + {len(skills)} skills đủ ở {root}")


def check_hooks_manifests(kit_root, root):
    """c9 (GH-87): mỗi kit/hooks/*.json phải wired trong settings.json — có entry
    command chứa tên bin tương ứng. kit/hooks vắng → None (skip im lặng — máy
    cài qua installKit không có manifests, không phải lỗi). Chỉ WARN (c5 hooks
    đã FAIL đường settings hỏng — c9 không nhân đôi)."""
    hooks_dir = os.path.join(kit_root, "hooks")
    try:
        manifests = sorted(f for f in os.listdir(hooks_dir) if f.endswith(".json")) \
            if os.path.isdir(hooks_dir) else []
    except OSError:
        return None
    if not manifests:
        return None
    wired_cmds = ""
    settings_path = os.path.join(root, "settings.json")
    try:
        with open(settings_path, encoding="utf-8") as f:
            settings = json.load(f)
        for group in (settings.get("hooks") or {}).values():
            if not isinstance(group, list):
                continue
            for ent in group:
                for hook in ((ent or {}).get("hooks") or []):
                    wired_cmds += str((hook or {}).get("command") or "").replace("\\", "/") + "\n"
    except (OSError, ValueError, AttributeError):
        return Check("hooks-manifests", "warn",
                     f"settings.json không đọc được ({settings_path}) — không xác minh được wiring manifests",
                     f"chạy {os.path.join(root, 'bin', 'story-hooks-install')} sau khi sửa settings")
    missing, broken = [], []
    for mf in manifests:
        bin_name = mf[:-len(".json")]
        if f"/{bin_name}" in wired_cmds:
            try:
                with open(os.path.join(hooks_dir, mf), encoding="utf-8") as f:
                    json.load(f)
            except (OSError, ValueError) as e:
                broken.append(f"{mf} (manifest hỏng: {e})")
            continue
        missing.append(mf)
    if missing:
        return Check("hooks-manifests", "warn",
                     f"manifest chưa wired: {', '.join(missing)}",
                     f"chạy {os.path.join(root, 'bin', 'story-hooks-install')}",
                     repair={"kind": "install"})
    if broken:
        return Check("hooks-manifests", "warn",
                     f"manifest JSON hỏng — skip validate: {'; '.join(broken)}",
                     "sửa JSON manifest trong kit/hooks/")
    return Check("hooks-manifests", "pass",
                 f"{len(manifests)} manifests wired: "
                 + ", ".join(m[:-len('.json')] for m in manifests))


# ── repair + uninstall (ECC-6 install lifecycle) ─────────────────────────────

def plugin_main_mjs():
    """kit/bin/story-doctor → pluginRoot/main.mjs (kit/ nằm cạnh main.mjs)."""
    return os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__)))), "main.mjs")


def run_install_kit(root, kit_root):
    """Re-run installKit (main.mjs) qua node subprocess — orcaStub như
    kit-verify-manifest.mjs. Arg-list (KHÔNG shell) + file-URI import → path
    an toàn mọi platform. Returns (ok, note)."""
    main_mjs = plugin_main_mjs()
    if not os.path.isfile(main_mjs):
        return False, f"bỏ qua install — không thấy {main_mjs} (chạy từ kit source)"
    if node_version() is None:
        return False, "bỏ qua install — node không chạy được"
    try:
        main_url = Path(main_mjs).resolve().as_uri()
    except ValueError as e:
        return False, f"bỏ qua install — main.mjs URI lỗi: {e}"
    code = (
        "import { installKit } from " + json.dumps(main_url) + ";\n"
        "const orca = { host: { call: async () => ({ ok: true }) }, log: () => {} };\n"
        "const r = await installKit(orca, { root: " + json.dumps(root)
        + ", kitRoot: " + json.dumps(kit_root) + " });\n"
        "console.log('installKit:' + (r === true));\n"
    )
    rc, out = run_cmd(["node", "--input-type=module", "-e", code], timeout=120)
    if rc == 0 and "installKit:true" in out:
        return True, "installKit OK (recopy skills/agents/bin + marker + hooks merge)"
    note = f"rc={rc}" + (f": {out.strip().splitlines()[-1]}" if out.strip() else "")
    return False, f"installKit không thành công ({note})"


def under_root(path, root):
    """repair/uninstall CHỈ đụng path trong install root — chặn path trốn ra ngoài."""
    path, root = os.path.abspath(path), os.path.abspath(root)
    try:
        return path != root and os.path.commonpath([path, root]) == root
    except ValueError:  # khác ổ đĩa (Windows)
        return False


def remove_path(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.remove(path)


def repair_copy_bins(root, r):
    """LOCAL-5 SF-1 — 2 nhánh: srcKitRoot còn tồn tại + tree hash khớp sidecar →
    copy bin thiếu trực tiếp (under_root + chmod 755 SAU copy — copy2 giữ mode
    nguồn). Source mất/hash lệch → (False, note chứa lệnh cp hướng dẫn tay) —
    không im lặng, checks sau vẫn FAIL."""
    src = str(r.get("src") or "")
    names = [str(n) for n in (r.get("names") or [])]
    dst_dir = os.path.join(root, "bin")
    manual = " — copy tay: " + cp_hint(src, dst_dir, names) if names else ""
    if not src or not os.path.isdir(src):
        return False, f"srcKitRoot mất ({src or 'trống'})" + manual
    try:
        actual = compute_kit_hash_py(src)
    except OSError as e:
        return False, f"hash srcKitRoot lỗi ({e})" + manual
    want = str(r.get("kitHash") or "")
    if want and actual != want:
        return False, f"srcKitRoot tree {actual} ≠ sidecar {want} (source khác bản đã cài)" + manual
    copied = 0
    for n in names:
        from_p, to_p = os.path.join(src, "bin", n), os.path.join(dst_dir, n)
        if not under_root(to_p, root) or not os.path.isfile(from_p):
            continue
        try:
            shutil.copy2(from_p, to_p)
            os.chmod(to_p, 0o755)
            copied += 1
        except OSError:
            continue
    if copied == len(names):
        return True, f"copy {copied} bin thiếu từ {src}: {', '.join(names[:5])}" \
                     + ("…" if len(names) > 5 else "")
    return False, f"copy {copied}/{len(names)} bin từ {src} (thiếu/lỗi)" + manual


def apply_repairs(checks, root, kit_root):
    """Chạy fix AN TOÀN từ check results: xoá orphan (chỉ path check báo, chỉ
    dưới root), chmod 755 bins, re-run installKit 1 lần nếu có check đòi.
    KHÔNG BAO GIỜ sửa settings.json trực tiếp, đụng KB hay gì ngoài root."""
    removes, chmods, do_install, copy_bins = [], [], False, []
    for c in checks:
        r = c.repair
        if not r:
            continue
        if r.get("kind") == "install":
            do_install = True
        elif r.get("kind") == "remove":
            removes.extend(r.get("paths") or [])
        elif r.get("kind") == "chmod":
            chmods.extend(r.get("files") or [])
        elif r.get("kind") == "copy-bins":
            copy_bins.append(r)
    done, skipped = [], []
    for p in removes:
        if under_root(p, root) and os.path.lexists(p):
            try:
                remove_path(p)
                done.append(f"xoá orphan: {p}")
            except OSError as e:
                skipped.append(f"xoá lỗi {p}: {e}")
        else:
            skipped.append(f"bỏ qua (ngoài root/đã mất): {p}")
    for p in chmods:
        if under_root(p, root) and os.path.isfile(p):
            try:
                os.chmod(p, 0o755)
                done.append(f"chmod 755: {p}")
            except OSError as e:
                skipped.append(f"chmod lỗi {p}: {e}")
    for r in copy_bins:
        ok, note = repair_copy_bins(root, r)
        (done if ok else skipped).append(note)
    if do_install:
        ok, note = run_install_kit(root, kit_root)
        (done if ok else skipped).append(note)
    return done, skipped


def collect_checks(root, kit_root, kit_json, kb_dir, live=False):
    """marker đọc tươi mỗi lần (repair ghi lại marker giữa 2 lần chạy)."""
    marker_text = ""
    marker_path = os.path.join(root, MARKER_NAME)
    if os.path.isfile(marker_path):
        try:
            with open(marker_path, encoding="utf-8") as f:
                marker_text = f.read().strip()
        except OSError:
            marker_text = ""
    mm = MARKER_RE.match(marker_text)
    checks = [
        check_marker(root, kit_json),
        check_kit_hash(kit_root, kit_json, mm.group(2) if mm else None),
        check_bins(kit_root, root, kit_json),
        check_deps(),
        check_hooks(root),
        check_kb(kb_dir),
        check_orphans(root, kit_json),
        check_agents_skills(root, kit_json),
    ]
    c9 = check_hooks_manifests(kit_root, root)
    if c9 is not None:
        checks.append(c9)
    if live:
        checks.append(check_sf_lineage())
    return checks


def check_sf_lineage():
    """--live: SF worktree (sf-N-*) phải có lineage cha — mồ côi = không hiện là con
    của story-hub trong Orca (04/10: sf-2/sf-3 VU-32 tạo tay thiếu --parent-worktree).
    Chỉ warn + hint, không auto-repair (cha đúng là hub nào chỉ context mới biết)."""
    try:
        out = subprocess.run(["orca", "worktree", "list", "--json"], capture_output=True,
                             text=True, timeout=25).stdout
        rows = json.loads(out).get("result", {}).get("worktrees", [])
    except Exception:
        return Check("sf-lineage", "pass",
                     "không đọc được orca worktree list — bỏ qua (fail-open)")
    orphans = [os.path.basename(w.get("path") or "") for w in rows
               if re.match(r"^sf-\d+", os.path.basename(w.get("path") or ""))
               and not ((w.get("lineage") or {}).get("parentWorktreeId"))]
    if orphans:
        return Check("sf-lineage", "warn",
                     f"SF worktree mồ côi (không lineage cha): {', '.join(sorted(orphans))}",
                     "orca worktree set --worktree path:<sf-worktree> --parent-worktree path:<story-hub>")
    return Check("sf-lineage", "pass", "mọi SF worktree đều có lineage cha")


def print_checks(checks, as_json):
    if as_json:
        print(json.dumps({
            "checks": [{"name": c.name, "status": c.status, "detail": c.detail,
                        "fix": c.fix} for c in checks],
            "exit": "fail" if any(c.status == "fail" for c in checks) else "ok",
        }, ensure_ascii=False, indent=2))
        return
    for c in checks:
        line = f"[{c.status.upper()}] {c.name}: {c.detail}"
        if c.fix:
            line += f" — fix: {c.fix}"
        print(line)
    n_pass = sum(1 for c in checks if c.status == "pass")
    n_warn = sum(1 for c in checks if c.status == "warn")
    n_fail = sum(1 for c in checks if c.status == "fail")
    print(f"== {n_pass} PASS / {n_warn} WARN / {n_fail} FAIL ==")


def cmd_repair(root, kit_root, kit_json, kb_dir):
    before = collect_checks(root, kit_root, kit_json, kb_dir)
    print("story-doctor --repair")
    print(f"root: {root}")
    print(f"kit:  {kit_root}")
    if not any(c.repair for c in before):
        after = before
        print("không có fix an toàn nào để chạy — FAIL (nếu có) cần fix tay (xem `fix:` ở check thường).")
    else:
        done, skipped = apply_repairs(before, root, kit_root)
        after = collect_checks(root, kit_root, kit_json, kb_dir)
        if done:
            print("đã repair:")
            for line in done:
                print(f"  + {line}")
        if skipped:
            print("bỏ qua/lỗi:")
            for line in skipped:
                print(f"  - {line}")
    print("before/after từng check:")
    bmap = {c.name: c for c in before}
    for c in after:
        b = bmap[c.name].status if c.name in bmap else "?"
        print(f"  {c.name:<16} {b.upper():>4} → {c.status.upper()}")
    n_pass = sum(1 for c in after if c.status == "pass")
    n_warn = sum(1 for c in after if c.status == "warn")
    n_fail = sum(1 for c in after if c.status == "fail")
    print(f"== sau repair: {n_pass} PASS / {n_warn} WARN / {n_fail} FAIL ==")
    manual = [c.name for c in after if c.status == "fail"]
    if manual:
        print("còn FAIL cần fix tay: " + ", ".join(manual))
    sys.exit(1 if n_fail else 0)


def uninstall_targets(root, kit_json):
    """Danh sách path thuộc kit theo kit.json provides + marker — KHÔNG hơn."""
    bins, agents, skills = provides(kit_json)
    t = [(os.path.join(root, "skills", s), "skill") for s in sorted(skills)]
    t += [(os.path.join(root, "agents", f"{a}.md"), "agent") for a in sorted(agents)]
    t += [(os.path.join(root, "bin", b), "bin") for b in sorted(bins)]
    t += [(os.path.join(root, "bin", SIDECAR_NAME), "sidecar")]
    t += [(os.path.join(root, MARKER_NAME), "marker")]
    return t


def cmd_uninstall(root, kit_root, kit_json, kb_dir, yes):
    if kit_json is None:
        print(f"uninstall cần kit.json ở {kit_root} để biết provides — chạy story-doctor "
              "từ kit source (an toàn: không đoán nội dung xoá).", file=sys.stderr)
        sys.exit(1)
    existing = [(p, kind) for p, kind in uninstall_targets(root, kit_json)
                if os.path.lexists(p)]
    print("story-doctor --uninstall" + (" --yes" if yes else " — PLAN (chưa xoá gì)"))
    print(f"root: {root}")
    if not existing:
        print("không còn gì của kit trong root — không xoá gì.")
    elif not yes:
        print(f"PLAN — sẽ xoá {len(existing)} mục (chạy lại với --yes để thực hiện):")
        for p, kind in existing:
            print(f"  - [{kind}] {p}")
    else:
        deleted = 0
        for p, kind in existing:
            if not under_root(p, root):
                print(f"  ! bỏ qua (ngoài root): {p}", file=sys.stderr)
                continue
            try:
                remove_path(p)
                deleted += 1
                print(f"  đã xoá [{kind}] {p}")
            except OSError as e:
                print(f"  ! xoá lỗi [{kind}] {p}: {e}", file=sys.stderr)
        print(f"== đã xoá {deleted}/{len(existing)} mục ==")
    # KHÔNG đụng: settings.json (hooks user tự xoá) + KB (user tự quyết).
    print("KHÔNG đụng settings.json — xoá tay các hook entries có command chứa")
    print("  bin/hook-session-start · bin/hook-post-tool-use · bin/hook-stop · story-guard-*")
    print(f"  trong {os.path.join(root, 'settings.json')} "
          "(SessionStart, PostToolUse, Stop + PreToolUse guards).")
    kb_resolved, probed = resolve_kb_dir(kb_dir)
    print(f"KHÔNG đụng KB ({kb_resolved or ', '.join(probed) or 'không dò được'}) "
          "— giữ nguyên, tự quyết xoá/giữ.")
    sys.exit(2 if not yes else 0)


# ── main ──────────────────────────────────────────────────────────────────────

def parse_args(argv):
    root = kb_dir = None
    as_json = repair = uninstall = yes = live = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--root":
            if i + 1 >= len(argv):
                usage("--root cần <install-dir>")
            root = argv[i + 1]
            i += 2
        elif a.startswith("--root="):
            root = a.split("=", 1)[1]
            i += 1
        elif a == "--kb-dir":
            if i + 1 >= len(argv):
                usage("--kb-dir cần <path>")
            kb_dir = argv[i + 1]
            i += 2
        elif a.startswith("--kb-dir="):
            kb_dir = a.split("=", 1)[1]
            i += 1
        elif a == "--json":
            as_json = True
            i += 1
        elif a == "--repair":
            repair = True
            i += 1
        elif a == "--uninstall":
            uninstall = True
            i += 1
        elif a == "--yes":
            yes = True
            i += 1
        elif a == "--live":
            live = True
            i += 1
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        else:
            usage(f"flag không rõ: {a}")
    if repair and uninstall:
        usage("--repair và --uninstall loại nhau")
    if yes and not uninstall:
        usage("--yes chỉ dùng cùng --uninstall")
    return root, kb_dir, as_json, repair, uninstall, yes, live


def main(argv):
    root_arg, kb_dir, as_json, repair, uninstall, yes, live = parse_args(argv)
    root = os.path.abspath(root_arg) if root_arg else os.path.join(
        os.path.expanduser("~"), ".claude")
    # kit root = bin/../ — story-doctor luôn nằm trong kit/bin (repo lẫn install).
    kit_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    kit_json, _err = load_kit_json(kit_root)

    if uninstall:
        cmd_uninstall(root, kit_root, kit_json, kb_dir, yes)
    if repair:
        cmd_repair(root, kit_root, kit_json, kb_dir)

    checks = collect_checks(root, kit_root, kit_json, kb_dir, live=live)
    if not as_json:
        print("story-doctor — kit health check")
        print(f"root: {root}")
        print(f"kit:  {kit_root}")
    print_checks(checks, as_json)
    sys.exit(1 if any(c.status == "fail" for c in checks) else 0)


if __name__ == "__main__":
    main(sys.argv[1:])
